                <path class="coche" d="M39 46 47 54 62 37" />
                <text class="pret" x="51" y="70" text-anchor="middle">{t.tampon[1]}</text>
              </g>
            </svg>
          </div>

          <p class="pp-controle"><svg viewBox="0 0 16 16"><path d="M3 8.5 6.5 12 13 4.5" /></svg>{t.controle}</p>
          <p class="pp-pdf"><i></i><i></i><i></i>{t.pdf}</p>
        </div>
        <!-- Carte de conclusion : texte réel ; l'action reste le bouton de l'offre, sous la scène -->
        <div class="pp-fin">
          <p class="pp-fin-kicker">{t.fin.kicker}</p>
          <p class="pp-fin-titre"><span>{t.fin.avant}</span> <em>{t.fin.accent}</em> <span>{t.fin.apres}</span></p>
          <p class="pp-fin-sous">{t.fin.sous}</p>
        </div>
        <button class="pp-pause" type="button" hidden data-pp-pause data-pause={t.pause} data-resume={t.reprendre} data-replay={t.rejouer} aria-label={t.pause}>
          <svg aria-hidden="true" viewBox="0 0 20 20" fill="currentColor"><path class="i-pause" d="M6 4h2.5v12H6zm5.5 0H14v12h-2.5z"/><path class="i-play" d="m7 4 10 6-10 6z"/><path class="i-replay" d="M10 4a6 6 0 1 1-5.7 4.1l1.5.5A4.4 4.4 0 1 0 10 5.6V8L6.5 4.8 10 1.6z"/></svg>
        </button>
      </div>

      <div class="pp-offre">
        <div>
          <p class="pp-kicker">{t.kicker}</p>
          <p class="pp-promesse">{t.promesse}</p>
        </div>
        <p class="pp-prix">99&nbsp;€<small>{t.mentions}</small></p>
        <a class="btn-cuivre gap-4" href={L('/peak-pitch/')}>{t.decouvrir} <span aria-hidden="true">↗</span></a>
        <p class="pp-banques">{t.banques}</p>
      </div>
    </div>
  </div>

  <div class="pp-pied">
    <p>ORIAS n° 24002546 · {fr ? 'Supervision ACPR' : 'ACPR supervision'}</p>
    <nav aria-label={fr ? 'Poursuivre sur le site' : 'Continue on the website'}>
      <a href={ASSURANCE_URL} data-assurance target="_blank" rel="noopener">{t.assurance} ↗</a>
    </nav>
  </div>
</section>

<script>
  // Sur petit écran, la scène démarre quand le visiteur peut la voir.
  let dispose: (() => void) | undefined;
  function init() {
    dispose?.();
    const scene = document.querySelector<HTMLElement>('[data-pp-scene]');
    const bouton = scene?.querySelector<HTMLButtonElement>('[data-pp-pause]');
    if (!scene || !bouton) return;
    const ctrl = new AbortController();
    const reduit = matchMedia('(prefers-reduced-motion: reduce)');
    const statique = new URLSearchParams(location.search).has('statique');
    const surPetitEcran = matchMedia('(max-width: 1023px)');
    let observateur: IntersectionObserver | undefined;
    let etat: 'joue' | 'pause' | 'fin' = 'joue';
    const maj = () => {
      bouton.hidden = !scene.classList.contains('pp-anime');
      scene.classList.toggle('pp-en-pause', etat === 'pause');
      bouton.dataset.etat = etat;
      bouton.setAttribute('aria-label', (etat === 'joue' ? bouton.dataset.pause : etat === 'pause' ? bouton.dataset.resume : bouton.dataset.replay) || '');
    };
    const lancer = () => {
      observateur?.disconnect();
      scene.classList.add('pp-anime');
      maj();
    };
    const reglerMouvement = () => {
      observateur?.disconnect();
      scene.classList.remove('pp-anime');
      etat = 'joue';
      maj();
      if (statique || reduit.matches) return;
      if (!surPetitEcran.matches || !('IntersectionObserver' in window)) {
        lancer();
        return;
      }
      observateur = new IntersectionObserver(([entree]) => {
        if (!ctrl.signal.aborted && !reduit.matches && entree.intersectionRatio >= 0.25) lancer();
      }, { threshold: 0.25 });
      observateur.observe(scene);
    };
    bouton.addEventListener('click', () => {
      if (etat === 'fin') {
        scene.classList.remove('pp-anime'); void scene.offsetWidth; scene.classList.add('pp-anime'); etat = 'joue';
      } else etat = etat === 'joue' ? 'pause' : 'joue';
      maj();
    }, { signal: ctrl.signal });
    const dernier = document.querySelector('.pp-offre .btn-cuivre');
    dernier?.addEventListener('animationend', e => { if (e.target === dernier && (e as AnimationEvent).animationName === 'pp-appel') { etat = 'fin'; maj(); } }, { signal: ctrl.signal });
    reduit.addEventListener('change', reglerMouvement, { signal: ctrl.signal });
    dispose = () => {
      observateur?.disconnect();
      ctrl.abort();
    };
    reglerMouvement();
  }
  document.addEventListener('astro:page-load', init);
  document.addEventListener('astro:before-swap', () => { dispose?.(); dispose = undefined; });
</script>

