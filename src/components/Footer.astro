---
/* Pied de page sur chaque page : liens légaux, ORIAS/ACPR et mention obligatoire. */
import { langCourante, localiser, t } from '../i18n';
const lang = langCourante(Astro.currentLocale);
const tr = t(lang);
const L = (p: string) => localiser(p, lang);
const colonnes = [
  { titre: tr.footer.col_expertises, liens: [[L('/expertises/estate'), 'PEAK ESTATE'], [L('/expertises/pro'), 'PEAK PRO'], [L('/expertises/pim'), 'PEAK PIM'], [L('/expertises/insure'), 'PEAK INSURE']] },
  { titre: tr.footer.col_cabinet, liens: [[L('/#methode'), tr.footer.methode], [L('/#equipe'), tr.footer.equipe], [L('/#partenaires'), tr.footer.partenaires], [L('/actualites'), tr.footer.actualites]] },
  { titre: tr.footer.col_espaces, liens: [[L('/espace-client'), tr.footer.client], [L('/espace-mandataire'), tr.footer.mandataire], [L('/#rdv'), tr.footer.prendre_rdv]] },
  { titre: tr.footer.col_reglementaire, liens: [[L('/mentions-legales'), tr.footer.mentions], [L('/politique-de-confidentialite'), tr.footer.confidentialite], [L('/cgu'), tr.footer.cgu]] },
];
const annee = new Date().getFullYear();
---

<footer class="sombre border-t border-filet">
  <div class="grille"></div>
  <div class="contenu relative py-16">
    <div class="grid grid-cols-2 gap-x-6 gap-y-10 md:grid-cols-4 lg:grid-cols-[1.4fr_repeat(4,1fr)]">
      <div class="col-span-2 max-w-md md:col-span-4 lg:col-span-1 lg:max-w-xs">
        <img src="/img/logo-peak-funding-ivoire.svg" alt="PEAK FUNDING" width="150" height="27" class="h-[26px] w-auto" />
        <p class="mt-4 text-[14px] leading-relaxed text-argent">{tr.footer.accroche}</p>
        <a href="mailto:contact@peakfunding.eu" class="mt-5 inline-block text-[14px] text-etoile underline decoration-filet underline-offset-4 hover:decoration-cuivre-clair">contact@peakfunding.eu</a>
      </div>
      {colonnes.map((c) => (
        <div>
          <h2 class="eyebrow text-argent">{c.titre}</h2>
          <ul class="mt-4 space-y-2.5">
            {c.liens.map(([href, libelle]) => (<li><a href={href} data-astro-reload={href === L('/espace-client') || undefined} class="inline-block py-1 text-[13px] leading-relaxed text-argent transition-colors hover:text-etoile">{libelle}</a></li>))}
          </ul>
        </div>
      ))}
    </div>
    <div class="mt-12 space-y-3 border-t border-filet pt-7 font-mono text-[12px] leading-relaxed text-argent">
      <p>© {annee} {tr.footer.orias}</p>
      <p class="text-argent">{tr.footer.credit}</p>
    </div>
  </div>
</footer>
