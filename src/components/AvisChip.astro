---
/* Une carte d'avis compacte du « mur vivant ». Affiche prénom + initiale,
   la photo Google (ou une pastille), la note, le texte et les repères projet. */
import type { Avis } from '../data/avis';
import { avisUi } from '../data/contenu';
import { langCourante } from '../i18n';

interface Props { a: Avis }
const { a } = Astro.props;
const lang = langCourante(Astro.currentLocale);
const u = avisUi(lang);
const nom = `${a.prenom} ${a.initiale.charAt(0).toUpperCase()}.`;
const montant = lang === 'fr' ? `${a.montant.toLocaleString('fr-FR')} €` : `€${a.montant.toLocaleString('en-GB')}`;
const date = new Date(`${a.date}T00:00:00Z`).toLocaleDateString(lang === 'fr' ? 'fr-FR' : 'en-GB', { month: 'long', year: 'numeric', timeZone: 'UTC' });
const etoiles = Array.from({ length: 5 }, (_, i) => i < a.note);
const teintes = ['#8a5a3c', '#3c5a8a', '#5a8a3c', '#8a3c5a', '#3c8a7a', '#7a3c8a'];
const teinte = teintes[[...a.prenom].reduce((s, c) => s + c.charCodeAt(0), 0) % teintes.length];
---

<article class="chip" data-projet={a.projet}>
  <div class="chip-tete">
    <span class="avatar" style={a.photo ? undefined : `background:${teinte}`}>
      {a.photo ? <img src={a.photo} alt="" width="38" height="38" loading="lazy" decoding="async" referrerpolicy="no-referrer" /> : a.prenom.charAt(0).toUpperCase()}
      <span class="g" aria-hidden="true"><svg viewBox="0 0 24 24"><path fill="#4285F4" d="M23.5 12.3c0-.8-.1-1.6-.2-2.3H12v4.5h6.5c-.3 1.5-1.1 2.8-2.4 3.6v3h3.9c2.3-2.1 3.5-5.2 3.5-8.8z"/><path fill="#34A853" d="M12 24c3.2 0 5.9-1.1 7.9-2.9l-3.9-3c-1.1.7-2.5 1.2-4 1.2-3.1 0-5.7-2.1-6.6-4.9H1.4v3.1C3.4 21.4 7.4 24 12 24z"/><path fill="#FBBC05" d="M5.4 14.4c-.2-.7-.4-1.4-.4-2.4s.1-1.7.4-2.4V6.5H1.4C.5 8.2 0 10 0 12s.5 3.8 1.4 5.5z"/><path fill="#EA4335" d="M12 4.8c1.8 0 3.3.6 4.5 1.8l3.4-3.4C17.9 1.2 15.2 0 12 0 7.4 0 3.4 2.6 1.4 6.5l4 3.1C6.3 6.8 8.9 4.8 12 4.8z"/></svg></span>
    </span>
    <div class="min-w-0">
      <div class="chip-nom">{nom}</div>
      <div class="chip-meta"><span class="v"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" aria-hidden="true"><path d="M5 13l4 4L19 7"/></svg>{u.verifie}</span> · {date}</div>
    </div>
  </div>
  <span class="etoiles" aria-label={`${a.note}/5`}>
    {etoiles.map((plein) => <svg class:list={[{ vide: !plein }]} viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 2l2.9 6.3 6.9.7-5.1 4.6 1.4 6.8L12 17.8 5.9 20.4l1.4-6.8L2.2 9l6.9-.7z"/></svg>)}
  </span>
  <p class="chip-txt">{a.texte}</p>
  <div class="chip-bas">
    <span class="tag projet">{u.projets[a.projet] ?? a.projet}</span>
    <span class="tag donnee">{montant}</span>
    <span class="tag">{a.ville}</span>
  </div>
</article>

<style>
  .chip { background: linear-gradient(180deg, var(--color-ardoise), #0f1219); border: 1px solid var(--color-filet); border-radius: var(--radius-carte); padding: 18px; display: flex; flex-direction: column; gap: 11px; transition: border-color .2s; }
  .chip:hover { border-color: var(--color-cuivre); }
  .chip-tete { display: flex; align-items: center; gap: 10px; }
  .avatar { position: relative; width: 38px; height: 38px; border-radius: 50%; flex-shrink: 0; display: grid; place-items: center; overflow: visible; font-weight: 600; font-size: 14px; color: #fff; }
  .avatar img { width: 38px; height: 38px; border-radius: 50%; object-fit: cover; display: block; }
  .avatar .g { position: absolute; right: -2px; bottom: -2px; width: 15px; height: 15px; border-radius: 50%; background: #fff; display: grid; place-items: center; box-shadow: 0 0 0 2px var(--color-ardoise); }
  .avatar .g svg { width: 10px; height: 10px; }
  .chip-nom { font-size: 14px; font-weight: 500; color: var(--color-etoile); }
  .chip-meta { font-family: var(--font-mono); font-size: 10px; color: var(--color-argent); display: flex; align-items: center; gap: 5px; margin-top: 1px; }
  .chip-meta .v { color: #7fb08a; display: inline-flex; align-items: center; gap: 3px; }
  .chip-meta .v svg { width: 9px; height: 9px; }
  .etoiles { display: inline-flex; gap: 3px; color: var(--color-cuivre-clair); }
  .etoiles svg { width: 13px; height: 13px; }
  .etoiles .vide { color: var(--color-filet); }
  .chip-txt { font-size: 13.5px; font-weight: 300; color: var(--color-etoile); line-height: 1.55; margin: 0; }
  .chip-bas { display: flex; flex-wrap: wrap; gap: 6px; }
  .tag { font-family: var(--font-mono); font-size: 10px; color: var(--color-argent); border: 1px solid var(--color-filet); border-radius: var(--radius-pill); padding: 3px 9px; display: inline-flex; align-items: center; }
  .tag.projet { color: var(--color-cuivre-clair); border-color: rgba(184,123,79,.35); }
</style>
