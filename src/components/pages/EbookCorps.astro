---
import {langCourante, localiser} from '../../i18n';
import {ebook, ebookPrice, EBOOK_AUTHOR, excerptURL, checkoutURL} from '../../data/ebook';
import Actions from '../EbookActions.astro';
const lang=langCourante(Astro.currentLocale),en=lang==='en',book=ebook(lang),sample=excerptURL(lang);
const audiences=en ? [
 ['Buying your home','Understand the application, income assessment, borrower insurance, guarantees and the steps to signing.'],
 ['Building a property portfolio','Explore rental finance, SCI structures, holding companies and how tax choices interact with financing.'],
 ['Financing a business or a specialist deal','Find an introduction to Lombard loans, seller finance, LBOs, OBOs and property development finance.']
] : [
 ['Acheter votre résidence principale','Comprendre le dossier, les revenus retenus, l’assurance, les garanties et les étapes jusqu’à la signature.'],
 ['Construire votre patrimoine immobilier','Aborder le financement locatif, la SCI, la holding et les liens entre fiscalité et financement.'],
 ['Financer une entreprise ou une opération atypique','Découvrir les repères du lombard, du crédit vendeur, du LBO, de l’OBO et de la promotion immobilière.']
];
---
<section class="fond-quadrille book-hero">
 <div class="cadre-page book-hero-grid"><div class="book-hero-copy"><p class="legende signal">{en ? 'The book · Practical guide · 2026 edition' : 'Le livre · Guide pratique · Édition 2026'}</p><h1>{book.title}</h1><p class="book-subtitle">{book.subtitle}</p><p class="book-intro">{book.introduction}</p><p class="book-author"><span class="whitespace-nowrap book-author-name">{EBOOK_AUTHOR}</span><span>{en ? 'President of PEAK FUNDING' : 'Président du cabinet PEAK FUNDING'}</span></p><div class="book-price"><strong>{ebookPrice(lang)}</strong><span>{en ? 'One payment · digital PDF' : 'Paiement unique · PDF numérique'}<br />{en ? 'Full edition after payment' : 'Édition complète après paiement'}</span></div><nav class="edition-nav" aria-label={en ? 'Book language' : 'Langue du livre'}><span>{en ? 'Your edition' : 'Votre édition'}</span><a href="/livre/" aria-current={!en ? 'page' : undefined} lang="fr">Français</a><a href="/en/livre/" aria-current={en ? 'page' : undefined} lang="en">English</a></nav><Actions lang={lang} /><p class="book-seller">{en ? 'Sold by PEAK FUNDING · Payment with Stancer' : 'Vendu par PEAK FUNDING · Paiement par Stancer'}</p></div><figure class="book-stage"><img src={`/img/ebook/couverture-${lang}.webp`} alt={en ? `Original cover of ${book.title}` : `Couverture originale du livre ${book.title}`} width="756" height="1071" fetchpriority="high" /><figcaption>{en ? 'The original cover · PDF edition' : 'La couverture originale · Édition PDF'}</figcaption></figure></div>
</section>
<section class="cadre-page respiration book-useful"><div class="book-heading"><p class="legende">{en ? 'Before presenting your project' : 'Avant de présenter votre projet'}</p><h2>{en ? 'Understand the questions.\nPrepare your answers.' : 'Comprendre les questions.\nPréparer vos réponses.'}</h2></div><div class="book-audiences">{audiences.map(([title,text],i)=><article><span class="legende">0{i+1}</span><h3>{title}</h3><p>{text}</p></article>)}</div></section>
<section class="book-contents" id="sommaire"><div class="cadre-page contents-grid"><div><p class="legende">{en ? 'Inside the guide' : 'Dans le guide'}</p><h2>26 {en ? 'chapters.\nFour perspectives.' : 'chapitres.\nQuatre lectures.'}</h2><p>{en ? 'From the bank’s first questions to specialist ownership and financing structures.' : 'Des premières questions de la banque aux montages patrimoniaux et aux financements spécialisés.'}</p><div class="book-facts"><span><strong>{book.pages}</strong>pages</span><span><strong>15</strong>{en ? 'FAQs' : 'questions fréquentes'}</span><span><strong>PDF</strong>{en ? 'digital edition' : 'édition numérique'}</span></div></div><div class="contents-parts">{book.parts.map((part,i)=><details open={i===0}><summary><span class="legende">0{i+1}</span><h3>{part.title}</h3><span class="expand" aria-hidden="true">+</span></summary><ol start={book.parts.slice(0,i).reduce((sum,p)=>sum+p.chapters.length,1)}>{part.chapters.map(chapter=><li>{chapter}</li>)}</ol></details>)}</div></div></section>
<section class="cadre-page respiration sample-section" id="extrait"><div class="book-heading"><p class="legende">{en ? 'Read before you buy' : 'Feuilletez avant de décider'}</p><h2>{en ? 'Discover the tone.\nSee how it helps.' : 'Découvrez le ton.\nJugez l’utilité.'}</h2></div><div class="sample-row"><p>{en ? 'The free extract gives you a first look at the guide before purchasing the full edition. No payment is required to read it.' : 'L’extrait gratuit vous permet de découvrir le guide avant l’achat de l’édition complète. Aucun paiement n’est nécessaire pour le consulter.'}</p>{sample ? <a href={sample} download data-ebook-excerpt class="action-ligne">{en ? 'Download the English extract' : 'Télécharger l’extrait français'} ↓</a> : <p class="sample-pending">{en ? 'The English extract will be available soon.' : 'L’extrait français sera disponible prochainement.'}</p>}</div></section>
<section class="fond-quadrille book-closing"><div class="cadre-page closing-grid"><div><p class="legende signal">{en ? 'Your next read' : 'Votre prochaine lecture'}</p><h2>{en ? 'A clearer view\nof your financing.' : 'Un regard plus clair\nsur votre financement.'}</h2><p>{en ? 'The complete PDF edition of the guide, in your chosen language.' : 'L’édition PDF complète du guide, dans la langue que vous choisissez.'}</p><div class="book-price"><strong>{ebookPrice(lang)}</strong><span>{en ? 'No subscription' : 'Sans abonnement'}<br />{book.pages} pages · 26 {en ? 'chapters' : 'chapitres'}</span></div><Actions lang={lang} /></div><div class="book-about"><p class="legende signal">{en ? 'About the author' : 'À propos de l’auteur'}</p><h3><span class="whitespace-nowrap">{EBOOK_AUTHOR}</span></h3><p>{en ? 'President of PEAK FUNDING, a financing brokerage firm. The book presents the assessment of financing applications and the preparation of a documented application.' : 'Président du cabinet de courtage en financement PEAK FUNDING. Le guide présente les repères de lecture d’un dossier bancaire et la préparation d’une demande documentée.'}</p><p class="book-seller">{en ? 'Seller: PEAK FUNDING' : 'Vendeur : PEAK FUNDING'}</p><p class="book-disclaimer">{en ? 'This guide provides general information. It is not personalised advice or a loan offer, and it does not guarantee approval. Rules and figures are dated in the book; check those applicable to your project when making a commitment.' : 'Ce guide est un ouvrage d’information générale. Il ne constitue ni un conseil personnalisé ni une offre de crédit et ne garantit aucun financement. Les règles et données chiffrées sont datées dans le livre ; vérifiez celles applicables à votre projet au moment de vous engager.'}</p>{!checkoutURL(lang) && <p class="book-prelaunch">{en ? 'Online sales are being prepared. No payment is currently taken on this page.' : 'La vente en ligne est en préparation. Aucun paiement n’est actuellement encaissé sur cette page.'}</p>}<p class="book-legal"><a href={localiser('/conditions-ebook/',lang)}>{en ? 'Ebook terms of sale' : 'Conditions de vente du livre'}</a></p></div></div></section>
