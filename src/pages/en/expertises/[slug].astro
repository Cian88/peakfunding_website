---
import Base from '../../../layouts/Base.astro';
import ExpertiseCorps from '../../../components/pages/ExpertiseCorps.astro';
import { expertisesEn } from '../../../data/en/expertises';

export function getStaticPaths() {
  return expertisesEn.map((e) => ({ params: { slug: e.slug }, props: { e } }));
}
const { e } = Astro.props;
---

<Base title={`${e.nom} — ${e.titre} | PEAK FUNDING`} description={e.intro}>
  <ExpertiseCorps e={e} />
</Base>
