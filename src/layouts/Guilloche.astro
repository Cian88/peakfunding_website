---
import "../styles/guilloche.css";
import Header from "../components/guilloche/Header.astro";
import Footer from "../components/guilloche/Footer.astro";
import AncienRdvRedirect from "../components/AncienRdvRedirect.astro";
import { salesIndexable } from "../lib/sales-indexing.mjs";
import { langCourante, urlAutreLangue, t } from "../i18n";
import { organisation, siteWeb, pageWeb, serialiser } from "../lib/seo";

interface Props {
  title: string;
  description: string;
  schema?: object[];
}
const { title, description, schema = [] } = Astro.props;
const noindex = !salesIndexable(Astro.url.pathname, import.meta.env);
const lang = langCourante(Astro.currentLocale);
const tr = t(lang);
const canonical = new URL(Astro.url.pathname, Astro.site);
const urlAutre = new URL(urlAutreLangue(Astro.url.pathname, lang), Astro.site);
const autre = lang === "fr" ? "en" : "fr";
const imageAbsolue = new URL("/img/cabinet-bureau.webp", Astro.site).href;
// Pages privées (noindex) : aucune donnée structurée, rien à faire lire aux moteurs.
const graphe = noindex
  ? []
  : [
      organisation(lang),
      siteWeb(lang),
      pageWeb({
        url: canonical.href,
        titre: title,
        description,
        lang,
        image: imageAbsolue,
      }),
      ...schema,
    ];
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="referrer" content="strict-origin-when-cross-origin" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang={lang} href={canonical} />
    <link rel="alternate" hreflang={autre} href={urlAutre} />
    <link
      rel="alternate"
      hreflang="x-default"
      href={
        new URL(
          Astro.url.pathname.replace(/^\/en(?=\/|$)/, "") || "/",
          Astro.site,
        )
      }
    />
    <link
      rel="icon"
      href="/img/symbole-montagne-cuivre.svg"
      type="image/svg+xml"
    />
    <meta name="theme-color" content="#102c25" />
    <meta name="msvalidate.01" content="966E6AF270B080BF25E862AAC71EB78B" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="PEAK FUNDING" />
    <meta property="og:locale" content={lang === "fr" ? "fr_FR" : "en_GB"} />
    <meta
      property="og:locale:alternate"
      content={lang === "fr" ? "en_GB" : "fr_FR"}
    />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={imageAbsolue} />
    <meta property="og:image:alt" content={title} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={imageAbsolue} />
    {graphe.length > 0 && (
      <script
        type="application/ld+json"
        is:inline
        set:html={serialiser(graphe)}
      />
    )}
  </head>
  <body data-page-navigation="document">
    <a class="skip" href="#contenu">
      {tr.aller_contenu}
    </a>
    <Header />
    <main id="contenu" tabindex="-1">
      <slot />
    </main>
    <Footer />
    <AncienRdvRedirect />
    <script>
      if (
        !new URLSearchParams(location.search).has("statique") &&
        !matchMedia("(prefers-reduced-motion: reduce)").matches
      ) {
        document.documentElement.classList.add("engrave");
      }
    </script>
  </body>
</html>
