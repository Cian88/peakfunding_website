---
/* Petits drapeaux dessinés en SVG (les drapeaux emoji ne s'affichent pas sous
   Windows). Coins arrondis via clipPath pour s'intégrer au design. */
import type { Lang } from '../i18n';
interface Props { lang: Lang; class?: string }
const { lang, class: classe = '' } = Astro.props;
const id = `dr-${lang}-${Math.random().toString(36).slice(2, 8)}`;
---

{lang === 'fr' ? (
  <svg viewBox="0 0 24 16" class={classe} width="24" height="16" role="img" aria-label="Français" xmlns="http://www.w3.org/2000/svg">
    <clipPath id={id}><rect width="24" height="16" rx="2.5" /></clipPath>
    <g clip-path={`url(#${id})`}>
      <rect width="24" height="16" fill="#fff" />
      <rect width="8" height="16" fill="#0b2265" />
      <rect x="16" width="8" height="16" fill="#c1272d" />
    </g>
  </svg>
) : (
  <svg viewBox="0 0 24 16" class={classe} width="24" height="16" role="img" aria-label="English" xmlns="http://www.w3.org/2000/svg">
    <clipPath id={id}><rect width="24" height="16" rx="2.5" /></clipPath>
    <g clip-path={`url(#${id})`}>
      <rect width="24" height="16" fill="#012169" />
      <path d="M0 0 24 16M24 0 0 16" stroke="#fff" stroke-width="3.2" />
      <path d="M0 0 24 16M24 0 0 16" stroke="#c8102e" stroke-width="1.9" />
      <path d="M12 0v16M0 8h24" stroke="#fff" stroke-width="5.2" />
      <path d="M12 0v16M0 8h24" stroke="#c8102e" stroke-width="3" />
    </g>
  </svg>
)}
