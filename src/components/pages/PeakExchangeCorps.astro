---
import MargeRelief from '../MargeRelief.astro';
import { langCourante, localiser } from '../../i18n';
import { exchangeCredit, exchangeFreedom } from '../../data/peak-exchange';
import {stancerServiceURL} from '../../lib/services-checkout.mjs';
const en = langCourante(Astro.currentLocale) === 'en';
const L = (p: string) => localiser(p, en ? 'en' : 'fr');
const service = stancerServiceURL(import.meta.env,'exchange');
const checkout = service ? `${service}/exchange-paiement.html${en ? '?lang=en' : ''}` : null;
const angles = en ? [
  ['01', 'Understand your position', 'Identify the strengths of your income, assets, company and project, together with the weaknesses a lender may question.'],
  ['02', 'Build your arguments', 'Turn your actual circumstances into clear, supported arguments. Anticipate objections and identify the information that needs explaining.'],
  ['03', 'Read the current context', 'Discuss how the political, economic and banking environment at the time of your meeting may influence a lender’s assessment.']
] : [
  ['01', 'Lire votre dossier', 'Identifier les points forts de vos revenus, de votre patrimoine, de vos sociétés et de votre projet, ainsi que les fragilités susceptibles d’interroger une banque.'],
  ['02', 'Construire vos arguments', 'Transformer les éléments concrets de votre situation en arguments clairs et étayés. Anticiper les objections et les informations à préciser.'],
  ['03', 'Comprendre le contexte', 'Mettre votre projet en perspective avec le contexte politique, économique et bancaire au moment de l’échange, et ses effets possibles sur l’analyse des banques.']
];
---

<section class="fond-quadrille exchange-hero">
  <div class="cadre-page exchange-intro">
    <div class="exchange-copy">
      <p class="legende signal">PEAK EXCHANGE · {en ? 'A personal perspective on your financing' : 'Un regard professionnel sur votre financement'}</p>
      <h1>{en ? 'Your application.' : 'Votre dossier.'}<br /><span>{en ? 'The right arguments.' : 'Les bons arguments.'}</span></h1>
      <p class="exchange-lead">{en ? 'An individual consultation with ' : 'Un échange individuel avec '}<span class="whitespace-nowrap">Valentin Boura--Defranoux</span>{en ? ' to understand your strengths, address your weaknesses and prepare your conversation with a bank.' : ' pour comprendre vos points forts, traiter vos points faibles et préparer votre argumentation face aux banques.'}</p>
      <div class="exchange-price"><strong>{en ? '€299 incl. VAT' : '299 € TTC'}</strong><span>{en ? 'One payment' : 'Paiement unique'}<br />{en ? 'First consultation and comprehensive advice note' : 'Premier échange et note de conseil exhaustive'}</span></div>
      {checkout ? <a href={checkout} data-astro-reload class="action-pleine">{en ? 'Book PEAK EXCHANGE' : 'Prendre RDV via PEAK EXCHANGE'} <span aria-hidden="true">↗</span></a> : <a href="#reservation" class="action-pleine">{en ? 'Booking opens soon' : 'Réservations prochainement'} <span aria-hidden="true">↓</span></a>}
      {en && <p class="exchange-small">The checkout form is currently in French. The payment return is available in English.</p>}
      <p class="exchange-small">{en ? 'Payment confirmation unlocks the booking calendar.' : 'Le paiement confirmé donne accès au choix de votre créneau.'}</p>
      <p class="exchange-credit"><strong>{en ? 'Deducted from your brokerage fees' : 'Déduit de vos honoraires de courtage'}</strong><span>{exchangeCredit[en ? 'en' : 'fr']}</span></p>
    </div>
    <figure class="exchange-portrait">
      <MargeRelief offre="exchange" />

      <img src="/img/portrait-valentin.webp" alt="Valentin Boura--Defranoux" width="640" height="800" fetchpriority="high" />
      <figcaption><strong><span class="whitespace-nowrap">Valentin Boura--Defranoux</span></strong><span>{en ? 'Founder · Independent financing broker' : 'Dirigeant · Courtier indépendant en financement'}</span><small>PEAK FUNDING · ORIAS 24002546</small></figcaption>
    </figure>
  </div>
</section>
<section class="exchange-analysis cadre-page respiration">
  <div class="exchange-section-head"><p class="legende">{en ? 'The purpose of the meeting' : 'Au cœur de l’échange'}</p><h2>{en ? 'Know what to say.\nAnd why it matters.' : 'Savoir quoi défendre.\nEt comment le défendre.'}</h2></div>
  <div class="exchange-angles">{angles.map(([n, title, text]) => <article><span class="chiffres">{n}</span><h3>{title}</h3><p>{text}</p></article>)}</div>
</section>
<section class="exchange-note">
  <div class="cadre-page exchange-note-grid"><div><p class="legende">{en ? 'After the consultation' : 'À l’issue de l’échange'}</p><h2>{en ? 'Advice you can\ncome back to.' : 'Une note de conseil.\nDes arguments à garder.'}</h2></div><div><p>{en ? 'You receive a comprehensive, personalised advice note with the analysis of your profile, the points discussed and the arguments relevant to your project.' : 'Vous recevez une note de conseil exhaustive et personnalisée qui reprend l’analyse de votre profil, les points abordés et les arguments adaptés à votre projet.'}</p><ul><li>{en ? 'Your strengths and the points to clarify' : 'Vos points forts et les éléments à éclaircir'}</li><li>{en ? 'Arguments supported by your actual circumstances' : 'Les arguments appuyés sur votre situation réelle'}</li><li>{en ? 'Contextual factors and suggested next steps' : 'Les éléments de contexte et les pistes d’action discutées'}</li></ul><p>{exchangeFreedom[en ? 'en' : 'fr']}</p></div></div>
</section>
<section class="cadre-page respiration" id="reservation">
  <div class="exchange-section-head"><p class="legende">{en ? 'Your booking' : 'Votre rendez-vous'}</p><h2>{en ? 'A clear process,\nfrom payment to advice.' : 'Un parcours simple,\ndu paiement au conseil.'}</h2></div>
  <ol class="exchange-steps"><li><strong>01 · {en ? 'Pay securely' : 'Régler la prestation'}</strong><p>{en ? '299 € incl. VAT by card through Stancer. Your billing details are collected before payment.' : '299 € TTC par carte via Stancer. Vos coordonnées de facturation sont recueillies avant le règlement.'}</p></li><li><strong>02 · {en ? 'Choose your time' : 'Choisir votre créneau'}</strong><p>{en ? 'Once payment is verified, access the dedicated Proton booking calendar.' : 'Après vérification du paiement, accédez à l’agenda Proton dédié pour choisir votre créneau.'}</p></li><li><strong>03 · {en ? 'Discuss your application' : 'Échanger sur votre dossier'}</strong><p>{en ? 'Prepare your existing figures, documents and any feedback from lenders. The consultation is followed by your personalised advice note.' : 'Préparez vos chiffres, documents existants et éventuels retours bancaires. L’échange est suivi de votre note de conseil personnalisée.'}</p></li></ol>
  <div class="exchange-booking"><div><h3>PEAK EXCHANGE <span>{en ? '€299 incl. VAT' : '299 € TTC'}</span></h3><p>{en ? 'An independent service, available without purchasing any other product.' : 'Une prestation indépendante, accessible sans achat d’un autre service.'}</p>{!checkout && <p role="status">{en ? 'Online payments are being activated. No payment or booking is currently taken on this page.' : 'L’ouverture des paiements est en préparation. Aucun règlement ni rendez-vous n’est pris sur cette page pour le moment.'}</p>}</div>{checkout && <a href={checkout} data-astro-reload class="action-pleine">{en ? 'Continue to secure payment' : 'Accéder au paiement sécurisé'} ↗</a>}</div>
  <p class="exchange-credit-final">{exchangeCredit[en ? 'en' : 'fr']}</p>
  <p class="exchange-disclaimer">{en ? 'This consultation and the advice note do not guarantee a loan or specific terms. Each bank remains responsible for its lending decision. This service does not include submitting your application to lenders or negotiating on your behalf.' : 'L’échange et la note de conseil n’emportent aucune obligation de résultat et ne garantissent ni l’obtention d’un financement ni des conditions particulières. La décision appartient aux établissements bancaires sollicités. Cette prestation ne comprend pas la présentation du dossier aux banques ni la négociation pour votre compte.'}</p>
  <div class="exchange-links"><a href={L('/conditions-peak-exchange/')}>{en ? 'Terms of sale' : 'Conditions de vente'}</a><a href={L('/politique-de-confidentialite/')}>{en ? 'Privacy' : 'Confidentialité'}</a></div>
</section>
