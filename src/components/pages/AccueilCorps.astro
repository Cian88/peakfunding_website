---
import { accueil } from '../../data/contenu';
import { langCourante, localiser } from '../../i18n';
import { SUPABASE_URL, SUPABASE_ANON_KEY } from '../../data/integrations';
import type { AvisPublic } from '../../lib/supabase';
import { exchangeCredit, exchangeFirstConsultation } from '../../data/peak-exchange';
import SimulateurCapacite from '../react/SimulateurCapacite';
import ReleveMensuel from '../ReleveMensuel.astro';
import articlesFr from '../../data/articles.json';
import articlesEn from '../../data/en/articles.json';
import { trierArticles } from '../../lib/editorial.mjs';
import { ebook } from '../../data/ebook';
import '../../styles/atlas.css';
import ZonesReleve from '../ZonesReleve.astro';
import MethodeReleve from '../MethodeReleve.astro';
import TitreEncre from '../TitreEncre.astro';
import CitationsClients from '../CitationsClients.astro';

const lang = langCourante(Astro.currentLocale),
  en = lang === 'en';
const L = (path: string) => localiser(path, lang);
const txt = (fr: string, english: string) => (en ? english : fr);
const c = accueil(lang),
  u = c.ui;
const articles = trierArticles(en ? articlesEn : articlesFr).slice(0, 3);
const book = ebook(lang);
const liensReperes = ['#expertises', '#equipe', L('/peak-exchange/'), '#faq-territoire'];
const photos = ['valentin', 'yves', 'maxime'];
let avis: AvisPublic[] = [];
try {
  const reponse = await fetch(
    SUPABASE_URL + '/rest/v1/avis_publics?select=prenom,initiale,texte,note,date&order=date.desc&limit=60',
    { headers: { apikey: SUPABASE_ANON_KEY }, signal: AbortSignal.timeout(8000) },
  );
  if (reponse.ok) avis = await reponse.json();
} catch {
  /* Le relevé publié reste utilisable si la source est indisponible. */
}
---

<section class="atlas-cover frame" aria-labelledby="atlas-title">
  <div class="sheet-line">
    <span class="sheet-tag">
      <i aria-hidden="true"></i>
      {txt('Le relevé financier', 'The financial survey')}
    </span>
    <span>
      PEAK FUNDING <b>/</b> {txt('Feuille', 'Sheet')} 01
    </span>
  </div>
  <div class="cover-grid">
    <div class="cover-text">
      <p class="notation">{txt('Cabinet de courtage indépendant', 'Independent brokerage firm')}</p>
      <h1 id="atlas-title">
        {txt('Financement', 'Financing')} <br />
        <span class="amp">&amp;</span> {txt('assurance', 'borrower')} <br />
        {txt('emprunteur.', 'insurance.')}
      </h1>
      <p class="cover-lead">
        {txt(
          'Nous structurons votre financement immobilier ou professionnel et comparons votre assurance emprunteur. Pour les particuliers, les dirigeants et les investisseurs, partout en France.',
          'We structure property and business financing and compare borrower insurance for individuals, business owners and investors throughout France.',
        )}
      </p>
      <div class="cover-actions">
        <a class="action" href="#simulateur">
          {u.hero_cta2}
          <span aria-hidden="true">↗</span>
        </a>
        <a class="text-link" href={L('/peak-exchange/')}>
          PEAK EXCHANGE <span aria-hidden="true">↗</span>
        </a>
      </div>
      <p class="mobile-registration notation">{u.hero_orias}</p>
    </div>
    <figure class="map-plate">
      <div class="map-head">
        <span>FIG. 01</span>
        <span>{txt('Relevé topographique', 'Topographic survey')}</span>
      </div>
      <div class="map-body">
        <img
          src="/cartographie/relief.svg"
          width="800"
          height="640"
          alt={txt('Courbes de niveau du puy de Dôme', 'Contour map of the puy de Dôme')}
          fetchpriority="high"
        />
        <svg viewBox="0 0 800 640" aria-hidden="true">
          <use
            href="/cartographie/relief.svg#courbe-repere"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-dasharray="1"
          />
        </svg>
      </div>
      <figcaption>
        <strong>Puy de Dôme</strong>
        <span>Massif central · FR</span>
      </figcaption>
    </figure>
  </div>
  <div class="sheet-line cover-foot">
    <span>{u.hero_orias}</span>
    <a href="https://www.data.gouv.fr/datasets/rge-alti-r">Source IGN · RGE ALTI®</a>
  </div>
</section>
<ZonesReleve />
<MethodeReleve lang={lang} />
<section id="simulateur" class="chapter frame">
  <div class="chapter-label">03 / {u.sim_eyebrow}</div>
  <div class="section-intro">
    <TitreEncre id="sim-titre" texte={u.sim_titre} />
    <p>{u.sim_texte}</p>
  </div>
  <noscript>
    <p>
      {txt(
        'Activez JavaScript pour recalculer cette estimation avec vos propres chiffres.',
        'Enable JavaScript to recalculate this estimate using your own figures.',
      )}
    </p>
  </noscript>
  <div class="simulator-panel">
    <SimulateurCapacite client:visible lang={lang} />
  </div>
  <div class="market-reading">
    <ReleveMensuel lang={lang} />
  </div>
</section>
<section id="equipe" class="chapter frame">
  <div class="chapter-label">04 / {txt('Le cabinet', 'The firm')}</div>
  <div class="team-spread">
    <div class="team-heading">
      <h2>{txt('Votre équipe de courtage.', 'Your brokerage team.')}</h2>
      <p>{c.equipe.intro}</p>
    </div>
    <ul class="portraits">
      {c.equipe.membres.map((m, i) => (
        <li>
          <img
            src={'/img/portrait-' + photos[i] + '.webp'}
            alt={m.nom}
            width="480"
            height="600"
            loading="lazy"
          />
          <div>
            <p class="notation">{m.role}</p>
            <h3>
              {m.nom.split(' ')[0]} <span class="surname">{m.nom.split(' ').slice(1).join(' ')}</span>
            </h3>
            <p>{m.domaine}</p>
          </div>
        </li>
      ))}
    </ul>
  </div>
  <div id="partenaires" class="partners">
    <h3>{u.part_eyebrow}</h3>
    {c.partenaires.map((p) => (
      <div>
        <a href={p.url} class="partenaire-marque">
          <img
            src={'/img/' + p.nom.toLowerCase() + '-logo.svg'}
            data-partenaire={p.nom.toLowerCase()}
            alt={p.nom}
            loading="lazy"
          />
        </a>
        <p>{p.texte}</p>
      </div>
    ))}
  </div>
</section>
<section id="services" class="chapter service-spread">
  <div class="frame">
    <div class="chapter-label">05 / Services</div>
    <TitreEncre texte={txt('Préparer votre dossier.', 'Prepare your application.')} />
    <div class="service-grid">
      <article id="livre" class="book-sheet">
        <a class="teaser-cover" href={L('/livre/')} aria-label={book.title}>
          <svg aria-hidden="true" viewBox="70 100 420 350" preserveAspectRatio="xMidYMid slice">
            <use href="/cartographie/relief.svg#courbes-terrain" />
          </svg>
          <img
            src={'/img/ebook/couverture-' + lang + '.webp'}
            alt={book.title}
            width="240"
            height="340"
            loading="lazy"
          />
        </a>
        <div>
          <p class="notation">{txt('Le livre', 'The book')} · PDF</p>
          <h3>
            <a href={L('/livre/')}>{book.title} ↗</a>
          </h3>
          <p>{book.subtitle}</p>
        </div>
      </article>
      <div class="consultations">
        <article>
          <p class="notation">{txt('Présentation bancaire', 'Lender presentation')}</p>
          <h3>
            <a href={L('/peak-pitch/')}>PEAK PITCH ↗</a>
          </h3>
          <p>
            {txt(
              'Préparez la présentation de votre projet aux banques.',
              'Prepare your project presentation for lenders.',
            )}
          </p>
        </article>
        <article>
          <p class="notation">{txt('Consultation individuelle', 'Individual consultation')}</p>
          <h3>
            <a href={L('/peak-exchange/')}>PEAK EXCHANGE ↗</a>
          </h3>
          <p>{exchangeFirstConsultation[lang]}</p>
          <details>
            <summary>{txt('Déduction des honoraires', 'Deduction from brokerage fees')}</summary>
            <p>{exchangeCredit[lang]}</p>
          </details>
        </article>
      </div>
    </div>
  </div>
</section>
<CitationsClients avis={avis} lang={lang} />
<section id="analyses" class="frame chapter">
  <div class="chapter-label">07 / {txt('Analyses', 'Insights')}</div>
  <div class="section-intro">
    <h2>{txt('Les analyses du cabinet.', 'Insights from the firm.')}</h2>
    <a class="text-link" href={L('/actualites')}>
      {txt('Toutes les analyses', 'All insights')} ↗
    </a>
  </div>
  <div class="journal-spread">
    {articles.map((a, i) => (
      <article>
        <a href={L('/actualites/' + a.slug)}>
          {i === 0 && <img src="/img/cabinet-travail.webp" alt="" width="640" height="360" loading="lazy" />}
          <div>
            <span class="notation">{a.avant[1]}</span>
            <h3>{a.title}</h3>
            <small>{a.avant[2]} ↗</small>
          </div>
        </a>
      </article>
    ))}
  </div>
</section>
<section id="faq" class="frame chapter">
  <div class="chapter-label">08 / FAQ</div>
  <h2>{txt('Vos questions.', 'Your questions.')}</h2>
  <div class="faq-spread">
    <aside id="accompagnement" aria-label={u.reperes_aria}>
      <p class="notation">{u.reperes_aria}</p>
      <ul class="references">
        {c.reperes.map((r, i) => (
          <li>
            <h3>
              <a href={liensReperes[i]}>{r.titre}</a>
            </h3>
            <p>{r.texte}</p>
          </li>
        ))}
      </ul>
      <a href="#simulateur" class="text-link">
        {u.hero_cta2} ↗
      </a>
    </aside>
    <div class="questions">
      {c.faq.map((f, i) => (
        <details id={i === 3 ? 'faq-territoire' : undefined}>
          <summary>{f.q}</summary>
          <p>{f.r}</p>
        </details>
      ))}
    </div>
  </div>
</section>
<section class="closing-chart" aria-labelledby="closing-title">
  <div class="frame closing-grid">
    <div class="closing-copy">
      <p class="notation">{txt('Estimation de financement', 'Financing estimate')}</p>
      <h2 id="closing-title">{txt('Quel budget pour votre projet ?', 'What is your project budget?')}</h2>
      <a class="action" href="#simulateur">
        {u.hero_cta2} ↗
      </a>
    </div>
    <figure class="closing-sheet">
      <div class="closing-legend">
        <span>{txt('Le relevé financier', 'The financial survey')}</span>
        <span>PF / 01</span>
      </div>
      <img
        src="/cartographie/relief.svg"
        alt={txt('Feuille complète du puy de Dôme', 'Complete survey sheet of the puy de Dôme')}
        width="800"
        height="640"
        loading="lazy"
      />
      <figcaption>
        <strong>Puy de Dôme</strong>
        <span>RGE ALTI® · IGN</span>
      </figcaption>
    </figure>
  </div>
</section>
