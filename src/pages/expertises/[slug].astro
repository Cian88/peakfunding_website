---
import Base from '../../layouts/Base.astro';
import ExpertiseCorps from '../../components/pages/ExpertiseCorps.astro';
import { expertises } from '../../data/expertises';
import { accueil, faqExpertisesFor } from '../../data/contenu';
import { service, faqPage, filAriane, SITE } from '../../lib/seo';

export function getStaticPaths() {
  return expertises.map((e) => ({ params: { slug: e.slug }, props: { e } }));
}
const { e } = Astro.props;
const accroche = accueil('fr').expertises.find((x) => x.slug === e.slug)?.accroche ?? '';
const schema = [
  service(e, 'fr'),
  faqPage(faqExpertisesFor('fr')[e.slug]),
  filAriane([{ nom: 'Accueil', url: `${SITE}/` }, { nom: `${e.nom} — ${accroche}`, url: `${SITE}/expertises/${e.slug}/` }]),
];
---

<Base title={`${e.nom} — ${accroche} | PEAK FUNDING`} description={e.intro} image={`/img/ambiance-${e.slug}.webp`} schema={schema}>
  <ExpertiseCorps e={e} />
</Base>
