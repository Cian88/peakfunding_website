---
import {langCourante, localiser} from '../../i18n';
import {ebook, ebookPrice, EBOOK_AUTHOR, excerptURL, checkoutURL} from '../../data/ebook';
import Actions from '../EbookActions.astro';
const lang=langCourante(Astro.currentLocale),en=lang==='en',book=ebook(lang),sample=excerptURL(lang);
const audiences=en ? [
 ['Buying your home','Understand the application, income assessment, borrower insurance, guarantees and the steps to signing.'],
 ['Building a property portfolio','Explore rental finance, SCI structures, holding companies and how tax choices interact with financing.'],
 ['Financing a business or a specialist deal','Find an introduction to Lombard loans, seller finance, LBOs, OBOs and property development finance.']
] : [
 ['Acheter votre résidence principale','Comprendre le dossier, les revenus retenus, l’assurance, les garanties et les étapes jusqu’à la signature.'],
 ['Construire votre patrimoine immobilier','Aborder le financement locatif, la SCI, la holding et les liens entre fiscalité et financement.'],
 ['Financer une entreprise ou une opération atypique','Découvrir les repères du lombard, du crédit vendeur, du LBO, de l’OBO et de la promotion immobilière.']
];
---
<section class="sombre book-hero">
 <div class="contenu book-hero-grid"><div class="book-hero-copy"><p class="eyebrow text-cuivre-clair">{en ? 'The book · Practical guide · 2026 edition' : 'Le livre · Guide pratique · Édition 2026'}</p><h1>{book.title}</h1><p class="book-subtitle">{book.subtitle}</p><p class="book-intro">{book.introduction}</p><p class="book-author">{EBOOK_AUTHOR}<span>{en ? 'President of Peak Funding' : 'Président du cabinet Peak Funding'}</span></p><div class="book-price"><strong>{ebookPrice(lang)}</strong><span>{en ? 'One payment · digital PDF' : 'Paiement unique · PDF numérique'}<br />{en ? 'Full edition after payment' : 'Édition complète après paiement'}</span></div><Actions lang={lang} /><p class="book-seller">{en ? 'Sold by PEAK FUNDING · Payment with Stancer' : 'Vendu par PEAK FUNDING · Paiement par Stancer'}</p><p class="book-availability">{en ? 'French and English editions. Choose the language of your book.' : 'Éditions française et anglaise. Choisissez la langue de votre livre.'}</p></div><figure class="book-stage"><img src={`/img/ebook/couverture-${lang}.webp`} alt={en ? `Original cover of ${book.title}` : `Couverture originale du livre ${book.title}`} width="756" height="1071" fetchpriority="high" /><figcaption>{en ? 'The original cover · PDF edition' : 'La couverture originale · Édition PDF'}</figcaption></figure></div>
</section>
<nav class="edition-nav contenu" aria-label={en ? 'Book language' : 'Langue du livre'}><span>{en ? 'Your edition' : 'Votre édition'}</span><a href="/livre/" aria-current={!en ? 'page' : undefined} lang="fr">Français</a><a href="/en/livre/" aria-current={en ? 'page' : undefined} lang="en">English</a><a href="#sommaire" class="contents-link">{en ? 'Explore the contents' : 'Parcourir le sommaire'} ↓</a></nav>
<section class="contenu section book-useful"><div class="book-heading"><p class="eyebrow">{en ? 'Before presenting your project' : 'Avant de présenter votre projet'}</p><h2>{en ? 'Understand the questions.\nPrepare your answers.' : 'Comprendre les questions.\nPréparer vos réponses.'}</h2></div><div class="book-audiences">{audiences.map(([title,text],i)=><article><span class="eyebrow">0{i+1}</span><h3>{title}</h3><p>{text}</p></article>)}</div></section>
<section class="book-contents" id="sommaire"><div class="contenu contents-grid"><div><p class="eyebrow">{en ? 'Inside the guide' : 'Dans le guide'}</p><h2>26 {en ? 'chapters.\nFour perspectives.' : 'chapitres.\nQuatre lectures.'}</h2><p>{en ? 'From the bank’s first questions to specialist ownership and financing structures.' : 'Des premières questions de la banque aux montages patrimoniaux et aux financements spécialisés.'}</p><div class="book-facts"><span><strong>{book.pages}</strong>pages</span><span><strong>15</strong>{en ? 'FAQs' : 'questions fréquentes'}</span><span><strong>PDF</strong>{en ? 'digital edition' : 'édition numérique'}</span></div></div><div class="contents-parts">{book.parts.map((part,i)=><details open={i===0}><summary><span class="eyebrow">0{i+1}</span><h3>{part.title}</h3><span class="expand" aria-hidden="true">+</span></summary><ol start={book.parts.slice(0,i).reduce((sum,p)=>sum+p.chapters.length,1)}>{part.chapters.map(chapter=><li>{chapter}</li>)}</ol></details>)}</div></div></section>
<section class="contenu section sample-section" id="extrait"><div class="book-heading"><p class="eyebrow">{en ? 'Read before you buy' : 'Feuilletez avant de décider'}</p><h2>{en ? 'Discover the tone.\nSee how it helps.' : 'Découvrez le ton.\nJugez l’utilité.'}</h2></div><div class="sample-row"><p>{en ? 'The free extract gives you a first look at the guide before purchasing the full edition. No payment is required to read it.' : 'L’extrait gratuit vous permet de découvrir le guide avant l’achat de l’édition complète. Aucun paiement n’est nécessaire pour le consulter.'}</p>{sample ? <a href={sample} download data-ebook-excerpt class="btn-fantome">{en ? 'Download the English extract' : 'Télécharger l’extrait français'} ↓</a> : <p class="sample-pending">{en ? 'The English extract will be available soon.' : 'L’extrait français sera disponible prochainement.'}</p>}</div></section>
<section class="sombre book-closing"><div class="contenu closing-grid"><div><p class="eyebrow text-cuivre-clair">{en ? 'Your next read' : 'Votre prochaine lecture'}</p><h2>{en ? 'A clearer view\nof your financing.' : 'Un regard plus clair\nsur votre financement.'}</h2><p>{en ? 'The complete PDF edition of the guide, in your chosen language.' : 'L’édition PDF complète du guide, dans la langue que vous choisissez.'}</p><div class="book-price"><strong>{ebookPrice(lang)}</strong><span>{en ? 'No subscription' : 'Sans abonnement'}<br />{book.pages} pages · 26 {en ? 'chapters' : 'chapitres'}</span></div><Actions lang={lang} /></div><div class="book-about"><p class="eyebrow text-cuivre-clair">{en ? 'About the author' : 'À propos de l’auteur'}</p><h3>{EBOOK_AUTHOR}</h3><p>{en ? 'President of Peak Funding, a financing brokerage firm. The book presents the assessment of financing applications and the preparation of a documented application.' : 'Président du cabinet de courtage en financement Peak Funding. Le guide présente les repères de lecture d’un dossier bancaire et la préparation d’une demande documentée.'}</p><p class="book-seller">{en ? 'Seller: PEAK FUNDING' : 'Vendeur : PEAK FUNDING'}</p><p class="book-disclaimer">{en ? 'This guide provides general information. It is not personalised advice or a loan offer, and it does not guarantee approval. Rules and figures are dated in the book; check those applicable to your project when making a commitment.' : 'Ce guide est un ouvrage d’information générale. Il ne constitue ni un conseil personnalisé ni une offre de crédit et ne garantit aucun financement. Les règles et données chiffrées sont datées dans le livre ; vérifiez celles applicables à votre projet au moment de vous engager.'}</p>{!checkoutURL(lang) && <p class="book-prelaunch">{en ? 'Online sales are being prepared. No payment is currently taken on this page.' : 'La vente en ligne est en préparation. Aucun paiement n’est actuellement encaissé sur cette page.'}</p>}</div></div></section>
<p class="contenu fine book-legal"><a href={localiser('/conditions-ebook/',lang)}>{en ? 'Ebook terms of sale' : 'Conditions de vente du livre'}</a></p>
<style>
 .book-seller{font-size:12px!important;line-height:1.6;color:#b9bdc5;margin-top:16px}.book-legal{padding-block:20px;font-size:12px;text-decoration:underline}
 .book-hero{padding:clamp(40px,6vw,88px) 0}.book-hero-grid{display:grid;grid-template-columns:1.1fr .9fr;gap:clamp(32px,6vw,100px);align-items:center}.book-hero h1{font-size:clamp(40px,4.5vw,64px);line-height:1.05;letter-spacing:-.045em;font-weight:400;margin:24px 0 18px;max-width:620px}.book-subtitle{font-size:20px;color:#d9a47c;margin-bottom:20px}.book-intro{font-size:16px;line-height:1.75;color:#c4c5c8;max-width:580px}.book-author{font-size:14px;margin:22px 0 0;color:#edeae4}.book-author span{display:block;font-size:12px;color:#a9adb6;margin-top:4px}.book-price{display:flex;gap:24px;align-items:center;margin:28px 0 24px}.book-price strong{font-size:44px;font-weight:400;letter-spacing:-.04em}.book-price span{font-size:12px;color:#b9bdc5;line-height:1.7}.book-availability{font-size:12px;line-height:1.6;color:#a9adb6;margin-top:18px}.book-stage{margin:0;padding:36px 40px 24px;background:#ded8cd;max-width:440px;justify-self:end}.book-stage img{width:100%;height:auto;display:block;box-shadow:15px 20px 28px #0b0d1233}.book-stage figcaption{font-size:10px;font-family:monospace;line-height:1.5;color:#5f5547;margin-top:26px}.edition-nav{display:flex;align-items:center;gap:24px;padding-block:25px;border-bottom:1px solid #d0c9bd;font-size:13px}.edition-nav>span{color:#636670;font-size:11px;text-transform:uppercase;letter-spacing:.08em}.edition-nav a[aria-current=page]{border-bottom:2px solid #9c6a44;padding-bottom:5px}.edition-nav .contents-link{margin-left:auto}.book-heading{display:grid;grid-template-columns:1fr 2fr;gap:32px;margin-bottom:44px}.book-heading h2,.book-contents h2,.book-closing h2{font-size:clamp(30px,3.6vw,46px);line-height:1.12;font-weight:400;letter-spacing:-.04em;white-space:pre-line}.book-audiences{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:36px}.book-audiences article{border-top:1px solid #c6bfb3;padding-top:20px}.book-audiences h3{font-size:22px;font-weight:400;line-height:1.3;letter-spacing:-.025em;margin:22px 0 14px}.book-audiences p,.contents-grid>div>p:not(.eyebrow),.sample-row>p{font-size:15px;line-height:1.75;color:#555963}.book-contents{background:#e7e2d9;padding:72px 0}.contents-grid{display:grid;grid-template-columns:1fr 1.2fr;gap:clamp(32px,7vw,100px)}.book-contents h2{margin-top:26px;margin-bottom:24px}.book-facts{display:flex;gap:32px;border-top:1px solid #c7beaf;padding-top:24px;margin-top:32px}.book-facts span{font-size:11px;color:#63594a;line-height:1.6}.book-facts strong{display:block;font-size:28px;line-height:1.4;font-weight:400;color:#0b0d12}.contents-parts details{border-top:1px solid #c7beaf}.contents-parts details:last-child{border-bottom:1px solid #c7beaf}.contents-parts summary{display:grid;grid-template-columns:25px 1fr 18px;gap:16px;align-items:center;cursor:pointer;list-style:none;padding:22px 0}.contents-parts summary::-webkit-details-marker{display:none}.contents-parts h3{font-size:18px;font-weight:400;line-height:1.4}.contents-parts .expand{font-size:20px;color:#94623f}.contents-parts details[open] .expand{transform:rotate(45deg)}.contents-parts ol{list-style:decimal;padding:0 0 22px 60px;color:#555963;font-size:14px;line-height:1.6}.contents-parts li{padding:4px 0}.sample-row{display:grid;grid-template-columns:1.2fr 1fr;gap:48px;align-items:center}.sample-row .btn-fantome{color:#0b0d12;border-color:#bbb2a5;font-size:14px;gap:18px}.sample-row .sample-pending{justify-self:start;border-left:2px solid #a17653;padding-left:18px;font-size:13px;color:#76543a}.book-closing{padding:72px 0}.closing-grid{display:grid;grid-template-columns:1.2fr 1fr;gap:80px}.book-closing h2{margin:24px 0}.book-closing p:not(.eyebrow){font-size:15px;color:#bec2ca;line-height:1.75;max-width:560px}.book-about{border-top:1px solid #343841;padding-top:24px;align-self:start}.book-about h3{font-size:23px;font-weight:400;margin:24px 0 18px}.book-about .book-disclaimer{font-size:12px!important;border-top:1px solid #343841;padding-top:22px;margin-top:24px}.book-about .book-prelaunch{font-size:12px!important;color:#d9a47c!important;margin-top:20px}@media(max-width:900px){.book-hero-grid{gap:28px;grid-template-columns:1.2fr .8fr}.book-stage{padding:22px 24px 18px}.book-hero h1{font-size:42px}.contents-grid,.closing-grid{gap:36px}.book-audiences{gap:24px}}@media(max-width:640px){.book-hero-grid,.book-heading,.contents-grid,.closing-grid,.book-audiences,.sample-row{grid-template-columns:1fr}.book-stage{max-width:280px;justify-self:center;grid-row:1;padding:20px}.book-hero h1{font-size:40px}.book-price strong{font-size:36px}.book-hero{padding-top:28px}.edition-nav{gap:18px;flex-wrap:wrap}.edition-nav .contents-link{margin-left:0}.edition-nav>span{width:100%}.book-heading{gap:20px}.book-contents,.book-closing{padding:48px 0}.book-facts{gap:28px}.book-stage figcaption{margin-top:20px}.sample-row{gap:24px}.book-audiences h3{margin-top:16px}.closing-grid{gap:44px}}
</style>
<style>
 @media(max-width:640px){.book-stage{grid-row:auto;max-width:220px}.book-hero-copy{display:flex;flex-direction:column;align-items:stretch}.book-hero-copy>.eyebrow{order:0}.book-hero-copy>h1{order:1}.book-hero-copy>.book-subtitle{order:2}.book-hero-copy>.book-price{order:3;margin:18px 0 20px}.book-hero-copy>:global(.ebook-actions){order:4}.book-hero-copy>.book-availability{order:5}.book-hero-copy>.book-intro{order:6;margin-top:24px}.book-hero-copy>.book-author{order:7}.book-hero-copy>.book-seller{order:5}}
</style>
