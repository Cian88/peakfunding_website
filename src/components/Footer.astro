---
/* Pied de page sur chaque page : liens légaux, ORIAS/ACPR et mention obligatoire. */
const colonnes = [
  { titre: 'Expertises', liens: [['/expertises/estate', 'PEAK ESTATE'], ['/expertises/pro', 'PEAK PRO'], ['/expertises/pim', 'PEAK PIM'], ['/expertises/insure', 'PEAK INSURE']] },
  { titre: 'Cabinet', liens: [['/#methode', 'Méthode'], ['/#equipe', 'Équipe'], ['/#partenaires', 'Partenaires'], ['/actualites', 'Actualités']] },
  { titre: 'Espaces', liens: [['/espace-client', 'Espace client'], ['/espace-mandataire', 'Espace mandataire'], ['/#rdv', 'Prendre rendez-vous']] },
  { titre: 'Réglementaire', liens: [['/mentions-legales', 'Mentions légales'], ['/politique-de-confidentialite', 'Politique de confidentialité & RGPD'], ['/cgu', 'Conditions générales d’utilisation']] },
];
const annee = new Date().getFullYear();
---

<footer class="sombre border-t border-filet">
  <div class="grille"></div>
  <div class="contenu relative py-16">
    <div class="grid grid-cols-2 gap-x-6 gap-y-10 md:grid-cols-4 lg:grid-cols-[1.4fr_repeat(4,1fr)]">
      <div class="col-span-2 max-w-md md:col-span-4 lg:col-span-1 lg:max-w-xs">
        <img src="/img/logo-peak-funding-ivoire.svg" alt="PEAK FUNDING" width="150" height="27" class="h-[26px] w-auto" />
        <p class="mt-4 text-[14px] leading-relaxed text-argent">Cabinet de courtage en financement stratégique. Immobilier, professionnel, assurance emprunteur. France entière.</p>
        <a href="mailto:contact@peakfunding.eu" class="mt-5 inline-block text-[14px] text-etoile underline decoration-filet underline-offset-4 hover:decoration-cuivre-clair">contact@peakfunding.eu</a>
      </div>
      {colonnes.map((c) => (
        <div>
          <h2 class="eyebrow text-argent">{c.titre}</h2>
          <ul class="mt-4 space-y-2.5">
            {c.liens.map(([href, libelle]) => (<li><a href={href} data-astro-reload={href === '/espace-client' || undefined} class="inline-block py-1 text-[13px] leading-relaxed text-argent transition-colors hover:text-etoile">{libelle}</a></li>))}
          </ul>
        </div>
      ))}
    </div>
    <div class="mt-12 space-y-3 border-t border-filet pt-7 font-mono text-[12px] leading-relaxed text-argent">
      <p>© {annee} PEAK FUNDING — ORIAS n° 24002546 — Sous supervision de l’ACPR, 4 place de Budapest, CS 92459, 75436 Paris Cedex 09.</p>
      <p class="text-argent">Un crédit vous engage et doit être remboursé. Vérifiez vos capacités de remboursement avant de vous engager.</p>
    </div>
  </div>
</footer>
