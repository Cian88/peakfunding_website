---
import Base from '../components/Feuillet.astro';
import { ACTELO_MANDATAIRE_URL } from '../data/integrations';
---

<Base title="Espace mandataire | PEAK FUNDING" description="Mandataires PEAK FUNDING : accédez à votre espace dédié pour gérer vos dossiers et suivre leur avancement.">
  <section class="cadre-page respiration">
    <nav aria-label="Fil d’Ariane" class="legende normal-case tracking-normal"><a href="/" class="hover:text-encre">Accueil</a> <span aria-hidden="true">/</span> Espace mandataire</nav>
    <div class="portail"><div>
      <p class="legende">Connexion à votre espace</p>
      <h1 class="grand-titre mt-3">Espace mandataire</h1>
      <p class="paragraphe mt-5 text-[18px]">Mandataires PEAK FUNDING : accédez à votre espace dédié pour gérer vos dossiers et suivre leur avancement.</p>
      </div><div class="mt-10 border filet bg-white p-7 sm:p-10">
        <p class="legende">Plateforme Actelo</p>
        <h2 class="mt-4 text-[24px]">Connexion à votre espace</h2>
        <p class="paragraphe mt-3">Vous allez être redirigé vers la plateforme sécurisée de gestion des dossiers mandataires.</p>
        <a href={ACTELO_MANDATAIRE_URL} target="_blank" rel="noopener" class="action-pleine mt-7">Accéder à l’espace mandataire ↗</a>
        <p class="mt-4 text-[12px] teinte-secondaire">Ouverture dans un nouvel onglet.</p>
      </div>
    </div>
  </section>
</Base>
