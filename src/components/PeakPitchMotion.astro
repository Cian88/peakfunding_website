  .pp-promesse{display:inline;margin:0 0 0 12px;font-size:clamp(17px,1.3vw,22px);font-weight:300;letter-spacing:-.03em}
  .pp-prix{display:flex;flex-direction:column;align-items:flex-start;gap:2px;line-height:1;margin:0;font-size:30px;font-weight:300;letter-spacing:-.04em;color:#d9a47c}
  .pp-prix small{white-space:nowrap;font-size:11px;line-height:1.5;letter-spacing:0;color:#a6a9b3}
  .pp-offre .btn-cuivre{white-space:nowrap}
  .pp-banques{grid-column:1/-1;margin:0;font-size:12px;color:#7c808a}

  .pp-pied{display:flex;align-items:center;justify-content:space-between;gap:18px;min-height:64px;width:calc(100% - 64px);max-width:1296px;margin:0 auto;border-top:1px solid #2a2f3a;font-size:11px;color:#a6a9b3}
  .pp-pied p{margin:0;line-height:1.6}.pp-pied p span{display:block;font-size:10px}
  .pp-pied nav{display:flex;gap:24px;flex-wrap:wrap}
  .pp-pied a{display:inline-flex;align-items:center;min-height:44px;color:#edeae4;transition:color .18s}.pp-pied a:hover{color:#d9a47c}

  /* ── Relief de marque, phases, cartes enrichies ── */
  .pp-phases{position:absolute;left:4cqw;right:4cqw;top:6.6cqw;display:flex;justify-content:space-between;margin:0;padding:0;list-style:none}
  .pp-phases li{display:flex;gap:.8cqw;font:1.3cqw var(--font-mono);letter-spacing:.07em;text-transform:uppercase;color:#edeae4}
  .pp-phases li span{color:#d9a47c}
  .pp-phases-ligne{position:absolute;left:4cqw;right:4cqw;top:9.8cqw;height:.25cqw;border-radius:1cqw;overflow:hidden;background:#2a2f3a}
  .pp-phases-ligne b{display:block;height:100%;background:#d9a47c;transform-origin:left}

  .pp-q-tete{display:flex;justify-content:space-between;align-items:baseline}
  .pp-q-tete .pp-carte-titre{margin:0}
  .pp-q .pp-rail{position:relative;left:auto;right:auto;top:auto;margin:1.4cqw 0 2.6cqw}
  .pp-q .pp-compteur{margin:0;color:#d9a47c}
  .pp-q-corps{display:grid;grid-template-columns:7cqw 1fr;gap:3cqw}
  .pp-q-etapes{margin:0;padding:0 0 0 0;list-style:none;border-right:1px solid #2a2f3a}
  .pp-q-etapes li{padding:.75cqw 0;font:1.3cqw var(--font-mono);color:#d9a47c}
  .pp-q-titre{margin:0 0 1.8cqw;font-size:2.6cqw;font-weight:300;letter-spacing:-.03em}
  .pp-champs{display:grid;grid-template-columns:1fr 1fr;gap:1.5cqw 1.8cqw}
  .pp-champ span{display:block;margin-bottom:.6cqw;font-size:1.25cqw;color:#a6a9b3}
  .pp-champ b{display:block;padding:1.1cqw 1.3cqw;border:1px solid #2a2f3a;border-radius:.8cqw;background:#14171e;font:400 1.6cqw var(--font-sans);color:#edeae4;white-space:nowrap;overflow:hidden}
  .pp-champ em{display:inline-block;font-style:normal;clip-path:inset(0)}
  .pp-continuer{display:inline-block;margin:2.2cqw 0 0;padding:.9cqw 2.2cqw;border:1px solid #b87b4f;border-radius:4cqw;font-size:1.4cqw;color:#d9a47c}

  .pp-c-corps{display:grid;grid-template-columns:1.3fr 1fr;gap:3cqw;align-items:start}
  .pp-c .pp-ligne{padding:1.3cqw 0;font-size:1.7cqw}
  .pp-c .pp-ligne b{font-size:1.9cqw}
  .pp-c .pp-ligne em{width:11cqw;font-size:1.15cqw}
  .pp-coherence{padding:2cqw 2.2cqw;border:1px solid #2a2f3a;border-radius:1.6cqw;background:#14171e}
  .pp-coherence p{margin:0 0 1.2cqw;font:1.2cqw var(--font-mono);letter-spacing:.08em;text-transform:uppercase;color:#a6a9b3}
  .pp-coherence span{display:flex;gap:1cqw;align-items:flex-start;padding:1.1cqw 0;border-top:1px solid #2a2f3a;font:1.3cqw/1.45 var(--font-mono);color:#edeae4}
  .pp-coherence svg{flex:0 0 auto;width:1.8cqw;height:1.8cqw;fill:none;stroke:#d9a47c;stroke-width:1.8;stroke-dasharray:16}

  /* Bords de pages empilées (aplats nets, pas d'ombre portée floue). */
  .pp-note{box-shadow:.7cqw .7cqw 0 -.05cqw #e6e1d8,1.4cqw 1.4cqw 0 -.1cqw #cdc5b8}
  .pp-pieces{box-shadow:.7cqw .7cqw 0 -.05cqw #d9d2c6}
  .pp-vignettes{display:flex;gap:.8cqw;padding:.8cqw 3cqw 0}
  .pp-vignettes i{flex:1;display:flex;flex-direction:column;gap:.4cqw;height:3.4cqw;padding:.6cqw;border:1px solid #e2ded7;border-radius:.4cqw;background:#fff}
  .pp-vignettes i.actif{border-color:#b87b4f}
  .pp-vignettes b{display:block;height:.35cqw;border-radius:1cqw;background:#e2ded7}.pp-vignettes b+b{width:60%}
  .pp-vignettes i.actif b:first-child{background:#b87b4f}

  .pp-pdf{position:absolute;right:11cqw;bottom:2.6cqw;z-index:4;display:flex;align-items:center;gap:.5cqw;margin:0;padding:1.1cqw 1.8cqw;border:1px solid #2a2f3a;border-radius:40px;background:#0b0d12;font:1.3cqw var(--font-mono);color:#a6a9b3}
  .pp-pdf i{width:1.3cqw;height:1.7cqw;border:1px solid #d9a47c;border-radius:.2cqw}.pp-pdf i:nth-of-type(3){margin-right:.7cqw}

  /* ── Pages A4 réalistes ── */
  .pp-note{height:62.2cqw;display:flex;flex-direction:column;background:#fdfcf9}
  .pp-pieces{height:56.6cqw;display:flex;flex-direction:column;background:#f9f7f2}
  .pp-tete-doc{display:flex;justify-content:space-between;align-items:flex-start;margin:2.4cqw 3cqw 0;padding-bottom:1cqw;border-bottom:1px solid #d9d3c9;font:.8cqw/1.35 var(--font-mono);letter-spacing:.06em;color:#62656d;text-align:right}
  .pp-logo{display:flex;align-items:center;gap:.6cqw;font:500 1cqw var(--font-sans);letter-spacing:.14em;color:#111}
  .pp-logo svg{width:1.6cqw;height:1.4cqw;fill:none;stroke:#b87b4f;stroke-width:1.6;stroke-linejoin:round}
  .pp-page{flex:1;padding:1.8cqw 3cqw 0}
  .pp-surtitre{margin:0;font:.85cqw var(--font-mono);letter-spacing:.14em;color:#825333}
  .pp-titre-doc{margin:.6cqw 0 0;font-size:2.15cqw;line-height:1.1;font-weight:400;letter-spacing:-.03em;color:#111}
  .pp-sous-doc{margin:.6cqw 0 0;padding-bottom:1cqw;border-bottom:1px solid #e6e1d8;font-size:.95cqw;color:#62656d}
  .pp-h{margin:1.2cqw 0 .4cqw;font-size:1.1cqw;font-weight:500;color:#111}
  .pp-texte-doc{margin:0;font-size:1cqw;line-height:1.55;text-align:justify;hyphens:auto;color:#3d3f46}
  .pp-tableau{width:100%;border-collapse:collapse;font-size:.95cqw;color:#3d3f46}
  .pp-tableau th{padding:.35cqw 0;border-bottom:1px solid #111;font:.75cqw var(--font-mono);letter-spacing:.08em;text-transform:uppercase;text-align:left;color:#62656d}
  .pp-tableau td{padding:.36cqw 0;border-bottom:1px solid #ebe6dd}
  .pp-tableau th:nth-child(2),.pp-tableau td:nth-child(2){text-align:right;font-family:var(--font-mono);letter-spacing:-.03em;color:#111}
  .pp-tableau th:nth-child(3),.pp-tableau td:nth-child(3){padding-left:1.5cqw;text-align:right;font-size:.8cqw;color:#825333}
  .pp-tableau tr.total td{border-bottom:0;border-top:1px solid #111;font-weight:500;color:#111}
  .pp-tableau-pieces{margin-top:1.4cqw}
  .pp-tableau-pieces th:nth-child(1),.pp-tableau-pieces td:nth-child(1){width:2cqw}
  .pp-tableau-pieces th:nth-child(2),.pp-tableau-pieces td:nth-child(2){text-align:left;font-family:var(--font-sans);letter-spacing:0;color:#3d3f46}
  .pp-tableau-pieces td:nth-child(3){font-family:var(--font-mono)}
  .pp-tableau-pieces tr.groupe td{padding:.55cqw .6cqw;border-bottom:0;background:#efe9df;font-size:.9cqw;color:#3d3f46}
  .pp-tableau-pieces tr.groupe b{font-weight:500;color:#111}
  .pp-tableau-pieces tbody + tbody tr.groupe td{border-top:.8cqw solid transparent;background-clip:padding-box}
  .pp-tableau .case{display:block;width:1cqw;height:1cqw;border:1px solid #825333;border-radius:.15cqw}
  .pp-renvoi{margin:.8cqw 0 0;font-size:.8cqw;font-style:italic;color:#62656d}
  .pp-pied-doc{display:flex;justify-content:space-between;gap:2cqw;white-space:nowrap;margin:0 3cqw 1.4cqw;padding-top:.8cqw;border-top:1px solid #e6e1d8;font:.72cqw var(--font-mono);letter-spacing:.04em;color:#7c808a}
  .pp-tete-diapo{display:flex;justify-content:space-between;align-items:center;margin:1.6cqw 3cqw 0;padding-bottom:.8cqw;border-bottom:1px solid #d9d3c9;font:.8cqw var(--font-mono);letter-spacing:.06em;color:#62656d}
  .pp-note .pp-barre-financement{height:.7cqw;margin-top:.9cqw}
  .pp-note .pp-barre-legende{font-size:.85cqw}

  /* ── Diapositives de la présentation bancaire ── */
  .pp-diapos{position:relative;flex:0 0 28.6cqw}
  .pp-diapo{position:absolute;inset:0;display:grid;grid-template-columns:1.2fr 1fr;gap:2cqw;padding:1.8cqw 3cqw 2.2cqw;background:#fbfaf7}
  .pp-diapo.d2,.pp-diapo.d3{opacity:0;visibility:hidden}
  .pp-diapo-pied{position:absolute;left:3cqw;right:3cqw;bottom:.4cqw;display:flex;justify-content:space-between;margin:0;font:.8cqw var(--font-mono);letter-spacing:.08em;color:#a6a9b3}
  .pp-diapo-titre{margin:.8cqw 0 0;font-size:2.4cqw;line-height:1.05;font-weight:300;letter-spacing:-.04em}
  .pp-chips{display:flex;gap:.7cqw;margin:1.2cqw 0 0}
  .pp-chips span{display:flex;flex-direction:column;gap:.15cqw;padding:.5cqw .9cqw;border:1px solid #e2ded7;border-radius:.6cqw;background:#fff;font:1.1cqw var(--font-mono);letter-spacing:-.03em;color:#111}
  .pp-chips small{font:.8cqw var(--font-sans);letter-spacing:0;color:#62656d}
  .pp-immeuble{display:flex;flex-direction:column;align-items:center;justify-content:center;margin:0;padding:1cqw;border-radius:1cqw;background:#f2ede6}
  .pp-immeuble svg{width:100%;height:19cqw;fill:none;stroke:#b87b4f;stroke-width:.7;stroke-linejoin:round}
  .pp-immeuble [pathLength]{stroke-dasharray:1}
  .pp-immeuble .t3{fill:#e9d3bf}
  .pp-immeuble figcaption{margin-top:.5cqw;font:.9cqw var(--font-mono);letter-spacing:.06em;color:#825333}
  .pp-er{display:grid;grid-template-columns:1fr 1fr;gap:1.6cqw;margin-top:1.4cqw}
  .pp-er p{display:flex;justify-content:space-between;gap:.6cqw;min-height:2.2cqw;margin:0;padding:.5cqw 0;border-top:1px solid #e9e5de;font-size:.95cqw;color:#3d3f46}
  .pp-er p b{font:400 .95cqw var(--font-mono);color:#111;white-space:nowrap}
  .pp-er p.tete{min-height:0;border:0;font:.85cqw var(--font-mono);letter-spacing:.08em;text-transform:uppercase;color:#825333}
  .pp-er p.vide{border-color:transparent}
  .pp-er p.tot{border-top:1px solid #111;font-weight:500;color:#111}
  .d2 .pp-anneau{justify-content:flex-start;padding-top:1.6cqw}.d2 .pp-anneau > p{top:1.6cqw}
  .pp-barres{margin-top:1.6cqw}
  .pp-barres p{display:grid;grid-template-columns:10.5cqw 1fr 5cqw;align-items:center;gap:1cqw;margin:0;padding:.6cqw 0;border-top:1px solid #e9e5de;font-size:.95cqw;color:#3d3f46}
  .pp-barres i{display:block;height:1.1cqw;border-radius:1cqw;background:#eeebe5;overflow:hidden}
  .pp-barres i b{display:block;height:100%;background:#b87b4f;transform-origin:left}
  .pp-barres p:nth-child(2) i b{background:#d9c2ad}.pp-barres p:nth-child(3) i b{background:#111}
  .pp-barres em{font:normal .95cqw var(--font-mono);text-align:right;color:#111}
  .pp-couverture{display:flex;justify-content:space-between;align-items:baseline;gap:1cqw;margin:1.2cqw 0 0;padding:.8cqw 1cqw;border-radius:.6cqw;background:#f2ede6;font-size:.95cqw;color:#3d3f46}
  .pp-couverture b{font:400 1.3cqw var(--font-mono);color:#111}
  .pp-jauge{display:flex;flex-direction:column;align-items:center;justify-content:center}
  .pp-jauge svg{width:20cqw;height:11.3cqw;fill:none;stroke-linecap:round}
  .pp-jauge .fond{stroke:#eeebe5;stroke-width:5}
  .pp-jauge .val{stroke:#b87b4f;stroke-width:5;stroke-dasharray:56.4 100}
  .pp-jauge .repere{stroke:#111;stroke-width:.8}
  .pp-jauge p{display:flex;flex-direction:column;align-items:center;margin:-4.6cqw 0 0}
  .pp-jauge p b{font:400 2.2cqw var(--font-mono);letter-spacing:-.05em}
  .pp-jauge p span{font-size:.95cqw;color:#62656d}
  .pp-jauge small{margin-top:1.2cqw;font:.8cqw var(--font-mono);letter-spacing:.08em;color:#825333}

  /* Repères de cadrage techniques */
  .pp-reperes i{position:absolute;width:1.8cqw;height:1.8cqw;border:0 solid #d9a47c66}
  .pp-reperes i:nth-child(1){left:1.4cqw;top:1.4cqw;border-left-width:1px;border-top-width:1px}
  .pp-reperes i:nth-child(2){right:1.4cqw;top:1.4cqw;border-right-width:1px;border-top-width:1px}
  .pp-reperes i:nth-child(3){left:1.4cqw;bottom:1.4cqw;border-left-width:1px;border-bottom-width:1px}
  .pp-reperes i:nth-child(4){right:1.4cqw;bottom:1.4cqw;border-right-width:1px;border-bottom-width:1px}
  .pp-reperes span{position:absolute;left:1.2cqw;top:50%;writing-mode:vertical-rl;transform:translateY(-50%) rotate(180deg);font:.9cqw var(--font-mono);letter-spacing:.25em;color:#7c808a}

  /* ── Clôture : tampon d'encre cuivre et appel vers l'offre ── */
  .pp-tampon{position:absolute;left:37cqw;top:54cqw;z-index:6;width:23cqw;height:23cqw;color:#9c5f36;opacity:.9;mix-blend-mode:multiply;transform:rotate(-14deg);pointer-events:none}
  .pp-tampon svg{width:100%;height:100%;overflow:visible;fill:none;stroke:currentColor;stroke-width:2.2}
  .pp-tampon .fin{stroke-width:.8}
  .pp-tampon text{fill:currentColor;stroke:none;font:600 6.2px var(--font-mono)}
  .pp-tampon .pret{font:700 8px var(--font-mono);letter-spacing:.2em}
  .pp-tampon .coche{stroke-width:4.4;stroke-linecap:round;stroke-linejoin:round}
  .pp-tampon::after{content:'';position:absolute;inset:-6%;border:1px solid #d9a47c;border-radius:50%;opacity:0}

  /* ── Carte de conclusion ── */
  .pp-fin{position:absolute;inset:0;z-index:7;display:flex;flex-direction:column;justify-content:flex-end;padding:0 6cqw 8cqw;background:linear-gradient(180deg,#0b0d1200 26%,#0b0d12cc 50%,#0b0d12f2 66%,#0b0d12 80%);pointer-events:none}
  .pp-fin > *{pointer-events:auto}
  .pp-fin-kicker{margin:0;font:max(10px,1.35cqw) var(--font-mono);letter-spacing:.14em;color:#d9a47c}
  .pp-fin-titre{max-width:84cqw;margin:1.6cqw 0 0;font-size:max(22px,5.6cqw);line-height:1.04;font-weight:300;letter-spacing:-.045em;color:#edeae4;text-wrap:balance}
  .pp-fin-titre em{font-style:normal;color:#d9a47c}
  .pp-fin-sous{max-width:70cqw;margin:2.2cqw 0 0;font-size:max(13px,1.75cqw);line-height:1.55;font-weight:300;color:#a6a9b3}
  @media (max-width:640px){.pp-fin{padding:0 5cqw 5cqw}.pp-fin-titre{font-size:max(19px,5.6cqw)}.pp-fin-sous{display:none}}

  /* ── Chorégraphie (≈ 45 s, tampon de clôture à 36,9 s, carte de conclusion à 39,4 s, une seule fois). L'état de base ci-dessus est l'image finale.
       Une pause marque la fin de chaque phase :
       01 questionnaire 0,8–8,5 s · 02 rapprochement 8,6–15,4 s ·
       03 livrables : note 15,5 s, pièces 21,1 s, présentation 25,7 s · 04 contrôle 35,1 s. ── */
  @media (prefers-reduced-motion: no-preference){
    .pp-anime .pp-entete{animation:pp-fondu .8s ease both}
    .pp-anime .pp-phases li{animation:pp-allume .6s ease both;animation-delay:var(--t)}
    .pp-anime .pp-phases-ligne b{animation:pp-progression 35.78s linear both}
    .pp-anime .pp-reperes{animation:pp-fondu 1.62s ease .4s both}

    .pp-anime .pp-q{animation:pp-passage 7.7s cubic-bezier(.2,.7,.2,1) .6s both}
    .pp-anime .pp-q .pp-rail i{animation:pp-remplir .4s cubic-bezier(.3,.7,.3,1) both;animation-delay:calc(1.62s + var(--i) * .45s)}
    .pp-anime .pp-q-etapes li{animation:pp-etape .3s ease both;animation-delay:calc(1.62s + var(--i) * .45s)}
    .pp-anime .pp-compteur{animation:pp-etapes 4.86s steps(7,end) 1.62s both}
    .pp-anime .pp-champ{animation:pp-monte .4s cubic-bezier(.2,.7,.2,1) both;animation-delay:calc(1.49s + var(--i) * .55s)}
    .pp-anime .pp-champ b{animation:pp-focus .9s ease forwards;animation-delay:calc(1.62s + var(--i) * .55s)}
    .pp-anime .pp-champ em{animation:pp-frappe .45s steps(14,end) both;animation-delay:calc(1.76s + var(--i) * .55s)}
    .pp-anime .pp-continuer{animation:pp-fondu .5s ease 6.62s both}

    .pp-anime .pp-c{animation:pp-passage-c 6.75s cubic-bezier(.2,.7,.2,1) 8.64s both}
    .pp-anime .pp-c .pp-ligne{animation:pp-monte .5s cubic-bezier(.2,.7,.2,1) both;animation-delay:calc(9.32s + var(--i) * .4s)}
    .pp-anime .pp-c .pp-ligne em{animation:pp-tampon .4s cubic-bezier(.3,1.6,.5,1) both;animation-delay:calc(9.65s + var(--i) * .4s)}
    .pp-anime .pp-coherence{animation:pp-fondu .5s ease 11.61s both}
    .pp-anime .pp-coherence span{animation:pp-monte .45s cubic-bezier(.2,.7,.2,1) both;animation-delay:calc(12.02s + var(--i) * .45s)}
    .pp-anime .pp-coherence svg{animation:pp-coche .4s ease both;animation-delay:calc(12.29s + var(--i) * .45s)}

    .pp-anime .pp-note{--d:15.53s;animation:pp-note 5.27s cubic-bezier(.65,0,.25,1) 15.53s both}
    .pp-anime .pp-pieces{--d:21.06s;animation:pp-pieces 4.32s cubic-bezier(.65,0,.25,1) 21.06s both}
    .pp-anime .pp-pres{--d:25.65s;animation:pp-pres 8.91s cubic-bezier(.65,0,.25,1) 25.65s both}
    .pp-anime .pp-immeuble [pathLength]{animation:pp-trace1 2.16s cubic-bezier(.4,0,.2,1) both;animation-delay:calc(var(--d) + .8s)}
    .pp-anime .pp-immeuble .t3{animation:pp-trace1 2.16s cubic-bezier(.4,0,.2,1) both,pp-fondu-t3 .6s ease both;animation-delay:calc(var(--d) + .8s),calc(var(--d) + 2.43s)}
    .pp-anime .pp-diapo.d2{animation:pp-diapo 2.56s cubic-bezier(.4,0,.2,1) both;animation-delay:calc(var(--d) + 2.84s)}
    .pp-anime .pp-diapo.d3{animation:pp-diapo 2.56s cubic-bezier(.4,0,.2,1) both;animation-delay:calc(var(--d) + 5.27s)}
    .pp-anime .d2 .pp-er{animation:pp-monte .5s ease both;animation-delay:calc(var(--d) + 3.24s)}
    .pp-anime .pp-barres i b{animation:pp-remplir .7s cubic-bezier(.3,.7,.3,1) both;animation-delay:calc(var(--d) + 5.8s + var(--i) * .2s)}
    .pp-anime .pp-jauge .val{animation:pp-anneau 1.35s cubic-bezier(.3,.7,.3,1) both;animation-delay:calc(var(--d) + 5.94s)}
    .pp-anime .pp-vignettes i:nth-child(5){animation:pp-vig 2.56s linear;animation-delay:calc(var(--d) + 2.84s)}
