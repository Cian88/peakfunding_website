  .pp-doc-titre{margin:.9cqw 0 0;padding-bottom:1.4cqw;border-bottom:.25cqw solid #b87b4f;width:fit-content;font-size:3.1cqw;line-height:1.05;font-weight:300;letter-spacing:-.04em}

