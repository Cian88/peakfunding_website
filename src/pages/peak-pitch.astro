---
import Base from '../layouts/Base.astro';
const service = (import.meta.env.PUBLIC_PEAK_DOSSIER_URL || (import.meta.env.DEV ? 'http://127.0.0.1:8788' : '')).replace(/\/$/, '');
---
<Base title="PEAK PITCH | Préparez votre dossier bancaire" description="Questionnaire guidé, simulations, note de synthèse, listes de pièces et présentation corporate bancaire. 99 €, TVA non applicable pour un projet." noindex>
 <div class="contenu dossier-offre">
  <div class="offre-grid">
   <section><p class="eyebrow">PEAK PITCH / PRÉPARATION BANCAIRE</p><h1>Un projet ambitieux.<br/>Un dossier qui<br/>le rend clair.</h1><p class="intro">Mettez vos chiffres en perspective et préparez les bons documents. Repartez avec trois livrables structurés pour présenter votre projet.</p>
    <ol><li><span>01</span><div><h2>Une note de synthèse qui fait le lien.</h2><p>Votre situation, votre projet et vos chiffres clés, avec une annexe exhaustive des informations déclarées.</p></div></li><li><span>02</span><div><h2>Les bonnes pièces, pour chacun.</h2><p>Une liste distincte par personne physique et par société concernée, selon son rôle. Aucun dépôt de fichiers.</p></div></li><li><span>03</span><div><h2>Une présentation pensée pour la banque.</h2><p>Financement, patrimoine, cash-flow et analyse des comptes des sociétés, dans une présentation professionnelle.</p></div></li></ol>
   </section>
   <aside><p class="eyebrow">1 PROJET / 3 LIVRABLES</p><h2>Votre accès PEAK PITCH</h2><div class="prix">99 € <small>TVA non applicable</small></div><p>Paiement unique. Sans abonnement.</p><ul><li>Questionnaire guidé en 8 étapes</li><li>Simulations et analyse des bilans</li><li>Trois livrables distincts</li><li>Reprise par lien personnel</li></ul>{service ? <a href={`${service}/paiement.html`} class="btn-cuivre" data-astro-reload>Passer au paiement sécurisé ↗</a> : <p class="ouverture">Le paiement sera disponible à l’ouverture du service.</p>}<p class="secondaire">Le récapitulatif et les conditions de vente sont présentés avant tout paiement.</p></aside>
  </div>
  <section class="film"><p class="eyebrow">DU PROJET AUX LIVRABLES</p><h2>Découvrez le parcours en 22 secondes.</h2><video controls playsinline preload="metadata" poster="/peak-pitch/peak-pitch-affiche.jpg" aria-label="Présentation sans son de PEAK PITCH avec textes à l’écran"><source src="/peak-pitch/peak-pitch-publicite.mp4" type="video/mp4"/></video><p class="option">Après la remise de vos trois livrables, <strong>PEAK EXCHANGE</strong>, un échange avec un courtier spécialisé, peut être choisi pour <strong>199 € TTC supplémentaires</strong>. Il permet de comprendre le contexte bancaire actuel et de recevoir une note de conseil personnalisée avec les arguments liés à votre profil et le regard d’un professionnel du financement sur votre projet. Cette option est facultative.</p></section>
 </div>
</Base>
<style>
 .dossier-offre{padding-block:65px 80px}.offre-grid{display:grid;grid-template-columns:minmax(0,1.35fr) minmax(330px,.8fr);gap:80px;align-items:start}h1{font-size:clamp(42px,4.5vw,68px);font-weight:300;line-height:1.06;letter-spacing:-.045em;margin-top:24px}.intro{font-size:18px;line-height:1.6;max-width:600px;color:#6d7078;margin-top:28px}ol{padding:0;list-style:none;margin-top:36px}ol li{display:grid;grid-template-columns:32px 1fr;gap:16px;padding:22px 0;border-top:1px solid #e2ded7}ol span{font:12px var(--font-mono);color:#9a6b45}ol h2{font-size:18px;line-height:1.4}ol p{font-size:13px;line-height:1.6;color:#6d7078;margin-top:6px}aside{background:#0b0d12;border-top:3px solid #b87b4f;border-radius:8px;padding:30px;color:#edeae4}aside .eyebrow{color:#d9a47c}aside h2{color:#edeae4;font-size:24px;font-weight:300;margin-top:22px}.prix{font:64px/1.15 var(--font-mono);letter-spacing:-3px;margin:28px 0 8px}.prix small{font:13px var(--font-sans);letter-spacing:0;color:#a6a9b3}aside>p{font-size:12px;color:#a6a9b3}aside ul{list-style:none;margin:24px 0;padding:20px 0;border-block:1px solid #2a2f3a;font-size:13px}aside li{padding:6px 0}aside li:before{content:'✓';color:#d9a47c;margin-right:10px}aside .btn-cuivre{width:100%;font-size:14px}.secondaire{margin-top:18px}.ouverture{border-left:2px solid #b87b4f;padding-left:15px}.film{border-top:1px solid #e2ded7;padding-top:45px;margin-top:60px}.film h2{font-size:30px;font-weight:300;margin:20px 0}.film video{width:100%;border-radius:8px;display:block}.option{font-size:13px;line-height:1.7;color:#6d7078;max-width:900px;margin-top:30px;border-left:2px solid #b87b4f;padding-left:20px}@media(max-width:900px){.offre-grid{gap:32px}}@media(max-width:700px){.offre-grid{grid-template-columns:1fr}.dossier-offre{padding-block:35px 55px}h1{font-size:43px}aside{padding:25px}.film h2{font-size:26px}}
</style>
