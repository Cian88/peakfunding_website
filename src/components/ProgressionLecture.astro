---
import {langCourante} from '../i18n';
const en=langCourante(Astro.currentLocale)==='en';
---
<div data-reading-progress class="lecture-courbe" hidden>
  <span class="lecture-label" aria-hidden="true">{en ? 'Reading' : 'Lecture'}</span>
  <div class="lecture-graph">
    <svg viewBox="0 0 64 244" fill="none" aria-hidden="true">
      <path class="lecture-grille" d="M10 18H52M10 122H52M10 226H52" />
      <path data-reading-path class="lecture-fond" d="M12 226C22 205 18 188 23 168S30 125 32 114S35 62 48 18" />
      <path data-reading-trace class="lecture-trace" pathLength="1" stroke-dasharray="1" stroke-dashoffset="1" d="M12 226C22 205 18 188 23 168S30 125 32 114S35 62 48 18" />
      <g data-reading-point transform="translate(12 226)"><circle r="9" class="lecture-halo"/><circle r="3.5" class="lecture-point"/></g>
    </svg>
    <input data-reading-position type="range" min="0" max="1000" step="1" value="0" aria-label={en ? 'Scroll through the page' : 'Parcourir la page'} aria-orientation="vertical" title={en ? 'Drag to move through the page' : 'Glisser pour parcourir la page'} />
  </div>
  <span data-reading-percent class="lecture-percent" aria-hidden="true">00 %</span>
</div>
<style>
  /* La barre native reste disponible sans JavaScript et en contraste forcé. */
  :global(html.lecture-personnalisee){scrollbar-width:none}
  :global(html.lecture-personnalisee::-webkit-scrollbar){display:none}
  .lecture-courbe{position:fixed;z-index:35;right:12px;top:50%;transform:translateY(-50%);width:64px;padding:14px 0;background:#0b0d12ed;border:1px solid #2a2f3a;border-radius:36px;color:#edeae4;user-select:none}
  .lecture-courbe[hidden]{display:none}
  .lecture-label,.lecture-percent{display:block;text-align:center;font-family:var(--font-mono);font-variant-numeric:tabular-nums}
  .lecture-label{font-size:8px;letter-spacing:.12em;text-transform:uppercase;color:#a6a9b3}
  .lecture-percent{font-size:11px;line-height:1.5;color:#d9a47c}
  .lecture-graph{position:relative;height:244px}
  .lecture-graph svg{display:block;width:100%;height:100%;overflow:visible}
  .lecture-grille{stroke:#50545f;stroke-width:.6;stroke-dasharray:1 4}
  .lecture-fond{stroke:#626771;stroke-width:1}
  .lecture-trace{stroke:#d9a47c;stroke-width:1.6;stroke-linecap:round}
  .lecture-point{fill:#d9a47c;stroke:#0b0d12;stroke-width:1.2}
  .lecture-halo{fill:#d9a47c;opacity:.14}
  .lecture-graph input{position:absolute;inset:18px 0;width:100%;height:208px;margin:0;opacity:0;cursor:ns-resize;writing-mode:vertical-lr;direction:rtl;touch-action:none}
  .lecture-courbe:focus-within{outline:2px solid #d9a47c;outline-offset:4px}
  @media(max-width:1439px),(max-height:550px){
    .lecture-courbe{width:12px;height:132px;right:3px;padding:0;border:0;border-radius:0;background:transparent;pointer-events:none}
    .lecture-graph{height:132px}.lecture-graph svg{overflow:hidden}
    .lecture-label,.lecture-percent,.lecture-grille,.lecture-graph input,.lecture-halo{display:none}
    .lecture-fond,.lecture-trace,.lecture-point{vector-effect:non-scaling-stroke}
    .lecture-fond{stroke:#858991}.lecture-trace{stroke:#b87b4f;stroke-width:1.5}
  }
  @media(forced-colors:active){
    :global(html.lecture-personnalisee){scrollbar-width:auto}
    :global(html.lecture-personnalisee::-webkit-scrollbar){display:revert}
    .lecture-courbe{display:none}
  }
  @media print{.lecture-courbe{display:none}}
</style>
