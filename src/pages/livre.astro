---
import Base from '../components/Feuillet.astro';
import Corps from '../components/pages/EbookCorps.astro';
import {ebook, EBOOK_AUTHOR, checkoutURL} from '../data/ebook';
const b=ebook('fr');
const schema={'@type':'Book',name:b.title,alternativeHeadline:b.subtitle,inLanguage:'fr',bookFormat:'https://schema.org/EBook',encodingFormat:'application/pdf',numberOfPages:b.pages,author:{'@type':'Person',name:EBOOK_AUTHOR},image:'https://peakfunding.eu/img/ebook/couverture-fr.webp',...(checkoutURL('fr') ? {offers:{'@type':'Offer',seller:{'@id':'https://peakfunding.eu/#organisation'},price:'24.90',priceCurrency:'EUR',availability:'https://schema.org/InStock',url:'https://peakfunding.eu/livre/'}} : {})};
---
<Base title="Financer son projet en France — Ebook | PEAK FUNDING" description="Le guide de Valentin Boura--Defranoux : crédit immobilier, locatif, SCI, holding et financements spécialisés. 26 chapitres, 80 pages. PDF à 24,90 €." image="/img/ebook/couverture-fr.webp" schema={[schema]}><Corps /></Base>
