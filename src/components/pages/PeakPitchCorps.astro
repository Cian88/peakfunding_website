---
import MargeRelief from '../MargeRelief.astro';
/* Page PEAK PITCH (FR/EN) : textes, FAQ et renvois issus de src/data/peak-pitch.ts, comme les données structurées. */
import { peakPitch, guidesPeakPitch, SERVICE_URL } from '../../data/peak-pitch';
import articlesFr from '../../data/articles.json';
import articlesEn from '../../data/en/articles.json';
import { langCourante, localiser } from '../../i18n';

const lang = langCourante(Astro.currentLocale);
const L = (p: string) => localiser(p, lang);
const t = peakPitch(lang);
const service = SERVICE_URL;
const accord = lang === 'fr' ? 'Le financement reste soumis à l’accord des banques.' : 'Financing remains subject to approval by the banks.';
const tva = lang === 'fr' ? 'TVA non applicable' : 'VAT not applicable';
function conditionsPrix(texte: string) {
  if (!/99\s*€|€\s*99/.test(texte)) return '';
  return texte.toLowerCase().includes(tva.toLowerCase()) ? accord : `${tva}. ${accord}`;
}
const guides = (lang === 'en' ? articlesEn : articlesFr).filter((a) => (guidesPeakPitch as readonly string[]).includes(a.slug));
---

<div class="cadre-page dossier-offre">
  <div class="offre-grid">
    <section>
      <p class="legende">{t.eyebrow}</p>
      <h1 set:html={t.h1} />
      <div class="offre-mobile">
        <strong>99 €</strong>
        <span>{lang === 'fr' ? 'TVA non applicable · 3 livrables' : 'VAT not applicable · 3 deliverables'}</span><p>{accord}</p>
        {service ? <a href={`${service}/paiement.html${lang === 'en' ? '?lang=en' : ''}`} class="action-pleine" data-astro-reload>{t.offre.bouton}</a> : <p>{t.offre.ouverture}</p>}
      </div>
      <p class="intro">{lang === 'fr' ? 'Préparez votre dossier de prêt immobilier avec la méthode du cabinet. Vous recevez trois documents pour présenter votre demande aux banques de votre choix.' : 'Prepare your French mortgage application using the firm’s method. You receive three documents to present your application to the banks you choose.'}</p>
      {lang === 'en' && <p class="text-sm my-4">Checkout and the PEAK PITCH questionnaire are currently in French.</p>}
      <ol>{t.livrables.map((l, i) => <li><span>{String(i + 1).padStart(2, '0')}</span><div><h2>{l.titre}</h2><p>{l.texte}</p></div></li>)}</ol>
    </section>
    <aside>
      <MargeRelief offre="pitch" />

      <p class="legende">{t.offre.eyebrow}</p>
      <h2>{t.offre.titre}</h2>
      <p class="offre-stancer">{lang==='fr'?'Paiement sécurisé par Stancer après ouverture du service.':'Secure payment with Stancer once the service opens.'}</p><div class="prix">99 € <small>{lang === 'fr' ? 'TVA non applicable' : 'VAT not applicable'}</small></div>
      <p>{accord}</p>
      {t.offre.mentions.map((m) => <p>{m}</p>)}
      <ul>{t.offre.points.map((p) => <li>{p}</li>)}</ul>
      {service ? <a href={`${service}/paiement.html${lang === 'en' ? '?lang=en' : ''}`} class="action-pleine" data-astro-reload>{t.offre.bouton}</a> : <p class="ouverture">{t.offre.ouverture}</p>}
      <p class="secondaire">{t.offre.secondaire} <a href={L('/conditions-peak-pitch/')} class="cgv">{lang === 'fr' ? 'Conditions générales de vente' : 'Terms of sale (French)'}</a></p>
    </aside>
  </div>

  <section class="bloc" aria-labelledby="pitch-promesse">
    <p class="legende">{t.libelles.promesse}</p>
    <div class="deux-colonnes">
      {[[t.promesse.titreMain, t.promesse.main], [t.promesse.titreCabinet, t.promesse.cabinet]].map(([titre, blocs], i) => (
        <div><h2 id={i === 0 ? 'pitch-promesse' : undefined}>{titre as string}</h2><ul class="liste">{(blocs as { titre: string; texte: string }[]).map((b) => <li><h3>{b.titre}</h3><p>{b.texte}</p>{conditionsPrix(b.texte) && <small>{conditionsPrix(b.texte)}</small>}</li>)}</ul></div>
      ))}
    </div>
  </section>

  <section class="bloc" aria-labelledby="pitch-pour-qui">
    <p class="legende">{t.libelles.pourQui}</p>
    <ul class="grille-quatre" id="pitch-pour-qui">{t.pourQui.map((b) => <li><h3>{b.titre}</h3><p>{b.texte}</p></li>)}</ul>
  </section>

  <section class="bloc" aria-labelledby="pitch-etapes">
    <p class="legende">{t.libelles.etapes}</p>
    <ol class="etapes" id="pitch-etapes">{t.etapes.map((b, i) => <li><span>{String(i + 1).padStart(2, '0')}</span><div><h3>{b.titre}</h3><p>{b.texte}</p></div></li>)}</ol>
    <div class="limites"><h2>{t.libelles.limites}</h2><ul>{t.limites.map((l) => <li>{l}</li>)}</ul></div>
  </section>

  <section class="film">
    <p class="legende">{t.film.eyebrow}</p>
    <h2>{t.film.titre}</h2>
    <video controls playsinline preload="metadata" poster="/peak-pitch/pitch-hero-poster.jpg" aria-label={t.film.aria}><source src="/peak-pitch/pitch-hero-hd.mp4" type="video/mp4" /></video>
  </section>


  <section class="bloc" aria-labelledby="pitch-faq">
    <p class="legende">{t.libelles.faq}</p>
    <h2 id="pitch-faq">{t.libelles.faqTitre}</h2>
    <div class="faq">{t.faq.map((q) => <details><summary>{q.q}<span aria-hidden="true">+</span></summary><p>{q.r}</p>{conditionsPrix(q.r) && <small>{conditionsPrix(q.r)}</small>}</details>)}</div>
  </section>

  {guides.length > 0 && (
    <section class="bloc" aria-labelledby="pitch-guides">
      <p class="legende">{t.libelles.guides}</p>
      <ul class="guides" id="pitch-guides">{guides.map((a) => <li><a href={L(`/actualites/${a.slug}`)}><h3>{a.title} <span aria-hidden="true">↗</span></h3><p>{a.description}</p></a></li>)}</ul>
    </section>
  )}
</div>
