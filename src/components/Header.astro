---
interface Props { heros?: boolean }
const { heros = false } = Astro.props;
const liens = [
  { href: '/#expertises', libelle: 'Expertises' },
  { href: '/#methode', libelle: 'Notre méthode' },
  { href: '/#simulateur', libelle: 'Simulateur' },
  { href: '/#equipe', libelle: 'Le cabinet' },
  { href: '/actualites', libelle: 'Analyses' },
];
---

<header data-entete class:list={['entete sticky top-0 z-40 text-etoile', { 'sur-heros': heros }]}>
  <div class="contenu flex h-[76px] items-center justify-between gap-5">
    <a href="/" aria-label="PEAK FUNDING, accueil" class="shrink-0">
      <img src="/img/logo-peak-funding-ivoire.svg" alt="PEAK FUNDING" width="180" height="33" class="h-7 w-auto sm:h-[30px]" />
    </a>
    <nav aria-label="Navigation principale" class="hidden xl:block">
      <ul class="flex items-center gap-6">
        {liens.map(l => <li><a href={l.href} aria-current={l.href === '/actualites' && Astro.url.pathname.startsWith('/actualites') ? 'page' : undefined} class="nav-lien text-[13px] text-etoile/85 hover:text-etoile">{l.libelle}</a></li>)}
      </ul>
    </nav>
    <div class="flex items-center gap-3">
      <details data-espaces class="relative hidden xl:block">
        <summary class="espaces-trigger flex min-h-11 cursor-pointer list-none items-center gap-3 rounded-pill border border-etoile/20 px-4 text-[13px] text-etoile/85 hover:text-etoile">Vos espaces <svg viewBox="0 0 16 16" width="14" height="14" fill="none" stroke="currentColor" aria-hidden="true"><path d="m4 6 4 4 4-4" /></svg></summary>
        <nav aria-label="Vos espaces" class="espaces-panneau absolute top-14 right-0 w-[340px] overflow-hidden rounded-carte border border-filet bg-ardoise p-3">
          <p class="px-3 pt-2 pb-4 font-mono text-[10px] uppercase tracking-[.12em] text-argent">Vos accès PEAK FUNDING</p>
          <a href="/espace-client" data-astro-reload class="espace-lien">
            <span class="espace-icone" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.25"><circle cx="12" cy="8" r="3.5" /><path d="M5 21v-3a7 7 0 0 1 14 0v3" /></svg></span>
            <span><strong>Espace client</strong><small>Votre dossier, vos documents.</small></span><span class="espace-fleche" aria-hidden="true">↗</span>
          </a>
          <a href="/espace-mandataire" class="espace-lien">
            <span class="espace-icone" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.25"><rect x="3" y="7" width="18" height="14" rx="2" /><path d="M8 7V3h8v4M3 13h18M10 13v3h4v-3" /></svg></span>
            <span><strong>Espace mandataire</strong><small>Votre activité, vos financements.</small></span><span class="espace-fleche" aria-hidden="true">↗</span>
          </a>
          <p class="mt-3 border-t border-filet px-3 pt-3 pb-1 text-[11px] text-argent">Des espaces dédiés, connectés à Actelo.</p>
        </nav>
      </details>
      <a href="/#rdv" class="btn-cuivre hidden h-10 gap-3 px-5 text-[13px] sm:inline-flex">Parlons de votre projet <span aria-hidden="true">↗</span></a>
      <details data-menu class="relative xl:hidden">
        <summary class="flex h-11 w-11 cursor-pointer list-none items-center justify-center rounded-pill border border-etoile/30" aria-label="Menu de navigation">
          <svg viewBox="0 0 20 20" class="h-5 w-5" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" aria-hidden="true"><path d="M3 6h14M3 13h14"/></svg>
        </summary>
        <nav aria-label="Navigation mobile" class="menu-mobile absolute top-14 right-0 w-[min(320px,calc(100vw-40px))] rounded-donnee border border-filet bg-ardoise p-3">
          <ul>
            {liens.map(l => <li><a href={l.href} class="block rounded-donnee px-4 py-3 text-[16px] hover:bg-graphite">{l.libelle}</a></li>)}
            <li class="mt-2 border-t border-filet pt-2"><a href="/espace-client" data-astro-reload class="block rounded-donnee px-4 py-3 text-[15px] hover:bg-graphite">Espace client</a></li>
            <li><a href="/espace-mandataire" class="block rounded-donnee px-4 py-3 text-[15px] hover:bg-graphite">Espace mandataire</a></li>
            <li><a href="/#rdv" class="btn-cuivre mt-2 w-full">Parlons de votre projet ↗</a></li>
          </ul>
        </nav>
      </details>
    </div>
  </div>
  <div data-page-progress class="pointer-events-none absolute inset-x-0 bottom-0 h-px origin-left bg-cuivre-clair" style="transform:scaleX(0)" aria-hidden="true"></div>
</header>

<style>
  .entete { background: rgba(11,13,18,.94); backdrop-filter: blur(16px); border-bottom: 1px solid var(--color-filet); transition: background .25s, border-color .25s; }
  .entete.sur-heros:not(.givre) { background: rgba(11,13,18,.12); border-bottom-color: rgba(237,234,228,.16); }
  .nav-lien { position: relative; padding-block: 12px; }
  .nav-lien::after { content: ''; position: absolute; bottom: 4px; left: 0; right: 0; height: 1px; background: var(--color-cuivre-clair); transform: scaleX(0); transform-origin: left; transition: transform .2s; }
  .nav-lien:hover::after, .nav-lien[aria-current]::after { transform: scaleX(1); }
  .menu-mobile { max-height: calc(100dvh - 100px); overflow-y: auto; }
  summary::-webkit-details-marker { display: none; }
  .espaces-trigger { transition:background .18s, border-color .18s; }
  .espaces-trigger svg { transition:transform .18s; }
  [data-espaces][open] .espaces-trigger { border-color:var(--color-cuivre); background:var(--color-ardoise); }
  [data-espaces][open] .espaces-trigger svg { transform:rotate(180deg); }
  [data-espaces][open] .espaces-panneau { animation:espaces-entree .2s ease-out; transform-origin:top right; }
  .espace-lien { display:grid; grid-template-columns:40px 1fr 16px; align-items:center; gap:12px; padding:16px 10px; border-radius:8px; transition:background .15s; }
  .espace-lien:hover, .espace-lien:focus-visible { background:var(--color-graphite); }
  .espace-lien strong { display:block; font-size:14px; font-weight:500; }
  .espace-lien small { display:block; margin-top:4px; font-size:11px; color:var(--color-argent); }
  .espace-icone { display:grid; place-items:center; width:40px; height:44px; border:1px solid var(--color-filet); border-radius:8px; color:var(--color-cuivre-clair); }
  .espace-icone svg { width:22px; height:22px; }
  .espace-fleche { color:var(--color-cuivre-clair); }
  @keyframes espaces-entree { from { opacity:0; transform:translateY(-6px); } to { opacity:1; transform:translateY(0); } }
</style>
