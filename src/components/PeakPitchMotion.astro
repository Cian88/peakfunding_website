---
/* Prototype : couverture de l'accueil avec une animation native (HTML/CSS) de PEAK PITCH.
   Activée par PUBLIC_PEAK_PITCH_HERO=motion. Le film PEAK PITCH reste disponible avec la valeur true.
   L'état de base du CSS est l'image finale : sans animation, mouvement réduit ou ?statique, on voit
   directement les trois livrables. Les montants sont un exemple illustratif cohérent :
   285 000 + 20 000 + 24 000 = 329 000 € ; 329 000 − 45 000 = 284 000 € ; 25 ans à 3,5 % → 1 422 €/mois ;
   revenus 4 300 € + loyer 1 050 € × 70 % = 5 035 € → effort 28,2 % ; capacité 35 % → 350 000 €. */
import { localiser } from '../i18n';
import { ASSURANCE_URL } from '../data/integrations';
interface Props { lang?: 'fr' | 'en' }
const { lang = 'fr' } = Astro.props;
const fr = lang === 'fr';
const L = (p: string) => localiser(p, lang);
type Piece = [string, string];
type Intervenant = { sigle: string; nom: string; role: string; pieces: Piece[] };
const t = fr ? {
  eyebrow: 'Courtier indépendant · France entière',
  h1: 'Cabinet de courtage en financement et assurance emprunteur.',
  texte: 'Investissement locatif, SCI, reprise d’entreprise, opérations de marchands de biens : PEAK FUNDING structure et négocie votre financement, partout en France.',
  cta1: 'Estimer ma capacité', cta2: 'Le cabinet & ses expertises',
  scene: 'PEAK PITCH · DOSSIER DE FINANCEMENT', exemple: 'EXEMPLE ILLUSTRATIF', etape: 'ÉTAPE',
  questionnaire: 'Questionnaire guidé',
  reponses: [['Projet', 'Investissement locatif · T3'], ['Emprunteurs', '2 · salariés en CDI'], ['Revenus nets mensuels', '4 300 €'], ['Loyer attendu', '1 050 € / mois'], ['Apport personnel', '45 000 €'], ['Structure', 'SCI à créer']],
  chiffresTitre: 'Vos chiffres, rapprochés',
  phases: ['Questionnaire', 'Rapprochement', 'Livrables', 'Contrôle'],
  qTitre: 'Votre projet', continuer: 'Continuer',
  coherence: 'Contrôles de cohérence',
