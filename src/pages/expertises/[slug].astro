---
import Base from '../../layouts/Base.astro';
import ExpertiseCorps from '../../components/pages/ExpertiseCorps.astro';
import { expertises } from '../../data/expertises';

export function getStaticPaths() {
  return expertises.map((e) => ({ params: { slug: e.slug }, props: { e } }));
}
const { e } = Astro.props;
---

<Base title={`${e.nom} — ${e.titre} | PEAK FUNDING`} description={e.intro}>
  <ExpertiseCorps e={e} />
</Base>
