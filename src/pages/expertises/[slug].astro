---
import Base from '../../layouts/Base.astro';
import Pictogramme from '../../components/Pictogramme.astro';
import { expertises } from '../../data/expertises';
import { faqExpertises } from '../../data/textes';
import { ASSURANCE_URL } from '../../data/integrations';

export function getStaticPaths() {
  return expertises.map((e) => ({ params: { slug: e.slug }, props: { e } }));
}
const { e } = Astro.props;
const faq = faqExpertises[e.slug];
---

<Base title={`${e.nom} — ${e.titre} | PEAK FUNDING`} description={e.intro}>
  <!-- Expertise : lecture précise, paysage de contexte et accès direct au projet. -->
  <section class="contenu section grid gap-12 lg:grid-cols-[1.1fr_0.9fr] lg:items-center">
    <div>
      <nav aria-label="Fil d’Ariane" class="eyebrow normal-case tracking-normal"><a href="/" class="hover:text-encre">Accueil</a> <span aria-hidden="true">/</span> <a href="/#expertises" class="hover:text-encre">Expertises</a> <span aria-hidden="true">/</span> {e.nom}</nav>
      <p class="eyebrow mt-8">{e.nom}</p>
      <h1 class="display mt-4 lg:text-[58px]">{e.titre}</h1>
      <p class="corps mt-6 max-w-xl text-[18px]">{e.intro}</p>
      <div class="mt-8 flex flex-wrap gap-3">
        <a href={e.slug === 'insure' ? ASSURANCE_URL : '/#rdv'} data-assurance={e.slug === 'insure' || undefined} target={e.slug === 'insure' ? '_blank' : undefined} rel={e.slug === 'insure' ? 'noopener' : undefined} class="btn-cuivre">{e.ctaPrincipal}{e.slug === 'insure' && <span class="sr-only"> (nouvel onglet)</span>}</a>
        <a href={e.ctaSecondaire.href} class="btn-fantome">{e.ctaSecondaire.libelle}</a>
      </div>
    </div>
    <div class="reveal relative aspect-[4/3] overflow-hidden rounded-carte bg-trait">
      <img src={`/img/ambiance-${e.slug}.webp`} alt="" fetchpriority="high" class="h-full w-full object-cover" />
      <Pictogramme nom={e.slug} class="trace absolute bottom-6 left-6 h-14 w-14 text-etoile" />
    </div>
  </section>

  {e.pourQui && (
    <section class="border-t border-trait">
      <div class="contenu section reveal">
        <p class="eyebrow">Pour qui</p>
        <h2 class="titre mt-3 max-w-2xl">{e.pourQui.titre}</h2>
        <ul class="reveal-groupe mt-10 grid gap-8 md:grid-cols-3">
          {e.pourQui.cibles.map((c, i) => (<li class="border-t border-trait pt-6"><span class="donnee text-[12px] text-cuivre-profond">0{i + 1}</span><h3 class="sous-titre mt-5">{c.titre}</h3><p class="corps mt-3 text-[15px]">{c.texte}</p></li>))}
        </ul>
      </div>
    </section>
  )}

  {e.reperes && (
    <section class="border-t border-trait">
      <ul class="contenu grid gap-8 py-14 md:grid-cols-3">
        {e.reperes.map((r) => (<li><p class="donnee text-[32px] leading-none font-medium">{r.valeur}</p><p class="corps mt-3 text-[15px]">{r.texte}</p></li>))}
      </ul>
    </section>
  )}

  <section class="sombre border-t border-filet">
    <div class="grille"></div>
    <div class="contenu section-sombre relative grid gap-12 lg:grid-cols-[0.8fr_1.2fr] lg:gap-16">
      <div class="reveal lg:sticky lg:top-28 lg:self-start"><p class="eyebrow">Concrètement</p><h2 class="titre mt-4">La précision fait<br />la différence.</h2><p class="corps mt-6 text-[17px]">{e.concretement.intro}</p></div>
      <ol class="reveal-groupe grid gap-4 sm:grid-cols-2">
        {e.concretement.points.map((p, i) => (
          <li class="carte-donnee"><p class="donnee text-[13px] text-cuivre-clair">0{i + 1}</p><h3 class="mt-5 text-[18px] font-medium leading-snug">{p.titre}</h3><p class="corps mt-3 text-[15px]">{p.texte}</p></li>
        ))}
      </ol>
    </div>
  </section>

  <section class="border-t border-trait bg-blanc">
    <div class="contenu section">
      <p class="eyebrow">Comment ça se passe</p>
      <h2 class="titre mt-3 max-w-2xl">{e.comment.titre}</h2>
      <ol class="reveal-groupe mt-10 grid gap-6 md:grid-cols-2 lg:grid-cols-4">
        {e.comment.etapes.map((s, i) => (
          <li class="border-t border-trait pt-5"><p class="donnee text-[13px] text-gris">Étape {i + 1}</p><h3 class="mt-2 text-[18px] font-medium">{s.titre}</h3><p class="corps mt-2 text-[15px]">{s.texte}</p></li>
        ))}
      </ol>
    </div>
  </section>

  <section class="border-t border-trait">
    <div class="contenu section grid gap-10 lg:grid-cols-[0.8fr_1.2fr]">
      <div><p class="eyebrow">Questions fréquentes</p><h2 class="titre mt-3">Ce qu’on nous demande souvent.</h2></div>
      <div class="divide-y divide-trait border-y border-trait">
        {faq.map((q) => (
          <details class="group py-5">
            <summary class="flex cursor-pointer list-none items-center justify-between gap-6 text-[18px] font-medium">{q.q}<span class="donnee text-gris transition-transform group-open:rotate-45" aria-hidden="true">+</span></summary>
            <p class="corps mt-3 max-w-2xl">{q.r}</p>
          </details>
        ))}
      </div>
    </div>
  </section>

  <section class="contenu pb-20">
    <div class="sombre reveal rounded-donnee border border-filet px-7 py-14 lg:px-14 text-center">
      <h2 class="titre">{e.final.titre}</h2>
      <p class="corps mx-auto mt-4 max-w-lg text-[17px]">{e.final.texte}</p>
      <div class="mt-8 flex flex-wrap justify-center gap-3">
        <a href={e.slug === 'insure' ? ASSURANCE_URL : '/#rdv'} data-assurance={e.slug === 'insure' || undefined} target={e.slug === 'insure' ? '_blank' : undefined} rel={e.slug === 'insure' ? 'noopener' : undefined} class="btn-cuivre">{e.final.bouton}{e.slug === 'insure' && <span class="sr-only"> (nouvel onglet)</span>}</a>
        <a href={e.slug === 'insure' ? '/#rdv' : '/#simulateur'} class="btn-fantome">{e.slug === 'insure' ? 'Échanger avec le cabinet' : 'Estimer ma capacité'}</a>
      </div>
    </div>
  </section>
</Base>
