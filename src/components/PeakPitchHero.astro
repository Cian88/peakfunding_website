---
import { localiser } from '../i18n';
import { ASSURANCE_URL } from '../data/integrations';
interface Props { lang?: 'fr' | 'en' }
const { lang = 'fr' } = Astro.props;
const fr = lang === 'fr';
const destination = localiser('/peak-pitch/', lang);
---

<section class="heros sombre pitch-cinema" data-pitch-cinema aria-labelledby="pitch-accueil-titre">
  <h1 id="pitch-accueil-titre" class="sr-only">{fr ? 'PEAK PITCH — Votre projet, prêt à présenter.' : 'PEAK PITCH — Your project, ready to present.'}</h1>
  <p class="sr-only">{fr ? 'Préparez votre dossier bancaire : note de synthèse et annexe exhaustive, liste des documents par personne et société, présentation bancaire. 99 €, TVA non applicable. Le financement reste soumis à l’accord des banques.' : 'Prepare your banking dossier: summary and comprehensive appendix, document lists for each person and company, and a banking presentation. €99, VAT not applicable. Financing remains subject to approval by the banks. The film is in French.'}</p>

  <div class="pitch-cinema-stage">
    <a class="pitch-cinema-screen" data-pitch-discover href={destination} aria-label={fr ? 'Découvrir PEAK PITCH — 99 €, TVA non applicable' : 'Discover PEAK PITCH — €99, VAT not applicable'}>
      <video data-pitch-cinema-film muted playsinline preload="auto" poster="/peak-pitch/peak-pitch-affiche-4k.jpg" aria-hidden="true" tabindex="-1">
        <source src="/peak-pitch/peak-pitch-publicite-4k-60fps.mp4" type="video/mp4" />
      </video>
      <span class="pitch-cinema-mobile-copy" aria-hidden="true">
        <span class="pitch-cinema-kicker">PEAK FUNDING / PEAK PITCH</span>
        <span class="pitch-cinema-mobile-title">{fr ? 'Votre projet, prêt à présenter.' : 'Your project, ready to present.'}</span>
        <span class="pitch-cinema-mobile-price">99 € <small>{fr ? 'TVA non applicable · Paiement unique' : 'VAT not applicable · One payment'}</small></span>
      </span>
      <span class="pitch-cinema-cta"><span>{fr ? 'Découvrir PEAK PITCH' : 'Discover PEAK PITCH'}</span><svg viewBox="0 0 28 28" fill="none" aria-hidden="true"><path d="M5 23 23 5M5 5h18v18" stroke="currentColor" stroke-width="1.4" /></svg></span>
    </a>
  </div>

  <div class="pitch-cinema-footer">
    <p>{fr ? 'Courtier indépendant · France entière' : 'Independent broker · Throughout France'}<span>ORIAS n° 24002546 · {fr ? 'Supervision ACPR' : 'ACPR supervision'}</span></p>
    <nav aria-label={fr ? 'Poursuivre sur le site' : 'Continue on the website'}>
      <a href="#rdv">{fr ? 'Parlons de votre projet' : 'Talk about your project'} ↗</a>
      <a href="#simulateur">{fr ? 'Simulateur' : 'Simulator'} ↗</a>
      <a href={ASSURANCE_URL} data-assurance target="_blank" rel="noopener">{fr ? 'Assurance emprunteur' : 'Borrower insurance'} ↗</a>
      <a href="#expertises">{fr ? 'Le cabinet & ses expertises' : 'Our firm & expertise'} ↓</a>
    </nav>
  </div>
</section>

<script>
  // Cycle de vie autonome : aucun changement dans le contrôleur de navigation du site.
  let disposeCinema: (() => void) | undefined;
  function initialiseCinema() {
    disposeCinema?.();
    const root = document.querySelector<HTMLElement>('[data-pitch-cinema]');
    const video = root?.querySelector<HTMLVideoElement>('[data-pitch-cinema-film]');
    if (!root || !video) return;
    const controller = new AbortController();
    const { signal } = controller;
    const preference = matchMedia('(prefers-reduced-motion: reduce)');
    const staticMode = new URLSearchParams(location.search).has('statique');
    const menus = [...document.querySelectorAll<HTMLDetailsElement>('header [data-menu], header [data-espaces]')];
    let finished = false;
    let failed = false;
    let visible = true;
    video.muted = true;
    // Mesure locale de lecture pour le contrôle des exports, sans télémétrie réseau.
    const measurePlayback = () => {
      const quality = video.getVideoPlaybackQuality?.();
      if (quality) {
        video.dataset.decodedFrames = String(quality.totalVideoFrames);
        video.dataset.droppedFrames = String(quality.droppedVideoFrames);
      }
    };
    const synchronize = () => {
      const shouldPause = finished || failed || preference.matches || staticMode || !visible || document.hidden || menus.some(menu => menu.open) || !!document.querySelector('dialog[open]');
      if (shouldPause) video.pause();
      else video.play().catch(() => {});
    };
    preference.addEventListener('change', synchronize, { signal });
    document.addEventListener('visibilitychange', synchronize, { signal });
    menus.forEach(menu => menu.addEventListener('toggle', synchronize, { signal }));
    // Sans boucle : conserver la dernière image, y compris après un menu ou un retour au héros.
    video.addEventListener('timeupdate', measurePlayback, { signal });
    video.addEventListener('ended', () => { finished = true; video.pause(); measurePlayback(); }, { signal });
    video.addEventListener('error', () => { failed = true; synchronize(); }, { signal });
    const observer = new IntersectionObserver(entries => {
      visible = entries.some(entry => entry.isIntersecting);
      synchronize();
    }, { threshold: 0 });
    observer.observe(root);
    // Observe seulement l'ouverture des fenêtres ; ne touche ni au menu ni à la modale de RDV.
    const modalObserver = new MutationObserver(synchronize);
    modalObserver.observe(document.body, { subtree: true, attributes: true, attributeFilter: ['open'] });
    disposeCinema = () => { controller.abort(); observer.disconnect(); modalObserver.disconnect(); video.pause(); };
    synchronize();
  }
  document.addEventListener('astro:page-load', initialiseCinema);
  document.addEventListener('astro:before-swap', () => { disposeCinema?.(); disposeCinema = undefined; });
</script>

<style>
  .pitch-cinema{position:relative;display:flex;flex-direction:column;justify-content:center;min-height:100svh;margin-top:-76px;padding-top:76px;background:#0b0d12;color:#edeae4;isolation:isolate}
  .pitch-cinema-stage{position:relative;display:flex;align-items:center;justify-content:center;min-width:0;width:100%}
  .pitch-cinema-screen{display:block;position:relative;width:100%;aspect-ratio:16/9;color:#0b0d12;outline-offset:-3px}
  .pitch-cinema-screen video{display:block;width:100%;height:100%;object-fit:contain;pointer-events:none}
  /* Un vrai lien recouvre exactement le bouton filmé, quelle que soit la taille de l'écran. */
  .pitch-cinema-cta{position:absolute;left:5%;top:72.407407%;width:28.854167%;height:7.222222%;display:flex;align-items:center;justify-content:space-between;gap:12px;padding:0 1.7%;border-radius:999px;background:#d9a47c;color:#0b0d12;font-size:clamp(10px,1.12vw,22px);font-weight:500;line-height:1;text-transform:uppercase;white-space:nowrap;transition:background .18s}
  .pitch-cinema-cta svg{flex:0 0 auto;width:7%;height:auto;max-width:30px}
  .pitch-cinema-screen:hover .pitch-cinema-cta{background:#e7b890}
  .pitch-cinema-screen:focus-visible{outline:none}
  .pitch-cinema-screen:focus-visible .pitch-cinema-cta{outline:3px solid #edeae4;outline-offset:4px}
  .pitch-cinema-footer{display:flex;align-items:center;justify-content:space-between;gap:18px;min-height:68px;margin:0 clamp(20px,4vw,76px);border-top:1px solid #2a2f3a;font-size:11px;color:#a6a9b3}
  .pitch-cinema-footer p{margin:0;line-height:1.6}
  .pitch-cinema-footer p span{display:block;font-size:10px}
  .pitch-cinema-footer nav{display:flex;gap:24px;flex-wrap:wrap}
  .pitch-cinema-footer a{display:inline-flex;align-items:center;min-height:44px;color:#edeae4;border-bottom:1px solid transparent;transition:color .18s,border-color .18s}
  .pitch-cinema-footer a:hover{color:#d9a47c;border-bottom-color:#d9a47c}
  .pitch-cinema-mobile-copy{display:none}
  @media(max-width:767px){
    .pitch-cinema{justify-content:flex-start}
    .pitch-cinema-stage{flex:1;align-items:center;padding-top:48px}
    .pitch-cinema-screen{width:100%;aspect-ratio:auto}
    .pitch-cinema-screen video{height:auto;aspect-ratio:16/9}
    .pitch-cinema-mobile-copy{display:flex;flex-direction:column;gap:16px;padding:24px 24px 20px;color:#edeae4}
    .pitch-cinema-kicker{font:10px var(--font-mono);letter-spacing:.07em;color:#d9a47c}
    .pitch-cinema-mobile-title{font-size:clamp(30px,8vw,42px);font-weight:300;line-height:1.08;letter-spacing:-.035em;max-width:380px}
    .pitch-cinema-mobile-price{display:flex;align-items:center;gap:16px;font:32px var(--font-sans);font-weight:300;color:#d9a47c}
    .pitch-cinema-mobile-price small{max-width:170px;font:11px/1.6 var(--font-sans);color:#a6a9b3}
    .pitch-cinema-cta{position:static;width:auto;height:52px;margin:0 24px 30px;padding:0 24px;font-size:14px;gap:18px}
    .pitch-cinema-cta svg{width:23px}
    .pitch-cinema-footer{display:block;margin:0 24px;padding:16px 0 18px;font-size:11px}
    .pitch-cinema-footer nav{gap:2px 22px;margin-top:8px}
    .pitch-cinema-footer a{min-height:36px}
  }
  @media(prefers-reduced-motion:reduce){.pitch-cinema-cta,.pitch-cinema-footer a{transition:none}}
</style>
