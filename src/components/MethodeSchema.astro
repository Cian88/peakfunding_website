---
interface Props { etape: number }
const { etape } = Astro.props;
const legendes = ['Une lecture globale de votre situation', 'Les pièces d’un dossier cohérent', 'Votre dossier, plusieurs interlocuteurs bancaires', 'Un accompagnement jusqu’aux fonds disponibles'];
---
<figure class="methode-schema">
  <svg viewBox="0 0 400 170" fill="none" aria-hidden="true">
    {etape === 0 && <>
      <path class="liaison" d="M100 38 200 85 300 38M100 132 200 85 300 132" />
      <circle cx="200" cy="85" r="33" class="noeud" /><circle cx="200" cy="85" r="45" class="orbite" />
      <text x="200" y="90" class="accent">VOTRE PROJET</text>
      {[['Revenus',65,38],['Patrimoine',335,38],['Fiscalité',65,132],['Objectifs',335,132]].map(([label,x,y]) => <g><rect x={Number(x)-60} y={Number(y)-17} width="120" height="34" rx="5" class="noeud" /><text x={x} y={Number(y)+4}>{label}</text></g>)}
    </>}
    {etape === 1 && <>
      <path class="liaison" d="M90 65v55h220V65M200 65v75" />
      {['Durée', 'Apport', 'Structure'].map((label,i)=><g><rect x={20+i*130} y="22" width="100" height="56" rx="5" class="noeud" /><path d={`M${37+i*130} 38h24`} class="trait-cuivre" /><text x={70+i*130} y="62">{label}</text></g>)}
      <rect x="135" y="109" width="130" height="42" rx="5" class="noeud actif" /><text x="200" y="135" class="accent">DOSSIER STRUCTURÉ</text>
    </>}
    {etape === 2 && <>
      <path class="liaison" d="M106 85h50V30h42M156 85h42M156 85v55h42M270 30h30v110h-30M300 85h72" />
      <rect x="12" y="61" width="94" height="48" rx="5" class="noeud" /><text x="59" y="89">Votre dossier</text>
      {[30,85,140].map(y=><g><rect x="198" y={y-18} width="72" height="36" rx="5" class="noeud" /><text x="234" y={y+4}>Banque</text></g>)}
      <circle cx="360" cy="85" r="19" class="noeud actif" /><path d="m352 85 5 5 11-11" class="trait-cuivre" />
    </>}
    {etape === 3 && <>
      <path d="M42 73h316" class="liaison" /><path d="M42 73h316" class="trait-cuivre parcours" />
      {['Offre', 'Signature', 'Notaire', 'Fonds'].map((label,i)=><g><circle cx={42+i*105} cy="73" r="18" class="noeud" /><path d={`m${35+i*105} 73 5 5 9-10`} class="trait-cuivre" /><text x={42+i*105} y="119">{label}</text></g>)}
    </>}
  </svg>
  <figcaption>{legendes[etape]}</figcaption>
</figure>
<style>
  .methode-schema { padding: 16px 0 12px; border-block: 1px solid var(--color-filet); }
  svg { display:block; width:100%; height:auto; }
  .liaison { stroke:#59616f; stroke-width:1; }
  .noeud { fill:var(--color-abime); stroke:#454c59; stroke-width:1; }
  .actif, .trait-cuivre { stroke:var(--color-cuivre-clair); stroke-width:1.5; }
  .orbite { stroke:var(--color-cuivre); stroke-opacity:.35; stroke-dasharray:2 6; }
  text { fill:var(--color-argent); font-family:var(--font-mono); font-size:11px; text-anchor:middle; }
  text.accent { fill:var(--color-cuivre-clair); font-size:9px; }
  figcaption { margin-top:10px; color:var(--color-argent); font-size:12px; }
  .parcours { stroke-dasharray:316; stroke-dashoffset:316; transition:stroke-dashoffset .6s ease; }
  :global(.etape.active) .parcours { stroke-dashoffset:0; }
  @media (prefers-reduced-motion:reduce) { .parcours { stroke-dashoffset:0; transition:none; } }
</style>
