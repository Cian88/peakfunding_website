              </div>
            </div>
            <footer class="pp-pied-doc"><span>{t.doc.prepare}</span><span>{t.doc.page(1, 6)}</span></footer>
          </div>

          <!-- Clôture : tampon apposé sur le dossier -->
          <div class="pp-tampon">
            <svg viewBox="0 0 100 100">
              <defs>
                <path id="pp-cercle" d="M50 50m-37 0a37 37 0 1 1 74 0a37 37 0 1 1-74 0" />
                <filter id="pp-encre"><feTurbulence type="fractalNoise" baseFrequency=".9" numOctaves="2" seed="4" /><feDisplacementMap in="SourceGraphic" scale="1.1" /></filter>
              </defs>
              <g filter="url(#pp-encre)">
                <circle cx="50" cy="50" r="47" /><circle class="fin" cx="50" cy="50" r="44.5" /><circle cx="50" cy="50" r="28" />
