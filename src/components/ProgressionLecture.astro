---
import {langCourante} from '../i18n';
const en=langCourante(Astro.currentLocale)==='en';
---
<div data-reading-progress class="lecture-signet" hidden>
  <span data-reading-trace class="signet-curseur" aria-hidden="true"><i></i><span data-reading-section class="signet-rubrique">{en?'Reading':'Lecture'}</span></span>
  <input data-reading-position type="range" min="0" max="1000" step="1" value="0" aria-label={en ? 'Scroll through the page' : 'Parcourir la page'} aria-orientation="vertical" title={en ? 'Drag to move through the page' : 'Glisser pour parcourir la page'} />
</div>
<style>
  :global(html.lecture-personnalisee){scrollbar-width:none}
  :global(html.lecture-personnalisee::-webkit-scrollbar){display:none}
  .lecture-signet{position:fixed;z-index:35;right:0;top:97px;bottom:20px;width:14px}
  .lecture-signet[hidden]{display:none}
  .signet-curseur{position:absolute;top:0;right:0;width:14px;height:44px;pointer-events:none;will-change:transform}
  .signet-curseur i{display:block;margin-left:auto;width:7px;height:44px;background:#d9a47c;clip-path:polygon(0 0,100% 0,100% 100%,50% 88%,0 100%)}
  .signet-rubrique{position:absolute;top:50%;right:24px;transform:translateY(-50%);max-width:240px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;padding:8px 12px;border-left:1px solid #b87b4f;background:#0b0d12;color:#edeae4;font:12px/1.5 var(--font-sans);opacity:0}
  .lecture-signet:hover .signet-rubrique,.lecture-signet:focus-within .signet-rubrique{opacity:1}
  .lecture-signet:focus-within i{background:#edeae4;border-left:2px solid #b87b4f}
  .lecture-signet input{position:absolute;inset:0;width:100%;height:100%;margin:0;opacity:0;appearance:none;cursor:ns-resize;writing-mode:vertical-lr;direction:ltr;touch-action:none}
  .lecture-signet input::-webkit-slider-thumb{appearance:none;width:14px;height:44px}
  .lecture-signet input::-moz-range-thumb{width:14px;height:44px;border:0}
  @media(pointer:coarse){.lecture-signet{width:4px;pointer-events:none}.signet-curseur,.signet-curseur i{width:4px;height:28px}.lecture-signet input,.signet-rubrique{display:none}}
  @media(max-height:350px){.lecture-signet{top:87px;bottom:10px}}
  @media(forced-colors:active){
    :global(html.lecture-personnalisee){scrollbar-width:auto}
    :global(html.lecture-personnalisee::-webkit-scrollbar){display:revert}
    .lecture-signet{display:none}
  }
  @media print{.lecture-signet{display:none}}
</style>
