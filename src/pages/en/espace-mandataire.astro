---
import Base from '../../components/Feuillet.astro';
import { ACTELO_MANDATAIRE_URL } from '../../data/integrations';
---

<Base title="Partner portal | PEAK FUNDING" description="PEAK FUNDING partners: access your dedicated portal to manage your files and follow their progress.">
  <section class="cadre-page respiration">
    <nav aria-label="Breadcrumb" class="legende normal-case tracking-normal"><a href="/en/" class="hover:text-encre">Home</a> <span aria-hidden="true">/</span> Partner portal</nav>
    <div class="portail"><div>
      <p class="legende">Sign in to your portal</p>
      <h1 class="grand-titre mt-3">Partner portal</h1>
      <p class="paragraphe mt-5 text-[18px]">PEAK FUNDING partners: access your dedicated portal to manage your files and follow their progress.</p>
      </div><div class="mt-10 border filet bg-white p-7 sm:p-10">
        <p class="legende">Actelo platform</p>
        <h2 class="mt-4 text-[24px]">Sign in to your portal</h2>
        <p class="paragraphe mt-3">You will be redirected to the secure partner file-management platform.</p>
        <a href={ACTELO_MANDATAIRE_URL} target="_blank" rel="noopener" class="action-pleine mt-7">Go to the partner portal ↗</a>
        <p class="mt-4 text-[12px] teinte-secondaire">Opens in a new tab.</p>
      </div>
    </div>
  </section>
</Base>
