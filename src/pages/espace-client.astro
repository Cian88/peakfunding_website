---
import Base from '../layouts/Base.astro';
import { ACTELO_CLIENT_SCRIPT, ACTELO_CLIENT_URL } from '../data/integrations';
---

<!-- A document navigation isolates the vendor's global message listener, as in V1. -->
<Base clientRouting={false} title="Espace client | PEAK FUNDING" description="Accédez à votre dossier, transmettez vos pièces justificatives et suivez l’avancement de votre financement en toute sécurité.">
  <section class="espace-large pt-12 pb-8 lg:pt-16">
    <nav aria-label="Fil d’Ariane" class="eyebrow normal-case tracking-normal"><a href="/" class="hover:text-encre">Accueil</a> <span aria-hidden="true">/</span> Espace client</nav>
    <div class="mt-8 grid items-end gap-6 lg:grid-cols-[1.25fr_1fr]">
      <div><p class="eyebrow">Votre dossier en ligne</p><h1 class="display mt-4">Espace client</h1></div>
      <p class="corps max-w-lg text-[17px]">Accédez à votre dossier, transmettez vos pièces justificatives et suivez l’avancement de votre financement en toute sécurité.</p>
    </div>
  </section>
  <section class="espace-large pb-20" aria-label="Accès à votre espace Actelo">
    <div class="overflow-hidden rounded-donnee border border-trait bg-white p-2 sm:p-6">
      <p id="actelo-statut" role="status" class="px-4 py-6 text-[14px] text-gris">Chargement de votre espace Actelo…</p>
      <div id="actelo-espace-client" class="min-h-[600px]"></div>
    </div>
    <p class="mt-5 text-[13px] text-gris">Un problème d’affichage ? <a href={ACTELO_CLIENT_URL} target="_blank" rel="noopener" class="underline underline-offset-4 hover:text-encre">Ouvrir l’espace client dans un nouvel onglet ↗</a></p>
    <noscript><p class="mt-4 text-[14px]">L’espace intégré nécessite JavaScript. Vous pouvez utiliser le lien direct ci-dessus.</p></noscript>
  </section>
  <script is:inline data-actelo-script src={ACTELO_CLIENT_SCRIPT} async></script>
  <script>
    const container = document.getElementById('actelo-espace-client');
    const status = document.getElementById('actelo-statut');
    if (container && status) {
      const observer = new MutationObserver(prepareFrame);
      function prepareFrame() {
        const iframe = container!.querySelector('iframe');
        if (!iframe) return;
        iframe.title = 'Connexion à votre espace client Actelo PEAK FUNDING';
        iframe.style.minHeight = '600px';
        iframe.addEventListener('load', () => { status!.hidden = true; }, { once: true });
        observer.disconnect();
      }
      observer.observe(container, { childList: true });
      prepareFrame();
      window.setTimeout(() => {
        if (!status.hidden) status.textContent = 'Si votre espace ne s’affiche pas, utilisez le lien direct sous le cadre.';
      }, 12000);
    }
  </script>
</Base>

<style>
  .espace-large { width:100%; max-width:1840px; margin-inline:auto; padding-inline:clamp(20px, 4vw, 80px); }
</style>
