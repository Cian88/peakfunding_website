---
/* Dépôt d'un avis client, sur invitation (?jeton=…). Page non reliée à la navigation. */
import Base from '../../components/Feuillet.astro';
import DeposerAvis from '../../components/react/DeposerAvis';
import { depotTextes } from '../../components/react/textes-avis';
import { langCourante, localiser } from '../../i18n';
const lang = langCourante(Astro.currentLocale);
const T = depotTextes(lang);
const L = (p: string) => localiser(p, lang);
---

<Base noindex title={T.meta_titre} description={T.meta_desc}>
  <section class="cadre-page respiration">
    <nav aria-label="Fil d’Ariane" class="legende normal-case tracking-normal"><a href={L('/')} class="hover:text-encre">{T.fil_accueil}</a> <span aria-hidden="true">/</span> {T.fil_page}</nav>
    <div class="portail"><div>
      <p class="legende">{T.eyebrow}</p>
      <h1 class="grand-titre mt-3">{T.titre}</h1>
      <p class="paragraphe mt-5 max-w-xl text-[18px]">{T.intro}</p>
      </div><div class="fond-quadrille mt-10 border filet p-6 sm:p-8">
        <DeposerAvis client:only="react" lang={lang} accueilHref={L('/')} />
        <noscript><p class="paragraphe">JavaScript est nécessaire pour déposer un avis.</p></noscript>
      </div>
    </div>
  </section>
</Base>
