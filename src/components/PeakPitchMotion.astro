                  {t.note.chiffres.map(([q, r, src]) => <tr><td>{q}</td><td>{r}</td><td>{src.charAt(0) + src.slice(1).toLowerCase()}</td></tr>)}
                  <tr><td>{t.doc.capacite[0]}</td><td>{t.doc.capacite[1]}</td><td>{t.doc.capacite[2]}</td></tr>
                </tbody>
              </table>
              <p class="pp-h pp-el" style="--k:3">{t.doc.s3}</p>
              <div class="pp-el" style="--k:3">
                <table class="pp-tableau">
                  <thead><tr><th>{t.doc.emploi}</th><th>{t.doc.montant}</th></tr></thead>
                  <tbody>
                    {t.note.emplois.map(([l, v]) => <tr><td>{l}</td><td>{v}</td></tr>)}
                    <tr class="total"><td>{t.note.total[0]}</td><td>{t.note.total[1]}</td></tr>
                  </tbody>
                </table>
                <div class="pp-barre-financement"><i class="pret"></i><i class="apport"></i></div>
