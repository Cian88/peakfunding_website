# Chaque offre dispose de son propre interrupteur de vente.
PUBLIC_STANCER_READY=false
PUBLIC_PEAK_PITCH_ENABLED=false
PUBLIC_PEAK_PITCH_URL=
# Vidéo à l’accueil : false par défaut ; true uniquement dans le clone local préparé.
PUBLIC_PEAK_PITCH_HERO=false

# URL publique HTTPS du serveur PEAK EXCHANGE, sans slash final.
PUBLIC_PEAK_EXCHANGE_ENABLED=false
PUBLIC_PEAK_EXCHANGE_URL=

# Ebook vendu par PEAK FUNDING : Stancer, prix de 24,90 EUR fixé côté serveur.
PUBLIC_EBOOK_SALES_ENABLED=false
# URL HTTPS du serveur de paiement et de livraison privée (sans slash final).
PUBLIC_EBOOK_SERVICE_URL=

# Formulaire Formspree dédié aux demandes administratives, au format https://formspree.io/f/...
PUBLIC_ADMIN_CONTACT_FORM=
