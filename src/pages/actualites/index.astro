---
import Base from '../../layouts/Base.astro';
import VisuelArticle from '../../components/VisuelArticle.astro';
import articles from '../../data/articles.json';
import { cleTheme, dateArticle, dateISO, trierArticles } from '../../lib/editorial.mjs';

const liste = trierArticles(articles).map(a => ({
  slug: a.slug, titre: a.title, categorie: a.avant[1], lecture: a.avant[2],
  auteur: a.apres[0], date: dateArticle(a), iso: dateISO(dateArticle(a)),
  extrait: a.apres[2] || a.description,
}));
const categories = [...new Set(liste.map(a => a.categorie))];
const libelle = (c: string) => c.charAt(0) + c.slice(1).toLowerCase();
---

<Base title="Actualités & conseils | PEAK FUNDING" description="Taux, montages, fiscalité, actualité des banques : nos analyses pour y voir clair, sans jargon inutile.">
  <section class="contenu section filtres">
    <div class="grid items-end gap-8 border-b border-trait pb-10 lg:grid-cols-[1.4fr_1fr] lg:gap-20">
      <div><p class="eyebrow">Le regard du cabinet</p><h1 class="display mt-5 max-w-3xl lg:text-[56px]">Comprendre le crédit,<br />avant de signer.</h1></div>
      <p class="corps max-w-md text-[18px]">Taux, montages, fiscalité, actualité des banques : nos analyses pour y voir clair, sans jargon inutile.</p>
    </div>
    <fieldset class="mt-8 flex flex-wrap gap-2">
      <legend class="sr-only">Filtrer les articles par thème</legend>
      <label class="pastille"><input type="radio" name="theme" value="tout" checked class="sr-only" /><span>Toutes les analyses <small>{liste.length}</small></span></label>
      {categories.map(c => <label class="pastille"><input type="radio" name="theme" value={cleTheme(c)} class="sr-only" /><span>{libelle(c)}</span></label>)}
    </fieldset>
    <ul class="articles-grille mt-10 grid gap-6 md:grid-cols-2 lg:grid-cols-3">
      {liste.map((a, index) => <li class="article-carte min-w-0 overflow-hidden rounded-carte border border-trait bg-white" data-theme={cleTheme(a.categorie)}>
        <a href={`/actualites/${a.slug}`} class="group flex h-full flex-col">
          <div class="article-image relative h-[180px] shrink-0 overflow-hidden border-b border-trait">
            <VisuelArticle slug={a.slug} prioritaire={index < 3} carte />
          </div>
          <div class="article-texte flex flex-1 flex-col p-6">
            <p class="eyebrow leading-relaxed">{a.categorie} <span class="text-gris">· {a.lecture}</span></p>
            <h2 class="sous-titre mt-3 group-hover:underline underline-offset-4">{a.titre}</h2>
            <p class="corps mt-4 text-[15px]">{a.extrait}</p>
            <div class="mt-auto flex items-end justify-between gap-4 pt-7"><p class="text-[12px] leading-relaxed text-gris">{a.auteur}<br /><time datetime={a.iso} class="font-mono">{a.date}</time></p><span class="flex h-10 w-10 shrink-0 items-center justify-center rounded-full border border-trait text-encre transition-colors group-hover:border-cuivre-profond group-hover:bg-cuivre-profond group-hover:text-white" aria-hidden="true">↗</span></div>
          </div>
        </a>
      </li>)}
    </ul>
  </section>
  <section class="sombre border-b border-filet py-14"><div class="contenu flex flex-wrap items-center justify-between gap-7"><div><p class="eyebrow">De la lecture à votre projet</p><h2 class="titre mt-4">Et pour votre financement ?</h2></div><a href="/#rdv" class="btn-cuivre">Échanger avec le cabinet ↗</a></div></section>
</Base>

<style>
  .pastille span { display: inline-flex; align-items: center; gap: 12px; min-height: 44px; padding: 10px 17px; border-radius: 40px; border: 1px solid var(--color-trait); font-size: 13px; color: var(--color-encre); cursor: pointer; transition: background .2s, color .2s; }
  .pastille small { font-family: var(--font-mono); opacity: .75; }
  .pastille input:checked + span { background: var(--color-encre); color: var(--color-cendre); border-color: var(--color-encre); }
  .pastille input:focus-visible + span { outline: 2px solid var(--color-cuivre); outline-offset: 3px; }
  .filtres:has(input[value="investissement-locatif"]:checked) li:not([data-theme="investissement-locatif"]),
  .filtres:has(input[value="residence-principale"]:checked) li:not([data-theme="residence-principale"]),
  .filtres:has(input[value="taux-marche"]:checked) li:not([data-theme="taux-marche"]),
  .filtres:has(input[value="assurance-emprunteur"]:checked) li:not([data-theme="assurance-emprunteur"]) { display: none; }
  .article-carte { transition: border-color .18s ease; }
  .article-carte:hover { border-color: var(--color-cuivre-profond); }
  .article-carte h2 { font-size: 20px; line-height: 1.3; }
</style>
