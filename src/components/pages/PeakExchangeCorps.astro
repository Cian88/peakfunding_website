---
import { langCourante, localiser } from '../../i18n';
import { exchangeCredit } from '../../data/peak-exchange';
import {stancerServiceURL} from '../../lib/services-checkout.mjs';
const en = langCourante(Astro.currentLocale) === 'en';
const L = (p: string) => localiser(p, en ? 'en' : 'fr');
const service = stancerServiceURL(import.meta.env,'exchange');
const checkout = service ? `${service}/exchange-paiement.html` : null;
const angles = en ? [
  ['01', 'Understand your position', 'Identify the strengths of your income, assets, company and project, together with the weaknesses a lender may question.'],
  ['02', 'Build your arguments', 'Turn your actual circumstances into clear, supported arguments. Anticipate objections and identify the information that needs explaining.'],
  ['03', 'Read the current context', 'Discuss how the political, economic and banking environment at the time of your meeting may influence a lender’s assessment.']
] : [
  ['01', 'Lire votre dossier', 'Identifier les points forts de vos revenus, de votre patrimoine, de vos sociétés et de votre projet, ainsi que les fragilités susceptibles d’interroger une banque.'],
  ['02', 'Construire vos arguments', 'Transformer les éléments concrets de votre situation en arguments clairs et étayés. Anticiper les objections et les informations à préciser.'],
  ['03', 'Comprendre le contexte', 'Mettre votre projet en perspective avec le contexte politique, économique et bancaire au moment de l’échange, et ses effets possibles sur l’analyse des banques.']
];
---

<section class="sombre exchange-hero">
  <div class="contenu exchange-intro">
    <div class="exchange-copy">
      <p class="eyebrow text-cuivre-clair">PEAK EXCHANGE · {en ? 'A personal perspective on your financing' : 'Un regard professionnel sur votre financement'}</p>
      <h1>{en ? 'Your application.' : 'Votre dossier.'}<br /><span>{en ? 'The right arguments.' : 'Les bons arguments.'}</span></h1>
      <p class="exchange-lead">{en ? 'An individual consultation with Valentin Boura–Defranoux to understand your strengths, address your weaknesses and prepare your conversation with a bank.' : 'Un échange individuel avec Valentin Boura–Defranoux pour comprendre vos points forts, traiter vos points faibles et préparer votre argumentation face aux banques.'}</p>
      <div class="exchange-price"><strong>299 €</strong><span>{en ? 'incl. VAT · one payment' : 'TTC · paiement unique'}<br />{en ? 'Consultation + personalised advice note' : 'Échange + note de conseil personnalisée'}</span></div>
      <p class="exchange-credit"><strong>{en ? 'Deducted from your brokerage fees' : 'Déduit de vos honoraires de courtage'}</strong><span>{exchangeCredit[en ? 'en' : 'fr']}</span></p>
      {checkout ? <a href={checkout} data-astro-reload class="btn-cuivre">{en ? 'Book PEAK EXCHANGE' : 'Prendre RDV via PEAK EXCHANGE'} <span aria-hidden="true">↗</span></a> : <a href="#reservation" class="btn-cuivre">{en ? 'Booking opens soon' : 'Réservations prochainement'} <span aria-hidden="true">↓</span></a>}
      <p class="exchange-small">{en ? 'Payment confirmation unlocks the booking calendar.' : 'Le paiement confirmé donne accès au choix de votre créneau.'}</p>
    </div>
    <figure class="exchange-portrait">
      <img src="/img/portrait-valentin.webp" alt="Valentin Boura–Defranoux" width="640" height="800" fetchpriority="high" />
      <figcaption><strong>Valentin Boura–Defranoux</strong><span>{en ? 'Founder · Independent financing broker' : 'Dirigeant · Courtier indépendant en financement'}</span><small>PEAK FUNDING · ORIAS 24002546</small></figcaption>
    </figure>
  </div>
</section>
<section class="exchange-analysis contenu section">
  <div class="exchange-section-head"><p class="eyebrow">{en ? 'The purpose of the meeting' : 'Au cœur de l’échange'}</p><h2>{en ? 'Know what to say.\nAnd why it matters.' : 'Savoir quoi défendre.\nEt comment le défendre.'}</h2></div>
  <div class="exchange-angles">{angles.map(([n, title, text]) => <article><span class="donnee">{n}</span><h3>{title}</h3><p>{text}</p></article>)}</div>
</section>
<section class="exchange-note">
  <div class="contenu exchange-note-grid"><div><p class="eyebrow">{en ? 'After the consultation' : 'À l’issue de l’échange'}</p><h2>{en ? 'Advice you can\ncome back to.' : 'Une note de conseil.\nDes arguments à garder.'}</h2></div><div><p>{en ? 'You receive a personalised advice note bringing together the analysis of your profile, the points discussed and the arguments relevant to your project.' : 'Vous recevez une note de conseil personnalisée qui reprend l’analyse de votre profil, les points abordés et les arguments adaptés à votre projet.'}</p><ul><li>{en ? 'Your strengths and the points to clarify' : 'Vos points forts et les éléments à éclaircir'}</li><li>{en ? 'Arguments supported by your actual circumstances' : 'Les arguments appuyés sur votre situation réelle'}</li><li>{en ? 'Contextual factors and suggested next steps' : 'Les éléments de contexte et les pistes d’action discutées'}</li></ul></div></div>
</section>
<section class="contenu section" id="reservation">
  <div class="exchange-section-head"><p class="eyebrow">{en ? 'Your booking' : 'Votre rendez-vous'}</p><h2>{en ? 'A clear process,\nfrom payment to advice.' : 'Un parcours simple,\ndu paiement au conseil.'}</h2></div>
  <ol class="exchange-steps"><li><strong>01 · {en ? 'Pay securely' : 'Régler la prestation'}</strong><p>{en ? '299 € incl. VAT by card through Stancer. Your billing details are collected before payment.' : '299 € TTC par carte via Stancer. Vos coordonnées de facturation sont recueillies avant le règlement.'}</p></li><li><strong>02 · {en ? 'Choose your time' : 'Choisir votre créneau'}</strong><p>{en ? 'Once payment is verified, access the dedicated Proton booking calendar.' : 'Après vérification du paiement, accédez à l’agenda Proton dédié pour choisir votre créneau.'}</p></li><li><strong>03 · {en ? 'Discuss your application' : 'Échanger sur votre dossier'}</strong><p>{en ? 'Prepare your existing figures, documents and any feedback from lenders. The consultation is followed by your personalised advice note.' : 'Préparez vos chiffres, documents existants et éventuels retours bancaires. L’échange est suivi de votre note de conseil personnalisée.'}</p></li></ol>
  <div class="exchange-booking"><div><h3>PEAK EXCHANGE <span>299 € TTC</span></h3><p>{en ? 'An independent service, available without purchasing any other product.' : 'Une prestation indépendante, accessible sans achat d’un autre service.'}</p>{!checkout && <p role="status">{en ? 'Online payments are being activated. No payment or booking is currently taken on this page.' : 'L’ouverture des paiements est en préparation. Aucun règlement ni rendez-vous n’est pris sur cette page pour le moment.'}</p>}</div>{checkout && <a href={checkout} data-astro-reload class="btn-cuivre">{en ? 'Continue to secure payment' : 'Accéder au paiement sécurisé'} ↗</a>}</div>
  <p class="exchange-credit-final">{exchangeCredit[en ? 'en' : 'fr']}</p>
  <p class="exchange-disclaimer">{en ? 'This consultation and the advice note do not guarantee a loan or specific terms. Each bank remains responsible for its lending decision. This service does not include submitting your application to lenders or negotiating on your behalf.' : 'L’échange et la note de conseil n’emportent aucune obligation de résultat et ne garantissent ni l’obtention d’un financement ni des conditions particulières. La décision appartient aux établissements bancaires sollicités. Cette prestation ne comprend pas la présentation du dossier aux banques ni la négociation pour votre compte.'}</p>
  <div class="exchange-links"><a href={L('/conditions-peak-exchange/')}>{en ? 'Terms of sale' : 'Conditions de vente'}</a><a href={L('/politique-de-confidentialite/')}>{en ? 'Privacy' : 'Confidentialité'}</a></div>
</section>
<style>
  .exchange-credit{border-left:2px solid #d9a47c;padding:0 0 0 16px;margin:0 0 28px;max-width:580px;color:#c4c5c8;font-size:13px;line-height:1.7}.exchange-credit strong{display:block;color:#edeae4;font-weight:500;margin-bottom:6px}.exchange-credit span{display:block}.exchange-credit-final{font-size:14px;line-height:1.75;max-width:900px;margin-top:24px;color:#555963}
  .exchange-hero{min-height:calc(100vh - 77px);min-height:calc(100svh - 77px);display:grid;align-items:center;padding:clamp(32px,5svh,100px) 0}.exchange-intro{display:grid;grid-template-columns:1.3fr .8fr;gap:clamp(32px,7vw,110px);align-items:center}.exchange-copy h1{font-size:clamp(42px,5.2vw,76px);line-height:1.04;letter-spacing:-.05em;font-weight:400;margin:26px 0}.exchange-copy h1 span{color:var(--color-cuivre-clair)}.exchange-lead{font-size:clamp(16px,1.4vw,19px);line-height:1.65;max-width:590px;color:#c4c5c8}.exchange-price{display:flex;align-items:center;gap:22px;margin:32px 0 26px}.exchange-price strong{font-size:48px;font-weight:400;letter-spacing:-.04em}.exchange-price span{font-size:12px;line-height:1.8;color:#c4c5c8}.exchange-small{font-size:12px;color:#b7bbc3;margin-top:16px}.exchange-portrait{margin:0;position:relative;max-width:420px;justify-self:end;overflow:hidden;border-radius:4px}.exchange-portrait img{display:block;width:100%;height:480px;object-fit:cover;object-position:center 32%}.exchange-portrait figcaption{position:absolute;inset:auto 0 0;padding:60px 24px 22px;background:linear-gradient(transparent,rgba(11,13,18,.95));color:#edeae4}.exchange-portrait strong,.exchange-portrait span,.exchange-portrait small{display:block}.exchange-portrait strong{font-size:18px;font-weight:500}.exchange-portrait span{font-size:12px;margin-top:6px}.exchange-portrait small{font:10px monospace;color:#d9a47c;margin-top:14px}.exchange-section-head{display:grid;grid-template-columns:1fr 2fr;gap:32px;align-items:start;margin-bottom:48px}.exchange-section-head h2,.exchange-note h2{white-space:pre-line;font-size:clamp(30px,3.4vw,46px);line-height:1.12;letter-spacing:-.04em;font-weight:400}.exchange-angles,.exchange-steps{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:40px}.exchange-angles article{border-top:1px solid #c4beb5;padding-top:20px}.exchange-angles article>span{font-size:12px;color:#94623f}.exchange-angles h3{font-size:22px;margin:24px 0 14px;letter-spacing:-.025em;font-weight:400}.exchange-angles p,.exchange-steps p{font-size:15px;line-height:1.7;color:#555963}.exchange-note{background:#e6e0d7;padding:72px 0}.exchange-note-grid{display:grid;grid-template-columns:1fr 1fr;gap:80px}.exchange-note h2{margin-top:24px}.exchange-note p{font-size:18px;line-height:1.65}.exchange-note li{font-size:14px;padding:16px 0;border-bottom:1px solid #c6bfb3}.exchange-note ul{margin-top:20px}.exchange-steps{list-style:none;padding:0}.exchange-steps strong{font-size:17px;font-weight:500}.exchange-steps p{margin-top:14px}.exchange-booking{border-top:1px solid #c4beb5;border-bottom:1px solid #c4beb5;margin-top:48px;padding:32px 0;display:flex;justify-content:space-between;align-items:center;gap:32px}.exchange-booking h3{font-size:22px;font-weight:500}.exchange-booking h3 span{font-weight:400;color:#94623f;margin-left:18px}.exchange-booking p{font-size:14px;line-height:1.65;max-width:650px;margin-top:8px;color:#555963}.exchange-booking [role=status]{color:#755137}.exchange-disclaimer{font-size:12px;line-height:1.8;color:#555963;max-width:900px;margin-top:28px}.exchange-links{display:flex;gap:24px;font-size:12px;text-decoration:underline;margin-top:20px}.exchange-copy .btn-cuivre{font-size:14px;gap:20px;max-width:100%;text-align:center}.exchange-booking .btn-cuivre{flex-shrink:0;font-size:13px}@media(max-width:850px){.exchange-intro{grid-template-columns:1fr .7fr;gap:24px}.exchange-portrait img{height:420px}.exchange-note-grid{gap:32px}.exchange-price{gap:14px}.exchange-angles,.exchange-steps{gap:24px}.exchange-booking{align-items:flex-start;flex-direction:column}}@media(max-width:640px){.exchange-hero{padding:36px 0}.exchange-intro,.exchange-section-head,.exchange-note-grid,.exchange-angles,.exchange-steps{grid-template-columns:1fr}.exchange-portrait{justify-self:start;max-width:100%;width:100%}.exchange-portrait img{height:330px;object-position:center 25%}.exchange-copy h1{font-size:44px}.exchange-price strong{font-size:40px}.exchange-note{padding:48px 0}.exchange-section-head{gap:20px;margin-bottom:32px}.exchange-angles h3{margin-top:16px}.exchange-steps{gap:28px}.exchange-booking h3 span{display:block;margin:8px 0 0}.exchange-booking .btn-cuivre{width:100%}}
</style>
