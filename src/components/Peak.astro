---
/**
 * Illustration au trait du héros — un sommet, une ligne d'horizon, un oiseau.
 * Trait d'encre fin ; une seule ligne en cuivre : le rôle de l'orange décoratif
 * chez Titan. Code-native, donc nette à toute taille et sans image à charger.
 */
interface Props { class?: string }
const { class: classe = '' } = Astro.props;
---

<svg viewBox="0 0 600 420" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" class={classe}>
  <!-- horizon et contreforts -->
  <path d="M20 360h560" />
  <path d="M20 330c60-30 90-70 140-70s70 40 110 40 60-30 90-30 70 30 110 30 60-20 90-20" stroke-opacity=".45" />
  <!-- sommet principal -->
  <path d="M120 360 300 90l180 270" />
  <path d="M300 90l-40 60 22 14 18-24 20 30 18-14z" />
  <path d="M232 240l30-22 24 30 34-40 30 26 22-36 40 60" stroke-opacity=".6" />
  <path d="M150 316l40-30 26 22 30-42" stroke-opacity=".35" />
  <!-- arête en cuivre -->
  <path d="M300 90 480 360" class="text-highlight" stroke="currentColor" stroke-width="2" />
  <!-- oiseau -->
  <path d="M470 118c8-8 16-8 22 0 6-8 14-8 22 0" stroke-width="1.75" />
  <!-- ville, au loin -->
  <path d="M500 360v-60h18v-24h14v84M540 360v-40h22v40" stroke-opacity=".5" />
  <path d="M40 360v-28h16v-18h12v46" stroke-opacity=".5" />
</svg>
