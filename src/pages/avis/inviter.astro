---
/* Page privée du cabinet : génération des invitations à déposer un avis,
   suivi et modération. Non indexée, non reliée à la navigation. */
import Base from '../../components/Feuillet.astro';
import InviterAvis from '../../components/react/InviterAvis';
---

<Base noindex title="Invitations avis clients | PEAK FUNDING" description="Espace privé du cabinet : invitations à déposer un avis et modération.">
  <section class="cadre-page respiration">
    <nav aria-label="Fil d’Ariane" class="legende normal-case tracking-normal"><a href="/" class="hover:text-encre">Accueil</a> <span aria-hidden="true">/</span> Espace cabinet</nav>
    <div class="portail"><div>
      <p class="legende">Espace cabinet · Privé</p>
      <h1 class="grand-titre mt-3">Invitations à déposer un avis</h1>
      <p class="paragraphe mt-5 max-w-xl text-[18px]">Générez le lien personnel d’un client après le déblocage de ses fonds, récupérez l’e-mail prêt à envoyer, suivez les invitations et validez les avis reçus.</p>
      </div><div class="fond-quadrille mt-8 border filet p-4 sm:p-6 lg:p-8">
        <InviterAvis client:only="react" lang="fr" />
        <noscript><p class="paragraphe">JavaScript est nécessaire pour cet espace.</p></noscript>
      </div>
    </div>
  </section>
</Base>
