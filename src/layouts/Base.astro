---
import '@fontsource-variable/geist';
import '@fontsource-variable/geist-mono';
import '../styles/global.css';
import { ClientRouter } from 'astro:transitions';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import RendezVousModal from '../components/react/RendezVousModal';
import { langCourante, urlAutreLangue, t } from '../i18n';
import { organisation, siteWeb, pageWeb, serialiser } from '../lib/seo';

interface Props {
  title: string; description: string; heros?: boolean; image?: string; clientRouting?: boolean; noindex?: boolean;
  /** Données structurées propres à la page (FAQ, service, article…), ajoutées au graphe commun. */
  schema?: object[];
  /** Type schema.org de la page (WebPage par défaut : CollectionPage, AboutPage…). */
  typePage?: string;
  /** Métadonnées d'article (Open Graph) : date ISO et auteur. */
  publie?: string; auteur?: string;
}
const { title, description, heros = false, image = '/img/hero-1600.webp', clientRouting = true, noindex = false, schema = [], typePage, publie, auteur } = Astro.props;
const lang = langCourante(Astro.currentLocale);
const tr = t(lang);
const canonical = new URL(Astro.url.pathname, Astro.site);
const urlAutre = new URL(urlAutreLangue(Astro.url.pathname, lang), Astro.site);
const autre = lang === 'fr' ? 'en' : 'fr';
const imageAbsolue = new URL(image, Astro.site).href;
// Pages privées (noindex) : aucune donnée structurée, rien à faire lire aux moteurs.
const graphe = noindex ? [] : [organisation(lang), siteWeb(lang), pageWeb({ url: canonical.href, titre: title, description, lang, type: typePage, image: imageAbsolue, publie }), ...schema];
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang={lang} href={canonical} />
    <link rel="alternate" hreflang={autre} href={urlAutre} />
    <link rel="alternate" hreflang="x-default" href={new URL(Astro.url.pathname.replace(/^\/en(?=\/|$)/, '') || '/', Astro.site)} />
    <link rel="icon" href="/img/symbole-montagne-cuivre.svg" type="image/svg+xml" />
    <meta name="theme-color" content="#0b0d12" />
    <meta property="og:type" content={publie ? 'article' : 'website'} />
    <meta property="og:site_name" content="PEAK FUNDING" />
    <meta property="og:locale" content={lang === 'fr' ? 'fr_FR' : 'en_GB'} />
    <meta property="og:locale:alternate" content={lang === 'fr' ? 'en_GB' : 'fr_FR'} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={imageAbsolue} />
    <meta property="og:image:alt" content={title} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={imageAbsolue} />
    {publie && <meta property="article:published_time" content={publie} />}
    {auteur && <meta name="author" content={auteur} />}
    {graphe.length > 0 && <script type="application/ld+json" is:inline set:html={serialiser(graphe)} />}
    {clientRouting && <ClientRouter />}
  </head>
  <body data-page-navigation={clientRouting ? 'spa' : 'document'} class:list={[heros ? 'bg-abime' : 'bg-cendre']}>
    <a href="#contenu" class="sr-only focus:not-sr-only focus:absolute focus:top-4 focus:left-4 focus:z-50 focus:rounded-pill focus:bg-cuivre focus:px-4 focus:py-2 focus:text-white">{tr.aller_contenu}</a>
    <Header heros={heros} />
    <button type="button" data-menu-voile class="menu-voile" aria-label={tr.modale.fermer} tabindex="-1"></button>
    <main id="contenu" tabindex="-1"><slot /></main>
    <Footer />
    <RendezVousModal client:load transition:persist lang={lang} />
    <script>
      import { demarrerMouvement } from '../scripts/motion';
      const initialiser = () => { demarrerMouvement(); };
      document.addEventListener('astro:page-load', initialiser);
      if (document.body.dataset.pageNavigation === 'document') initialiser();
    </script>
  </body>
</html>
