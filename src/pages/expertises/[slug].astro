---
import Base from '../../layouts/Base.astro';
import ExpertiseCorps from '../../components/pages/ExpertiseCorps.astro';
import { expertises } from '../../data/expertises';
import { accueil, faqExpertisesFor } from '../../data/contenu';
import { service, faqPage, filAriane, SITE } from '../../lib/seo';

export function getStaticPaths() {
  return expertises.map((e) => ({ params: { slug: e.slug }, props: { e } }));
}
const { e } = Astro.props;
const accroche = accueil('fr').expertises.find((x) => x.slug === e.slug)?.accroche ?? '';
// PEAK INSURE: title and description written for the queries people actually type.
const titre = e.slug === 'insure' ? 'Changer d’assurance de prêt : délégation d’assurance emprunteur | PEAK FUNDING' : `${e.nom} — ${accroche} | PEAK FUNDING`;
const description = e.slug === 'insure' ? 'Changer d’assurance de prêt immobilier, à la signature ou à tout moment (loi Lemoine) : comparaison multi-assureurs à garanties équivalentes, profils à risque, substitution gérée auprès de la banque. Étude gratuite.' : e.intro;
const schema = [
  service(e, 'fr'),
  faqPage(faqExpertisesFor('fr')[e.slug]),
  filAriane([{ nom: 'Accueil', url: `${SITE}/` }, { nom: `${e.nom} — ${accroche}`, url: `${SITE}/expertises/${e.slug}/` }]),
];
---

<Base title={titre} description={description} image={`/img/ambiance-${e.slug}.webp`} schema={schema}>
  <ExpertiseCorps e={e} />
</Base>
