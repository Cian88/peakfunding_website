---
import Base from '../../layouts/Base.astro';
import { ACTELO_CLIENT_SCRIPT, ACTELO_CLIENT_URL } from '../../data/integrations';
---

<!-- A document navigation isolates the vendor's global message listener, as in V1. -->
<Base clientRouting={false} title="Client portal | PEAK FUNDING" description="Access your file, send your supporting documents and follow the progress of your financing securely.">
  <section class="espace-large pt-12 pb-8 lg:pt-16">
    <nav aria-label="Breadcrumb" class="eyebrow normal-case tracking-normal"><a href="/en/" class="hover:text-encre">Home</a> <span aria-hidden="true">/</span> Client portal</nav>
    <div class="mt-8 grid items-end gap-6 lg:grid-cols-[1.25fr_1fr]">
      <div><p class="eyebrow">Your file online</p><h1 class="display mt-4">Client portal</h1></div>
      <p class="corps max-w-lg text-[17px]">Access your file, send your supporting documents and follow the progress of your financing securely.</p>
    </div>
  </section>
  <section class="espace-large pb-20" aria-label="Access to your Actelo portal">
    <div class="overflow-hidden rounded-donnee border border-trait bg-white p-2 sm:p-6">
      <p id="actelo-statut" role="status" class="px-4 py-6 text-[14px] text-gris">Loading your Actelo portal…</p>
      <div id="actelo-espace-client" class="min-h-[600px]"></div>
    </div>
    <p class="mt-5 text-[13px] text-gris">A display issue? <a href={ACTELO_CLIENT_URL} target="_blank" rel="noopener" class="underline underline-offset-4 hover:text-encre">Open the client portal in a new tab ↗</a></p>
    <noscript><p class="mt-4 text-[14px]">The embedded portal requires JavaScript. You can use the direct link above.</p></noscript>
  </section>
  <script is:inline data-actelo-script src={ACTELO_CLIENT_SCRIPT} async></script>
  <script>
    const container = document.getElementById('actelo-espace-client');
    const status = document.getElementById('actelo-statut');
    if (container && status) {
      const observer = new MutationObserver(prepareFrame);
      function prepareFrame() {
        const iframe = container!.querySelector('iframe');
        if (!iframe) return;
        iframe.title = 'Sign in to your PEAK FUNDING Actelo client portal';
        iframe.style.minHeight = '600px';
        iframe.addEventListener('load', () => { status!.hidden = true; }, { once: true });
        observer.disconnect();
      }
      observer.observe(container, { childList: true });
      prepareFrame();
      window.setTimeout(() => {
        if (!status.hidden) status.textContent = 'If your portal does not appear, use the direct link below the frame.';
      }, 12000);
    }
  </script>
</Base>

<style>
  .espace-large { width:100%; max-width:1840px; margin-inline:auto; padding-inline:clamp(20px, 4vw, 80px); }
</style>
