---
/* Section « Avis clients » — direction « Mur vivant ».
   La coque (section, filet de chapitre) est rendue ici ; le contenu est l'îlot
   React MurAvis : état « à venir » au rendu serveur (aucun avis fictif), puis
   lecture en direct de Supabase. Styles dans global.css (bloc « Avis clients »).
   Activation et schéma : docs/avis-clients-supabase.md */
import MurAvis from './react/MurAvis';
import { langCourante, localiser } from '../i18n';

const lang = langCourante(Astro.currentLocale);
const L = (p: string) => localiser(p, lang);
---

<section id="avis" class="sombre section-sombre scroll-mt-16">
  <div class="grille"></div>
  <div class="contenu relative">
    <div class="chapitre-filet reveal" aria-hidden="true"></div>
    <MurAvis client:load lang={lang} rdvHref={L('/#rdv')} />
  </div>
</section>
