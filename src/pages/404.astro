---
import Base from '../layouts/Base.astro';
---

<Base title="Page introuvable | PEAK FUNDING" description="Cette page n’existe pas ou a été déplacée.">
  <section class="contenu section">
    <p class="eyebrow">Erreur 404</p>
    <h1 class="display mt-3 max-w-2xl">Cette page n’existe pas.</h1>
    <p class="corps mt-5 max-w-lg text-[18px]">Elle a peut-être été déplacée. Le plus court chemin vers ce que vous cherchez passe sans doute par l’accueil ou par un échange de trente minutes.</p>
    <div class="mt-8 flex flex-wrap gap-3">
      <a href="/" class="btn-cuivre">Retour à l’accueil</a>
      <a href="/#rdv" class="btn-fantome">Prendre rendez-vous</a>
    </div>
  </section>
</Base>
