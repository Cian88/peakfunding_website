---
import Base from '../layouts/Base.astro';
---

<Base noindex title="Page introuvable | PEAK FUNDING" description="Cette page n’existe pas ou a été déplacée.">
  <section class="contenu section">
    <p class="eyebrow">Erreur 404</p>
    <h1 class="display mt-3 max-w-2xl">Cette page n’existe pas.</h1>
    <p class="corps mt-5 max-w-lg text-[18px]">Elle a peut-être été déplacée. Retrouvez les services et les ressources du cabinet depuis l’accueil.</p>
    <div class="mt-8 flex flex-wrap gap-3">
      <a href="/" class="btn-cuivre">Retour à l’accueil</a>
      <a href="/actualites/" class="btn-fantome">Consulter les analyses</a>
    </div>
  </section>
</Base>
