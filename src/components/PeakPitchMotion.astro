---
/* Prototype : couverture de l'accueil avec une animation native (HTML/CSS) de PEAK PITCH.
   Activée par PUBLIC_PEAK_PITCH_HERO=motion. Le film PEAK PITCH reste disponible avec la valeur true.
   L'état de base du CSS est l'image finale : sans animation, mouvement réduit ou ?statique, on voit
   directement les trois livrables. Les montants sont un exemple illustratif cohérent :
   285 000 + 20 000 + 24 000 = 329 000 € ; 329 000 − 45 000 = 284 000 € ; 25 ans à 3,5 % → 1 422 €/mois ;
   revenus 4 300 € + loyer 1 050 € × 70 % = 5 035 € → effort 28,2 % ; capacité 35 % → 350 000 €. */
import { localiser } from '../i18n';
import { ASSURANCE_URL } from '../data/integrations';
interface Props { lang?: 'fr' | 'en' }
const { lang = 'fr' } = Astro.props;
const fr = lang === 'fr';
const L = (p: string) => localiser(p, lang);
type Piece = [string, string];
type Intervenant = { sigle: string; nom: string; role: string; pieces: Piece[] };
const t = fr ? {
  eyebrow: 'Courtier indépendant · France entière',
  h1: 'Cabinet de courtage en financement et assurance emprunteur.',
  texte: 'Investissement locatif, SCI, reprise d’entreprise, opérations de marchands de biens : PEAK FUNDING structure et négocie votre financement, partout en France.',
  cta1: 'Estimer ma capacité', cta2: 'Le cabinet & ses expertises',
  scene: 'PEAK PITCH · DOSSIER DE FINANCEMENT', exemple: 'EXEMPLE ILLUSTRATIF', etape: 'ÉTAPE',
  questionnaire: 'Questionnaire guidé',
  reponses: [['Projet', 'Investissement locatif · T3'], ['Emprunteurs', '2 · salariés en CDI'], ['Revenus nets mensuels', '4 300 €'], ['Loyer attendu', '1 050 € / mois'], ['Apport personnel', '45 000 €'], ['Structure', 'SCI à créer']],
  chiffresTitre: 'Vos chiffres, rapprochés',
  chiffres: [['Budget total', '329 000 €', 'CALCULÉ'], ['Apport', '45 000 €', 'DÉCLARÉ'], ['Prêt demandé', '284 000 €', 'CALCULÉ'], ['Mensualité · 25 ans à 3,5 %', '1 422 €', 'CALCULÉ'], ['Capacité estimée', '350 000 €', 'SIMULATEUR']],
  dossier: 'Dossier PP-2611', page: 'p. 1 / 6',
  note: {
    n: '01 · NOTE DE SYNTHÈSE', titre: 'Note de synthèse', meta: ['Acquisition locative', 'Lyon 8e', 'SCI à créer'],
    resume: 'Acquisition, via une SCI à créer, d’un T3 destiné à la location (loyer attendu : 1 050 € par mois). Les deux associés, salariés en CDI, sollicitent un prêt de 284 000 € sur 25 ans.',
    chiffres: [['Prêt demandé', '284 000 €', 'CALCULÉ'], ['Apport', '45 000 €', 'DÉCLARÉ'], ['Mensualité', '1 422 €', 'CALCULÉ'], ['Taux d’effort', '28,2 %', 'CALCULÉ']],
    plan: 'Plan de financement', emplois: [['Prix du bien', '285 000 €'], ['Travaux', '20 000 €'], ['Frais de notaire et de garantie', '24 000 €']], total: ['Total des besoins', '329 000 €'],
    barre: [['Prêt', '86 %'], ['Apport', '14 %']],
    capacite: 'Capacité estimée par le simulateur', capaciteValeur: '350 000 €',
    annexe: 'Annexe : les 64 réponses déclarées',
  },
  pieces: {
    n: '02 · PIÈCES PAR INTERVENANT', titre: 'Pièces à réunir', resume: '3 intervenants · 9 pièces',
    intervenants: [
      { sigle: 'E1', nom: 'Emprunteur 1', role: 'Salarié en CDI', pieces: [['Pièce d’identité', 'Identité'], ['3 derniers bulletins de salaire', 'Revenus'], ['2 derniers avis d’imposition', 'Revenus'], ['Relevés de comptes, 3 mois', 'Gestion']] },
      { sigle: 'E2', nom: 'Co-emprunteur', role: 'Salariée en CDI', pieces: [['Pièce d’identité', 'Identité'], ['Contrat de travail', 'Stabilité'], ['Justificatif d’épargne', 'Apport']] },
      { sigle: 'SCI', nom: 'SCI à créer', role: '2 associés', pieces: [['Projet de statuts', 'Structure'], ['Répartition du capital', 'Associés']] },
    ] as Intervenant[],
  },
  pres: {
    n: '03 · PRÉSENTATION BANCAIRE', titre: 'Acquisition d’un T3 locatif', sous: 'Demande de financement · 284 000 € sur 25 ans',
    parties: ['La demande', 'Les emprunteurs', 'Le bien', 'Les revenus', 'Le plan de financement', 'L’analyse', 'La synthèse'],
    anneau: 'Besoins', legende: [['Prêt', '284 000 €'], ['Apport', '45 000 €']], diapo: '1 / 7',
  },
  controle: 'Chaque montant correspond à une valeur déclarée ou calculée',
  kicker: 'PEAK PITCH — UN SERVICE DE PEAK FUNDING', promesse: 'Votre projet, prêt à présenter.', mentions: 'TVA non applicable · Paiement unique',
  decouvrir: 'Découvrir PEAK PITCH', banques: 'Le financement reste soumis à l’accord des banques.',
  pause: 'Mettre l’animation en pause', reprendre: 'Reprendre l’animation', rejouer: 'Rejouer l’animation',
  sr: 'Animation : un questionnaire guidé en 8 étapes, des chiffres rapprochés et étiquetés comme déclarés, calculés ou issus du simulateur, puis trois livrables : note de synthèse, pièces à réunir par intervenant et présentation bancaire en sept parties.',
  ambiance: 'Courtier indépendant · France entière', exchange: 'RDV PEAK EXCHANGE', assurance: 'Assurance emprunteur',
} : {
  eyebrow: 'Independent broker · Throughout France',
  h1: 'Independent financing and borrower insurance brokerage.',
  texte: 'Buy-to-let investments, French property companies (SCI), business acquisitions and property trading projects: PEAK FUNDING structures and negotiates your financing throughout France.',
  cta1: 'Estimate my capacity', cta2: 'Our firm & expertise',
  scene: 'PEAK PITCH · FINANCING APPLICATION', exemple: 'ILLUSTRATIVE EXAMPLE', etape: 'STEP',
  questionnaire: 'Guided questionnaire',
  reponses: [['Project', 'Buy-to-let · 2-bedroom flat'], ['Borrowers', '2 · permanent employees'], ['Net monthly income', '€4,300'], ['Expected rent', '€1,050 / month'], ['Personal contribution', '€45,000'], ['Structure', 'SCI to be formed']],
  chiffresTitre: 'Your figures, reconciled',
  chiffres: [['Total budget', '€329,000', 'CALCULATED'], ['Contribution', '€45,000', 'DECLARED'], ['Loan requested', '€284,000', 'CALCULATED'], ['Monthly payment · 25 yrs at 3.5%', '€1,422', 'CALCULATED'], ['Estimated capacity', '€350,000', 'SIMULATOR']],
  dossier: 'File PP-2611', page: 'p. 1 / 6',
  note: {
    n: '01 · SUMMARY NOTE', titre: 'Summary note', meta: ['Buy-to-let', 'Lyon 8th', 'SCI to be formed'],
    resume: 'Purchase, through an SCI to be formed, of a two-bedroom flat to let (expected rent: €1,050 a month). The two partners, both permanent employees, request a €284,000 loan over 25 years.',
    chiffres: [['Loan requested', '€284,000', 'CALCULATED'], ['Contribution', '€45,000', 'DECLARED'], ['Monthly payment', '€1,422', 'CALCULATED'], ['Debt ratio', '28.2%', 'CALCULATED']],
    plan: 'Financing plan', emplois: [['Property price', '€285,000'], ['Works', '€20,000'], ['Notary and guarantee fees', '€24,000']], total: ['Total requirement', '€329,000'],
    barre: [['Loan', '86%'], ['Contribution', '14%']],
    capacite: 'Capacity estimated by the simulator', capaciteValeur: '€350,000',
    annexe: 'Appendix: the 64 declared answers',
  },
  pieces: {
    n: '02 · DOCUMENTS PER PARTY', titre: 'Documents to gather', resume: '3 parties · 9 documents',
    intervenants: [
      { sigle: 'B1', nom: 'Borrower 1', role: 'Permanent employee', pieces: [['ID document', 'Identity'], ['Last 3 payslips', 'Income'], ['Last 2 tax notices', 'Income'], ['Bank statements, 3 months', 'Management']] },
      { sigle: 'B2', nom: 'Co-borrower', role: 'Permanent employee', pieces: [['ID document', 'Identity'], ['Employment contract', 'Stability'], ['Proof of savings', 'Contribution']] },
      { sigle: 'SCI', nom: 'SCI to be formed', role: '2 partners', pieces: [['Draft articles', 'Structure'], ['Share capital split', 'Partners']] },
    ] as Intervenant[],
  },
  pres: {
    n: '03 · BANK PRESENTATION', titre: 'Purchase of a flat to let', sous: 'Financing request · €284,000 over 25 years',
    parties: ['The request', 'The borrowers', 'The property', 'Income', 'Financing plan', 'Analysis', 'Summary'],
    anneau: 'Requirement', legende: [['Loan', '€284,000'], ['Contribution', '€45,000']], diapo: '1 / 7',
  },
  controle: 'Every amount matches a declared or calculated value',
  kicker: 'PEAK PITCH — A PEAK FUNDING SERVICE', promesse: 'Your project, ready to present.', mentions: 'VAT not applicable · One payment',
  decouvrir: 'Discover PEAK PITCH', banques: 'Financing remains subject to approval by the banks.',
  pause: 'Pause the animation', reprendre: 'Resume the animation', rejouer: 'Replay the animation',
  sr: 'Animation: a guided 8-step questionnaire, figures reconciled and labelled as declared, calculated or from the simulator, then three deliverables: summary note, documents to gather per party and a seven-part bank presentation.',
  ambiance: 'Independent broker · Throughout France', exchange: 'Book PEAK EXCHANGE', assurance: 'Borrower insurance',
};
const marque = 'M1 13 7 3l3 5 2-3 5 8';
---

<section class="heros sombre pp" data-pp aria-labelledby="pp-titre">
  <div class="pp-grille">
    <div class="pp-cabinet">
      <p class="eyebrow text-cuivre-clair">{t.eyebrow}</p>
      <h1 id="pp-titre">{t.h1}</h1>
      <p class="pp-texte">{t.texte}</p>
      <div class="pp-actions">
        <a href="#simulateur" class="btn-fantome">{t.cta1}</a>
        <a href="#expertises" class="btn-fantome">{t.cta2} <span aria-hidden="true">↓</span></a>
      </div>
    </div>

    <div class="pp-produit">
      <div class="pp-scene pp-anime" data-pp-scene>
        <p class="sr-only">{t.sr}</p>
        <div class="pp-plateau" aria-hidden="true">
          <div class="pp-entete"><span>{t.scene}</span><span>{t.exemple}</span></div>
          <div class="pp-rail">{Array.from({ length: 8 }, (_, i) => <i style={`--i:${i}`}></i>)}<b class="pp-compteur">{t.etape}&nbsp;</b></div>

          <div class="pp-carte pp-q">
            <p class="pp-carte-titre">{t.questionnaire}</p>
            {t.reponses.map(([q, r], i) => <p class="pp-ligne" style={`--i:${i}`}><span>{q}</span><b>{r}</b></p>)}
          </div>

          <div class="pp-carte pp-c">
            <p class="pp-carte-titre">{t.chiffresTitre}</p>
            {t.chiffres.map(([q, r, s], i) => <p class="pp-ligne" style={`--i:${i}`}><span>{q}</span><b>{r}</b><em>{s}</em></p>)}
          </div>

          <!-- 03 · Présentation bancaire : diapositive 16:10, à l'arrière -->
          <div class="pp-doc pp-pres">
            <div class="pp-bandeau"><span><svg viewBox="0 0 18 16"><path d={marque} /></svg>PEAK PITCH</span><span>{t.pres.diapo}</span></div>
            <div class="pp-pres-corps">
              <div class="pp-pres-texte pp-el" style="--k:0">
                <p class="pp-n">{t.pres.n}</p>
                <p class="pp-pres-titre">{t.pres.titre}</p>
                <p class="pp-pres-sous">{t.pres.sous}</p>
                <ol class="pp-sommaire">{t.pres.parties.map((p, i) => <li class={i === 0 ? 'actif' : ''}><span>{String(i + 1).padStart(2, '0')}</span>{p}</li>)}</ol>
              </div>
              <div class="pp-anneau pp-el" style="--k:2">
                <svg viewBox="0 0 42 42"><circle class="fond" cx="21" cy="21" r="15.915" /><circle class="pret" cx="21" cy="21" r="15.915" pathLength="100" /><circle class="apport" cx="21" cy="21" r="15.915" pathLength="100" /></svg>
                <p><b>329 k€</b><span>{t.pres.anneau}</span></p>
                <ul>{t.pres.legende.map(([l, v], i) => <li class={i ? 'apport' : 'pret'}><i></i>{l}<b>{v}</b></li>)}</ul>
              </div>
            </div>
          </div>

          <!-- 02 · Pièces à réunir -->
          <div class="pp-doc pp-pieces">
            <div class="pp-bandeau"><span><svg viewBox="0 0 18 16"><path d={marque} /></svg>PEAK PITCH</span><span>{t.dossier}</span></div>
            <div class="pp-doc-corps">
              <p class="pp-n pp-el" style="--k:0">{t.pieces.n}</p>
              <p class="pp-doc-titre pp-el" style="--k:0">{t.pieces.titre}</p>
              <p class="pp-puce pp-el" style="--k:1">{t.pieces.resume}</p>
              {t.pieces.intervenants.map((iv, j) => (
                <div class="pp-intervenant pp-el" style={`--k:${j + 2}`}>
                  <p class="pp-qui"><i>{iv.sigle}</i><b>{iv.nom}</b><span>{iv.role}</span></p>
                  {iv.pieces.map(([p, r]) => <p class="pp-piece"><span class="case"></span>{p}<em>{r}</em></p>)}
                </div>
              ))}
            </div>
          </div>

          <!-- 01 · Note de synthèse : au premier plan -->
          <div class="pp-doc pp-note">
            <div class="pp-bandeau"><span><svg viewBox="0 0 18 16"><path d={marque} /></svg>PEAK PITCH</span><span>{t.dossier} · {t.page}</span></div>
            <div class="pp-doc-corps">
              <p class="pp-n pp-el" style="--k:0">{t.note.n}</p>
              <p class="pp-doc-titre pp-el" style="--k:0">{t.note.titre}</p>
              <p class="pp-meta pp-el" style="--k:1">{t.note.meta.map(m => <span>{m}</span>)}</p>
              <p class="pp-resume pp-el" style="--k:1">{t.note.resume}</p>
              <dl class="pp-kpi pp-el" style="--k:2">{t.note.chiffres.map(([q, r, s]) => <div><dt>{q}</dt><dd>{r}</dd><small>{s}</small></div>)}</dl>
              <div class="pp-plan pp-el" style="--k:3">
                <p class="pp-plan-titre">{t.note.plan}</p>
                {t.note.emplois.map(([l, v]) => <p class="pp-plan-ligne"><span>{l}</span><b>{v}</b></p>)}
                <p class="pp-plan-ligne total"><span>{t.note.total[0]}</span><b>{t.note.total[1]}</b></p>
                <div class="pp-barre-financement"><i class="pret"></i><i class="apport"></i></div>
                <p class="pp-barre-legende">{t.note.barre.map(([l, v]) => <span><b>{v}</b> {l}</span>)}</p>
              </div>
              <p class="pp-capacite pp-el" style="--k:4"><span>{t.note.capacite}</span><b>{t.note.capaciteValeur}</b><small>SIMULATEUR</small></p>
              <p class="pp-annexe pp-el" style="--k:4">{t.note.annexe} <span>→</span></p>
            </div>
          </div>

          <p class="pp-controle"><svg viewBox="0 0 16 16"><path d="M3 8.5 6.5 12 13 4.5" /></svg>{t.controle}</p>
        </div>
        <button class="pp-pause" type="button" data-pp-pause data-pause={t.pause} data-resume={t.reprendre} data-replay={t.rejouer} aria-label={t.pause}>
          <svg aria-hidden="true" viewBox="0 0 20 20" fill="currentColor"><path class="i-pause" d="M6 4h2.5v12H6zm5.5 0H14v12h-2.5z"/><path class="i-play" d="m7 4 10 6-10 6z"/><path class="i-replay" d="M10 4a6 6 0 1 1-5.7 4.1l1.5.5A4.4 4.4 0 1 0 10 5.6V8L6.5 4.8 10 1.6z"/></svg>
        </button>
      </div>

      <div class="pp-offre">
        <div>
          <p class="pp-kicker">{t.kicker}</p>
          <p class="pp-promesse">{t.promesse}</p>
        </div>
        <p class="pp-prix">99&nbsp;€<small>{t.mentions}</small></p>
        <a class="btn-cuivre gap-4" href={L('/peak-pitch/')}>{t.decouvrir} <span aria-hidden="true">↗</span></a>
        <p class="pp-banques">{t.banques}</p>
      </div>
    </div>
  </div>

  <div class="pp-pied">
    <p>{t.ambiance}<span>ORIAS n° 24002546 · {fr ? 'Supervision ACPR' : 'ACPR supervision'}</span></p>
    <nav aria-label={fr ? 'Poursuivre sur le site' : 'Continue on the website'}>
      <a href={L('/peak-exchange/')}>{t.exchange} ↗</a>
      <a href={ASSURANCE_URL} data-assurance target="_blank" rel="noopener">{t.assurance} ↗</a>
    </nav>
  </div>
</section>

<script>
  // Pause, reprise et relecture. Sans script, l'animation CSS joue une fois puis reste sur l'image finale.
  let dispose: (() => void) | undefined;
  function init() {
    dispose?.();
    const scene = document.querySelector<HTMLElement>('[data-pp-scene]');
    const bouton = scene?.querySelector<HTMLButtonElement>('[data-pp-pause]');
    if (!scene || !bouton) return;
    const ctrl = new AbortController();
    const reduit = matchMedia('(prefers-reduced-motion: reduce)');
    if (new URLSearchParams(location.search).has('statique')) scene.classList.remove('pp-anime');
    let etat: 'joue' | 'pause' | 'fin' = 'joue';
    const maj = () => {
      const anime = scene.classList.contains('pp-anime') && !reduit.matches;
      bouton.hidden = !anime && etat !== 'fin';
      scene.classList.toggle('pp-en-pause', etat === 'pause');
      bouton.dataset.etat = etat;
      bouton.setAttribute('aria-label', (etat === 'joue' ? bouton.dataset.pause : etat === 'pause' ? bouton.dataset.resume : bouton.dataset.replay) || '');
    };
    bouton.addEventListener('click', () => {
      if (etat === 'fin') {
        scene.classList.remove('pp-anime'); void scene.offsetWidth; scene.classList.add('pp-anime'); etat = 'joue';
      } else etat = etat === 'joue' ? 'pause' : 'joue';
      maj();
    }, { signal: ctrl.signal });
    scene.querySelector('.pp-controle')?.addEventListener('animationend', () => { etat = 'fin'; maj(); }, { signal: ctrl.signal });
    reduit.addEventListener('change', maj, { signal: ctrl.signal });
    dispose = () => ctrl.abort();
    maj();
  }
  document.addEventListener('astro:page-load', init);
  document.addEventListener('astro:before-swap', () => { dispose?.(); dispose = undefined; });
</script>

<style>
  @property --pp-etape { syntax: '<integer>'; inherits: true; initial-value: 8; }
  .pp{position:relative;display:flex;flex-direction:column;justify-content:center;min-height:100svh;margin-top:-76px;padding-top:76px;background:#0b0d12;color:#edeae4;isolation:isolate}
  .pp-grille{display:grid;grid-template-columns:minmax(0,.85fr) minmax(0,1.15fr);gap:clamp(32px,5vw,96px);align-items:center;width:100%;max-width:1840px;margin:0 auto;padding:clamp(28px,4vh,56px) clamp(20px,5vw,76px)}
  .pp-cabinet h1{margin:22px 0 0;font-size:clamp(32px,3.6vw,60px);line-height:1.06;letter-spacing:-.04em;font-weight:300;text-wrap:balance}
  .pp-texte{max-width:520px;margin:26px 0 0;font-size:17px;line-height:1.6;font-weight:300;color:#edeae4e6}
  .pp-actions{display:flex;flex-wrap:wrap;gap:12px;margin-top:34px}
  .pp-produit{display:flex;flex-direction:column;gap:18px;min-width:0;max-width:calc((100svh - 280px) / .96 + 2px);width:100%;justify-self:end}

  /* ── Scène : toutes les mesures en cqw pour garder la composition à toutes les tailles ── */
  .pp-scene{position:relative;container-type:inline-size;border:1px solid #2a2f3a;border-radius:16px;background:#14171e;overflow:hidden}
  .pp-plateau{position:relative;aspect-ratio:1/.96;font-size:1.9cqw;background-image:radial-gradient(ellipse 70% 55% at 55% 60%,#1e222b 0%,transparent 70%),linear-gradient(#ffffff08 1px,transparent 1px),linear-gradient(90deg,#ffffff08 1px,transparent 1px);background-size:auto,6cqw 6cqw,6cqw 6cqw}
  .pp-entete{position:absolute;inset:3.4cqw 4cqw auto;display:flex;justify-content:space-between;font:1.5cqw var(--font-mono);letter-spacing:.08em;color:#a6a9b3}
  .pp-entete span:first-child{color:#d9a47c}
  .pp-rail{position:absolute;left:4cqw;right:4cqw;top:7.6cqw;display:flex;align-items:center;gap:.8cqw}
  .pp-rail i{flex:1;height:.35cqw;border-radius:1cqw;background:#d9a47c;transform-origin:left}
  .pp-compteur{margin-left:1.4cqw;font:400 1.5cqw var(--font-mono);letter-spacing:.06em;color:#edeae4;white-space:nowrap;counter-reset:e var(--pp-etape)}
  .pp-compteur::after{content:'0' counter(e) ' / 08'}

  .pp-carte{position:absolute;left:14cqw;top:17cqw;width:72cqw;padding:4cqw;border:1px solid #2a2f3a;border-radius:2.6cqw;background:#1e222b;opacity:0;visibility:hidden}
  .pp-carte-titre{margin:0 0 2.4cqw;font-size:3.4cqw;font-weight:300;letter-spacing:-.03em}
  .pp-ligne{display:flex;align-items:baseline;gap:2cqw;margin:0;padding:1.6cqw 0;border-top:1px solid #2a2f3a;font-size:2.1cqw}
  .pp-ligne span{flex:1;color:#a6a9b3}
  .pp-ligne b{font:400 2.3cqw var(--font-mono);letter-spacing:-.03em}
  .pp-ligne em{width:13cqw;text-align:right;font:normal 1.4cqw var(--font-mono);letter-spacing:.06em;color:#d9a47c}

  /* ── Documents : papier, bandeau de marque, contenu réel ── */
  .pp-doc{position:absolute;overflow:hidden;border-radius:1.2cqw;background:#fbfaf7;color:#111;outline:1px solid #ffffff14;transition:translate .4s cubic-bezier(.2,.7,.2,1)}
  .pp-doc:hover{translate:0 -1.8cqw}
  .pp-pres{left:3cqw;top:12cqw;width:60cqw;height:37.5cqw;transform:rotate(-2.5deg);z-index:1}
  .pp-pieces{left:57cqw;top:13cqw;width:40cqw;height:61cqw;transform:rotate(2.5deg);z-index:2;background:#f6f4ef}
  .pp-note{left:16cqw;top:30cqw;width:44cqw;height:62cqw;transform:rotate(-.8deg);z-index:3;background:#fff}
  .pp-bandeau{display:flex;justify-content:space-between;align-items:center;padding:1.3cqw 2.4cqw;background:#0b0d12;color:#a6a9b3;font:1.05cqw var(--font-mono);letter-spacing:.1em}
  .pp-bandeau span:first-child{display:flex;align-items:center;gap:.8cqw;color:#edeae4}
  .pp-bandeau svg{width:1.8cqw;height:1.6cqw;fill:none;stroke:#d9a47c;stroke-width:1.6;stroke-linejoin:round}
  .pp-doc-corps{padding:2.2cqw 2.6cqw}
