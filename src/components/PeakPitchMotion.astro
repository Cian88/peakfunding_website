  pdf: '3 PDF prêts à présenter',
  chiffres: [['Budget total', '329 000 €', 'CALCULÉ'], ['Apport', '45 000 €', 'DÉCLARÉ'], ['Prêt demandé', '284 000 €', 'CALCULÉ'], ['Mensualité · 25 ans', '1 422 €', 'CALCULÉ'], ['Capacité estimée', '350 000 €', 'SIMULATEUR']],
  dossier: 'Dossier PP-2611', page: 'Page 1 sur 6', checklistPage: 'Page 1 sur 1', date: '20 novembre 2026', simulateur: 'SIMULATEUR', source: 'Document préparé à partir des déclarations du client', colonnes: ['Intervenant', 'Pièce', 'Motif'], profil: 'Profil du projet', noteTableau: 'Frais de notaire et de garantie inclus.',
  note: {
    n: '01 · NOTE DE SYNTHÈSE', titre: 'Note de synthèse', meta: ['Acquisition locative', 'Lyon 8e', 'SCI à créer'],
    resume: 'Acquisition, via une SCI à créer, d’un T3 destiné à la location (loyer attendu : 1 050 € par mois). Les deux associés, salariés en CDI, sollicitent un prêt de 284 000 € sur 25 ans.',
    chiffres: [['Prêt demandé', '284 000 €', 'CALCULÉ'], ['Apport', '45 000 €', 'DÉCLARÉ'], ['Mensualité', '1 422 €', 'CALCULÉ'], ['Taux d’effort', '28,2 %', 'CALCULÉ']],
    plan: 'Plan de financement', emplois: [['Prix du bien', '285 000 €'], ['Travaux', '20 000 €'], ['Frais de notaire et de garantie', '24 000 €']], total: ['Total des besoins', '329 000 €'],
    barre: [['Prêt', '86 %'], ['Apport', '14 %']],
    capacite: 'Capacité estimée par le simulateur', capaciteValeur: '350 000 €',
    annexe: 'Annexe : les 64 réponses déclarées',
  },
  pieces: {
