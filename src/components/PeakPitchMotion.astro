                  <tbody>
                    <tr class="groupe"><td colspan="3"><b>{iv.nom}</b> — {iv.role}</td></tr>
                    {iv.pieces.map(([pc, r]) => <tr><td><span class="case"></span></td><td>{pc}</td><td>{r}</td></tr>)}
                  </tbody>
                ))}
              </table>
            </div>
            <footer class="pp-pied-doc"><span>{t.doc.prepare}</span><span>{t.doc.page(1, 2)}</span></footer>
          </div>

          <!-- 01 · Note de synthèse : page A4, au premier plan -->
          <div class="pp-doc pp-note">
            <header class="pp-tete-doc"><span class="pp-logo"><svg viewBox="0 0 18 16"><path d={marque} /></svg>PEAK FUNDING</span><span>{t.dossier}<br />{t.date}</span></header>
            <div class="pp-page">
              <p class="pp-surtitre pp-el" style="--k:0">{t.doc.noteSur}</p>
              <p class="pp-titre-doc pp-el" style="--k:0">{t.doc.noteTitre}</p>
              <p class="pp-sous-doc pp-el" style="--k:0">{t.doc.noteMeta}</p>
              <p class="pp-h pp-el" style="--k:1">{t.doc.s1}</p>
