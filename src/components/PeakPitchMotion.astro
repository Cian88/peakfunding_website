  pdf: '3 PDF prêts à présenter',
  tampon: ['PEAK PITCH · DOSSIER PRÊT À PRÉSENTER · ', 'PRÊT'],
  fin: { kicker: 'VOTRE DOSSIER EST PRÊT', avant: 'PEAK PITCH, c’est mettre', accent: 'toutes les chances', apres: 'de votre côté.',
    sous: 'Votre dossier, structuré et présenté comme la banque l’attend. Sans mandat, vous gardez la main.', bouton: 'Préparer mon dossier', prix: '99 € · TVA non applicable' },
  chiffres: [['Budget total', '329 000 €', 'CALCULÉ'], ['Apport', '45 000 €', 'DÉCLARÉ'], ['Prêt demandé', '284 000 €', 'CALCULÉ'], ['Mensualité · 25 ans', '1 422 €', 'CALCULÉ'], ['Capacité estimée', '350 000 €', 'SIMULATEUR']],
  dossier: 'Dossier PP-2611', page: 'p. 1 / 6', date: '20 novembre 2026',
  doc: { prepare: 'Établi d’après les déclarations du client · Exemple', page: (n: number, t: number) => `Page ${n} sur ${t}`,
    noteSur: 'NOTE DE SYNTHÈSE', noteTitre: 'Acquisition locative d’un T3 — Lyon 8e', noteMeta: 'Emprunteurs : 2 associés, via une SCI à créer · Durée demandée : 25 ans',
    s1: '1. Le projet', s2: '2. Chiffres clés', s3: '3. Plan de financement', cols: ['Libellé', 'Montant', 'Source'], emploi: 'Emplois', montant: 'Montant',
    capacite: ['Capacité estimée', '350 000 €', 'Simulateur'], renvoi: 'Frais estimés, montants arrondis. Détail des réponses en annexe, p. 4 à 6.',
    piecesSur: 'LISTE DES PIÈCES À FOURNIR', piecesTitre: 'Pièces justificatives par intervenant', piecesMeta: '3 intervenants · 9 pièces · à transmettre par le client à la banque',
    piecesCols: ['Pièce', 'Motif'], presEntete: 'Présentation bancaire' },
  note: {
    n: '01 · NOTE DE SYNTHÈSE', titre: 'Note de synthèse', meta: ['Acquisition locative', 'Lyon 8e', 'SCI à créer'],
    resume: 'Acquisition, via une SCI à créer, d’un T3 destiné à la location (loyer attendu : 1 050 € par mois). Les deux associés, salariés en CDI, sollicitent un prêt de 284 000 € sur 25 ans.',
    chiffres: [['Prêt demandé', '284 000 €', 'CALCULÉ'], ['Apport', '45 000 €', 'DÉCLARÉ'], ['Mensualité', '1 422 €', 'CALCULÉ'], ['Taux d’effort', '28,2 %', 'CALCULÉ']],
    plan: 'Plan de financement', emplois: [['Prix du bien', '285 000 €'], ['Travaux', '20 000 €'], ['Frais de notaire et de garantie', '24 000 €']], total: ['Total des besoins', '329 000 €'],
    barre: [['Prêt', '86 %'], ['Apport', '14 %']],
    capacite: 'Capacité estimée par le simulateur', capaciteValeur: '350 000 €',
    annexe: 'Annexe : les 64 réponses déclarées',
  },
  pieces: {
    n: '02 · PIÈCES PAR INTERVENANT', titre: 'Pièces à réunir', resume: '3 intervenants · 9 pièces',
    intervenants: [
      { sigle: 'E1', nom: 'Emprunteur 1', role: 'Salarié en CDI', pieces: [['Pièce d’identité', 'Identité'], ['3 derniers bulletins de salaire', 'Revenus'], ['2 derniers avis d’imposition', 'Revenus'], ['Relevés de comptes, 3 mois', 'Gestion']] },
      { sigle: 'E2', nom: 'Co-emprunteur', role: 'Salariée en CDI', pieces: [['Pièce d’identité', 'Identité'], ['Contrat de travail', 'Stabilité'], ['Justificatif d’épargne', 'Apport']] },
      { sigle: 'SCI', nom: 'SCI à créer', role: '2 associés', pieces: [['Projet de statuts', 'Structure'], ['Répartition du capital', 'Associés']] },
    ] as Intervenant[],
  },
  pres: {
    n: '03 · PRÉSENTATION BANCAIRE', titre: 'Acquisition d’un T3 locatif', sous: 'Demande de financement · 284 000 € sur 25 ans',
    parties: ['La demande', 'Les emprunteurs', 'Le bien', 'Les revenus', 'Le plan de financement', 'L’analyse', 'La synthèse'],
    anneau: 'Besoins', legende: [['Prêt', '284 000 €'], ['Apport', '45 000 €']], diapo: '1 / 7',
    bandeau: 'Présentation bancaire', chips: [['Prêt', '284 000 €'], ['Durée', '25 ans'], ['Apport', '14 %']], bien: 'T3 · 68 m² · 2e étage',
    d2: { n: '05 · LE PLAN DE FINANCEMENT', titre: 'Emplois et ressources', emplois: 'Emplois', ressources: 'Ressources',
      e: [['Prix du bien', '285 000 €'], ['Travaux', '20 000 €'], ['Frais de notaire et de garantie', '24 000 €']],
      r: [['Apport personnel', '45 000 €'], ['Prêt immobilier', '284 000 €']], total: ['Total', '329 000 €'] },
    d3: { n: '06 · L’ANALYSE', titre: 'Revenus et charges mensuels',
      barres: [['Revenus nets', '4 300 €', 85], ['Loyer pondéré à 70 %', '735 €', 15], ['Mensualité du prêt', '1 422 €', 28]] as [string, string, number][],
      jauge: 'Taux d’effort', repere: 'REPÈRE HCSF : 35 %', couverture: ['Part de la mensualité couverte par le loyer', '74 %'] },
    pied: 'Dossier PP-2611 · Exemple illustratif',
  },
  controle: 'Chaque montant correspond à une valeur déclarée ou calculée',
  kicker: 'PEAK PITCH — UN SERVICE DE PEAK FUNDING', promesse: 'Votre projet, prêt à présenter.', mentions: 'TVA non applicable · Paiement unique',
  decouvrir: 'Découvrir PEAK PITCH', banques: 'Le financement reste soumis à l’accord des banques.',
  pause: 'Mettre l’animation en pause', reprendre: 'Reprendre l’animation', rejouer: 'Rejouer l’animation',
  sr: 'Animation : un questionnaire guidé en 8 étapes, des chiffres rapprochés et étiquetés comme déclarés, calculés ou issus du simulateur, puis trois livrables : note de synthèse, pièces à réunir par intervenant et présentation bancaire en sept parties.',
  ambiance: 'Courtier indépendant · France entière', exchange: 'RDV PEAK EXCHANGE', assurance: 'Assurance emprunteur',
} : {
  eyebrow: 'Independent broker · Throughout France',
  h1: 'Independent financing and borrower insurance brokerage.',
  texte: 'Buy-to-let investments, French property companies (SCI), business acquisitions and property trading projects: PEAK FUNDING structures and negotiates your financing throughout France.',
  cta1: 'Estimate my capacity', cta2: 'Our firm & expertise',
  scene: 'PEAK PITCH · FINANCING APPLICATION', exemple: 'ILLUSTRATIVE EXAMPLE', etape: 'STEP',
  questionnaire: 'Guided questionnaire',
  reponses: [['Project', 'Buy-to-let · 2-bedroom flat'], ['Borrowers', '2 · permanent employees'], ['Net monthly income', '€4,300'], ['Expected rent', '€1,050 / month'], ['Personal contribution', '€45,000'], ['Structure', 'SCI to be formed']],
  chiffresTitre: 'Your figures, reconciled',
  phases: ['Questionnaire', 'Reconciliation', 'Deliverables', 'Check'],
  qTitre: 'Your project', continuer: 'Continue',
  coherence: 'Consistency checks',
  controles: ['285,000 + 20,000 + 24,000 = €329,000', '329,000 − 45,000 = €284,000', '€284,000 · 25 yrs · 3.5% → €1,422 / month'],
  pdf: '3 PDFs ready to present',
  tampon: ['PEAK PITCH · FILE READY TO PRESENT · ', 'READY'],
  fin: { kicker: 'YOUR APPLICATION IS READY', avant: 'PEAK PITCH means putting', accent: 'every chance', apres: 'on your side.',
    sous: 'Your application, structured and presented the way the bank expects it. No mandate: you stay in control.', bouton: 'Prepare my application', prix: '€99 · VAT not applicable' },
  chiffres: [['Total budget', '€329,000', 'CALCULATED'], ['Contribution', '€45,000', 'DECLARED'], ['Loan requested', '€284,000', 'CALCULATED'], ['Monthly payment · 25 yrs', '€1,422', 'CALCULATED'], ['Estimated capacity', '€350,000', 'SIMULATOR']],
  dossier: 'File PP-2611', page: 'p. 1 / 6', date: '20 November 2026',
  doc: { prepare: 'Based on the client’s declarations · Example', page: (n: number, t: number) => `Page ${n} of ${t}`,
    noteSur: 'SUMMARY NOTE', noteTitre: 'Purchase of a two-bedroom flat to let — Lyon 8th', noteMeta: 'Borrowers: 2 partners, through an SCI to be formed · Term requested: 25 years',
    s1: '1. The project', s2: '2. Key figures', s3: '3. Financing plan', cols: ['Item', 'Amount', 'Source'], emploi: 'Uses', montant: 'Amount',
    capacite: ['Estimated capacity', '€350,000', 'Simulator'], renvoi: 'Estimated fees, rounded amounts. Detailed answers in the appendix, pp. 4–6.',
    piecesSur: 'LIST OF DOCUMENTS TO PROVIDE', piecesTitre: 'Supporting documents per party', piecesMeta: '3 parties · 9 documents · to be sent to the bank by the client',
    piecesCols: ['Document', 'Purpose'], presEntete: 'Bank presentation' },
  note: {
    n: '01 · SUMMARY NOTE', titre: 'Summary note', meta: ['Buy-to-let', 'Lyon 8th', 'SCI to be formed'],
    resume: 'Purchase, through an SCI to be formed, of a two-bedroom flat to let (expected rent: €1,050 a month). The two partners, both permanent employees, request a €284,000 loan over 25 years.',
    chiffres: [['Loan requested', '€284,000', 'CALCULATED'], ['Contribution', '€45,000', 'DECLARED'], ['Monthly payment', '€1,422', 'CALCULATED'], ['Debt ratio', '28.2%', 'CALCULATED']],
    plan: 'Financing plan', emplois: [['Property price', '€285,000'], ['Works', '€20,000'], ['Notary and guarantee fees', '€24,000']], total: ['Total requirement', '€329,000'],
    barre: [['Loan', '86%'], ['Contribution', '14%']],
    capacite: 'Capacity estimated by the simulator', capaciteValeur: '€350,000',
    annexe: 'Appendix: the 64 declared answers',
  },
  pieces: {
    n: '02 · DOCUMENTS PER PARTY', titre: 'Documents to gather', resume: '3 parties · 9 documents',
    intervenants: [
      { sigle: 'B1', nom: 'Borrower 1', role: 'Permanent employee', pieces: [['ID document', 'Identity'], ['Last 3 payslips', 'Income'], ['Last 2 tax notices', 'Income'], ['Bank statements, 3 months', 'Management']] },
      { sigle: 'B2', nom: 'Co-borrower', role: 'Permanent employee', pieces: [['ID document', 'Identity'], ['Employment contract', 'Stability'], ['Proof of savings', 'Contribution']] },
      { sigle: 'SCI', nom: 'SCI to be formed', role: '2 partners', pieces: [['Draft articles', 'Structure'], ['Share capital split', 'Partners']] },
    ] as Intervenant[],
  },
  pres: {
    n: '03 · BANK PRESENTATION', titre: 'Purchase of a flat to let', sous: 'Financing request · €284,000 over 25 years',
    parties: ['The request', 'The borrowers', 'The property', 'Income', 'Financing plan', 'Analysis', 'Summary'],
    anneau: 'Requirement', legende: [['Loan', '€284,000'], ['Contribution', '€45,000']], diapo: '1 / 7',
    bandeau: 'Bank presentation', chips: [['Loan', '€284,000'], ['Term', '25 years'], ['Contribution', '14%']], bien: '2-bed · 68 m² · 2nd floor',
    d2: { n: '05 · FINANCING PLAN', titre: 'Uses and sources', emplois: 'Uses', ressources: 'Sources',
      e: [['Property price', '€285,000'], ['Works', '€20,000'], ['Notary and guarantee fees', '€24,000']],
      r: [['Personal contribution', '€45,000'], ['Mortgage loan', '€284,000']], total: ['Total', '€329,000'] },
    d3: { n: '06 · ANALYSIS', titre: 'Monthly income and charges',
      barres: [['Net income', '€4,300', 85], ['Rent weighted at 70%', '€735', 15], ['Loan payment', '€1,422', 28]] as [string, string, number][],
      jauge: 'Debt ratio', repere: 'HCSF BENCHMARK: 35%', couverture: ['Share of the payment covered by rent', '74%'] },
    pied: 'File PP-2611 · Illustrative example',
  },
  controle: 'Every amount matches a declared or calculated value',
  kicker: 'PEAK PITCH — A PEAK FUNDING SERVICE', promesse: 'Your project, ready to present.', mentions: 'VAT not applicable · One payment',
  decouvrir: 'Discover PEAK PITCH', banques: 'Financing remains subject to approval by the banks.',
  pause: 'Pause the animation', reprendre: 'Resume the animation', rejouer: 'Replay the animation',
  sr: 'Animation: a guided 8-step questionnaire, figures reconciled and labelled as declared, calculated or from the simulator, then three deliverables: summary note, documents to gather per party and a seven-part bank presentation.',
  ambiance: 'Independent broker · Throughout France', exchange: 'Book PEAK EXCHANGE', assurance: 'Borrower insurance',
};
const marque = 'M1 13 7 3l3 5 2-3 5 8';
---

<section class="heros sombre pp" data-pp aria-labelledby="pp-titre">
  <!-- Photographie de montagne du site actuel : le sommet se lève entre le texte et la scène -->
  <div class="pp-photo" aria-hidden="true">
    <picture>
      <source media="(max-width: 1023px)" srcset="/img/hero-mobile-1200.webp" />
      <img src="/img/hero-2400.webp" srcset="/img/hero-1600.webp 1600w, /img/hero-2400.webp 2400w" sizes="200vw" alt="" fetchpriority="high" decoding="async" />
    </picture>
  </div>
  <div class="pp-grille">
    <div class="pp-cabinet">
      <p class="eyebrow text-cuivre-clair">{t.eyebrow}</p>
      <h1 id="pp-titre">{t.h1}</h1>
      <p class="pp-texte">{t.texte}</p>
      <div class="pp-actions">
        <a href="#simulateur" class="btn-fantome">{t.cta1}</a>
        <a href="#expertises" class="btn-fantome gap-2">{t.cta2} <span aria-hidden="true">↓</span></a>
      </div>
    </div>

    <div class="pp-produit">
      <div class="pp-scene" data-pp-scene>
        <p class="sr-only">{t.sr}</p>
        <div class="pp-plateau" aria-hidden="true">
          <div class="pp-reperes"><i></i><i></i><i></i><i></i><span>LYON 8E · 45,73 N · 4,87 E</span></div>
          <div class="pp-entete"><span>{t.scene}</span><span>{t.exemple}</span></div>
          <ol class="pp-phases">{t.phases.map((ph, i) => <li style={`--t:${[0, 6.3, 11.4, 25.8].map(v => +(v * 1.35).toFixed(2))[i]}s`}><span>{`0${i + 1}`}</span>{ph}</li>)}</ol>
          <i class="pp-phases-ligne"><b></b></i>

          <div class="pp-carte pp-q">
            <div class="pp-q-tete"><p class="pp-carte-titre">{t.questionnaire}</p><b class="pp-compteur">{t.etape}&nbsp;</b></div>
            <div class="pp-rail">{Array.from({ length: 8 }, (_, i) => <i style={`--i:${i}`}></i>)}</div>
            <div class="pp-q-corps">
              <ol class="pp-q-etapes">{Array.from({ length: 8 }, (_, i) => <li style={`--i:${i}`}>{`0${i + 1}`}</li>)}</ol>
              <div>
                <p class="pp-q-titre">{t.qTitre}</p>
                <div class="pp-champs">{t.reponses.map(([q, r], i) => <div class="pp-champ" style={`--i:${i}`}><span>{q}</span><b><em>{r}</em></b></div>)}</div>
                <p class="pp-continuer">{t.continuer} →</p>
              </div>
            </div>
          </div>

          <div class="pp-carte pp-c">
            <p class="pp-carte-titre">{t.chiffresTitre}</p>
            <div class="pp-c-corps">
              <div>{t.chiffres.map(([q, r, s], i) => <p class="pp-ligne" style={`--i:${i}`}><span>{q}</span><b>{r}</b><em>{s}</em></p>)}</div>
              <div class="pp-coherence"><p>{t.coherence}</p>{t.controles.map((c, i) => <span style={`--i:${i}`}><svg viewBox="0 0 16 16"><path d="M3 8.5 6.5 12 13 4.5" /></svg>{c}</span>)}</div>
            </div>
          </div>

          <!-- 03 · Présentation bancaire : trois diapositives défilent pendant le plan rapproché -->
          <div class="pp-doc pp-pres">
            <header class="pp-tete-diapo"><span class="pp-logo"><svg viewBox="0 0 18 16"><path d={marque} /></svg>PEAK FUNDING</span><span>{t.doc.presEntete} · {t.dossier}</span></header>
            <div class="pp-diapos">
              <div class="pp-diapo d1">
                <div class="pp-el" style="--k:0">
                  <p class="pp-n">{t.pres.n}</p>
                  <p class="pp-pres-titre">{t.pres.titre}</p>
                  <p class="pp-pres-sous">{t.pres.sous}</p>
                  <p class="pp-chips">{t.pres.chips.map(([l, v]) => <span><small>{l}</small>{v}</span>)}</p>
                  <ol class="pp-sommaire">{t.pres.parties.map((p, i) => <li class={i === 0 ? 'actif' : ''}><span>{String(i + 1).padStart(2, '0')}</span>{p}</li>)}</ol>
                </div>
                <figure class="pp-immeuble pp-el" style="--k:1">
                  <svg viewBox="0 0 120 100">
                    <path pathLength="1" d="M4 94H116" /><path pathLength="1" d="M22 94V22L60 8 98 22V94" /><path pathLength="1" d="M22 22H98M22 40H98M22 56H98M22 72H98" />
                                        <rect pathLength="1" x="22" y="26" width="16" height="10" />
                    <rect pathLength="1" x="44" y="26" width="16" height="10" />
                    <rect pathLength="1" x="66" y="26" width="16" height="10" />
                    <rect pathLength="1" x="22" y="42" width="16" height="10" class="t3" />
                    <rect pathLength="1" x="44" y="42" width="16" height="10" class="t3" />
                    <rect pathLength="1" x="66" y="42" width="16" height="10" class="t3" />
                    <rect pathLength="1" x="22" y="58" width="16" height="10" />
                    <rect pathLength="1" x="44" y="58" width="16" height="10" />
                    <rect pathLength="1" x="66" y="58" width="16" height="10" />
                    <rect pathLength="1" x="52" y="78" width="16" height="16" /><path pathLength="1" d="M108 94V84" /><circle pathLength="1" cx="108" cy="78" r="7" />
                  </svg>
                  <figcaption>{t.pres.bien}</figcaption>
                </figure>
              </div>
              <div class="pp-diapo d2">
                <div>
                  <p class="pp-n">{t.pres.d2.n}</p>
                  <p class="pp-diapo-titre">{t.pres.d2.titre}</p>
                  <div class="pp-er">
                    <div><p class="tete">{t.pres.d2.emplois}</p>{t.pres.d2.e.map(([l, v]) => <p>{l}<b>{v}</b></p>)}<p class="tot">{t.pres.d2.total[0]}<b>{t.pres.d2.total[1]}</b></p></div>
                    <div><p class="tete">{t.pres.d2.ressources}</p>{t.pres.d2.r.map(([l, v]) => <p>{l}<b>{v}</b></p>)}<p class="vide"></p><p class="tot">{t.pres.d2.total[0]}<b>{t.pres.d2.total[1]}</b></p></div>
                  </div>
                </div>
                <div class="pp-anneau">
                  <svg viewBox="0 0 42 42"><circle class="fond" cx="21" cy="21" r="15.915" /><circle class="pret" cx="21" cy="21" r="15.915" pathLength="100" /><circle class="apport" cx="21" cy="21" r="15.915" pathLength="100" /></svg>
                  <p><b>329 k€</b><span>{t.pres.anneau}</span></p>
                  <ul>{t.pres.legende.map(([l, v], i) => <li class={i ? 'apport' : 'pret'}><i></i>{l}<b>{v}</b></li>)}</ul>
                </div>
                <p class="pp-diapo-pied"><span>{t.pres.pied}</span><span>05 / 07</span></p>
              </div>
              <div class="pp-diapo d3">
                <div>
                  <p class="pp-n">{t.pres.d3.n}</p>
                  <p class="pp-diapo-titre">{t.pres.d3.titre}</p>
                  <div class="pp-barres">{t.pres.d3.barres.map(([l, v, w], i) => <p style={`--i:${i}`}><span>{l}</span><i><b style={`width:${w}%`}></b></i><em>{v}</em></p>)}</div>
                  <p class="pp-couverture"><span>{t.pres.d3.couverture[0]}</span><b>{t.pres.d3.couverture[1]}</b></p>
                </div>
                <div class="pp-jauge">
                  <svg viewBox="0 0 60 34"><path class="fond" pathLength="100" d="M5 30A25 25 0 0 1 55 30" /><path class="val" pathLength="100" d="M5 30A25 25 0 0 1 55 30" /><path class="repere" d="M41.76 13.82 47.63 5.73" /></svg>
                  <p><b>{fr ? '28,2 %' : '28.2%'}</b><span>{t.pres.d3.jauge}</span></p>
                  <small>{t.pres.d3.repere}</small>
                </div>
                <p class="pp-diapo-pied"><span>{t.pres.pied}</span><span>06 / 07</span></p>
              </div>
            </div>
            <div class="pp-vignettes pp-el" style="--k:2">{Array.from({ length: 7 }, (_, i) => <i class={i === 0 ? 'actif' : ''}><b></b><b></b></i>)}</div>
          </div>

          <!-- 02 · Pièces à réunir : page A4 -->
          <div class="pp-doc pp-pieces">
            <header class="pp-tete-doc"><span class="pp-logo"><svg viewBox="0 0 18 16"><path d={marque} /></svg>PEAK FUNDING</span><span>{t.dossier}<br />{t.date}</span></header>
            <div class="pp-page">
              <p class="pp-surtitre pp-el" style="--k:0">{t.doc.piecesSur}</p>
              <p class="pp-titre-doc pp-el" style="--k:0">{t.doc.piecesTitre}</p>
              <p class="pp-sous-doc pp-el" style="--k:1">{t.doc.piecesMeta}</p>
              <table class="pp-tableau pp-tableau-pieces pp-el" style="--k:2">
                <thead><tr><th></th><th>{t.doc.piecesCols[0]}</th><th>{t.doc.piecesCols[1]}</th></tr></thead>
