---
import Base from '../../layouts/Base.astro';
---

<Base noindex title="Page not found | PEAK FUNDING" description="This page does not exist or has been moved.">
  <section class="contenu section">
    <p class="eyebrow">Error 404</p>
    <h1 class="display mt-3 max-w-2xl">This page doesn’t exist.</h1>
    <p class="corps mt-5 max-w-lg text-[18px]">It may have been moved. The shortest path to what you’re looking for is probably the home page — or a thirty-minute conversation.</p>
    <div class="mt-8 flex flex-wrap gap-3">
      <a href="/en/" class="btn-cuivre">Back to home</a>
      <a href="/en/#rdv" class="btn-fantome">Book a meeting</a>
    </div>
  </section>
</Base>
