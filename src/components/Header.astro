---
import { langCourante, localiser, urlAutreLangue, t } from '../i18n';
import { services } from '../data/services';
const lang = langCourante(Astro.currentLocale),
  en = lang === 'en',
  tr = t(lang);
const L = (p: string) => localiser(p, lang);
const navigation = [
  ['/#expertises', tr.nav.expertises],
  ['/#methode', tr.nav.methode],
  ['/#equipe', tr.nav.cabinet],
  ['/actualites', tr.nav.analyses],
];
const espaces = [
  ['/espace-client', tr.espaces.client],
  ['/espace-mandataire', tr.espaces.mandataire],
];
const offres = services(lang);
---

<header class="mast" data-entete>
  <div class="mast-inner">
    <a href={L('/')} class="wordmark">
      <img src="/img/logo-peak-funding.svg" alt="PEAK FUNDING" width="176" height="32" />
    </a>
    <nav class="wide-links" aria-label={en ? 'Main navigation' : 'Navigation principale'}>
      {navigation.map(([url, label]) => (
        <a href={L(url)}>{label}</a>
      ))}
    </nav>
    <div class="mast-tools">
      <details data-services class="wide-menu">
        <summary>{en ? 'Services' : 'Services'}</summary>
        <nav>
          {offres.map((s) => (
            <a href={L(s.path)}>{s.name}</a>
          ))}
        </nav>
      </details>
      <details data-espaces class="wide-menu">
        <summary>{tr.espaces.declencheur}</summary>
        <nav>
          {espaces.map(([url, label]) => (
            <a class="espace-lien" href={L(url)} data-astro-reload>
              {label}
            </a>
          ))}
        </nav>
      </details>
      <a
        class="language"
        hreflang={en ? 'fr' : 'en'}
        href={urlAutreLangue(Astro.url.pathname, lang)}
        data-astro-reload
        aria-label={en ? 'FR — Français' : 'EN — English'}
      >
        {en ? 'FR' : 'EN'}
      </a>
      <a href={L('/#simulateur')} class="nav-action">
        {tr.nav.simulateur} <span aria-hidden="true">↗</span>
      </a>
      <details data-menu class="compact-menu">
        <summary aria-label={tr.menu}>
          <svg width="21" height="20" viewBox="0 0 21 20" stroke="currentColor" aria-hidden="true">
            <path d="M1 7h19M1 13h19" />
          </svg>
        </summary>
        <nav>
          {navigation.map(([url, label]) => (
            <a href={L(url)}>{label}</a>
          ))}
          <a href={L('/#simulateur')}>{tr.nav.simulateur}</a>
          <div data-services-mobile>
            {offres.map((s) => (
              <a href={L(s.path)}>{s.name}</a>
            ))}
          </div>
          {espaces.map(([url, label]) => (
            <a data-astro-reload href={L(url)}>
              {label}
            </a>
          ))}
        </nav>
      </details>
    </div>
  </div>
</header>
