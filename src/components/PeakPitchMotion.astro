    intervenants: [
      { sigle: 'E1', nom: 'Emprunteur 1', role: 'Salarié en CDI', pieces: [['Pièce d’identité', 'Identité'], ['3 derniers bulletins de salaire', 'Revenus'], ['2 derniers avis d’imposition', 'Revenus'], ['Relevés de comptes, 3 mois', 'Gestion']] },
      { sigle: 'E2', nom: 'Co-emprunteur', role: 'Salariée en CDI', pieces: [['Pièce d’identité', 'Identité'], ['Contrat de travail', 'Stabilité'], ['Justificatif d’épargne', 'Apport']] },
      { sigle: 'SCI', nom: 'SCI à créer', role: '2 associés', pieces: [['Projet de statuts', 'Structure'], ['Répartition du capital', 'Associés']] },
    ] as Intervenant[],
  },
