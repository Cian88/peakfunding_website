---
import Base from '../../../components/Feuillet.astro';
import VisuelArticle from '../../../components/VisuelArticle.astro';
import articles from '../../../data/en/articles.json';
import { cleTheme, dateArticle, dateISO, trierArticles } from '../../../lib/editorial.mjs';
import { listeArticles, filAriane, SITE } from '../../../lib/seo';

const liste = trierArticles(articles).map(a => ({
  slug: a.slug, titre: a.title, categorie: a.avant[1], lecture: a.avant[2],
  auteur: a.apres[0], date: dateArticle(a), iso: dateISO(dateArticle(a)),
  extrait: a.apres[2] || a.description,
}));
const categories = [...new Set(liste.map(a => a.categorie))];
const libelle = (c: string) => c.charAt(0) + c.slice(1).toLowerCase();
---

<Base title="Insights on mortgages, taxation & borrower insurance | PEAK FUNDING" description="Rates, structures, taxation, borrower insurance, banking news: PEAK FUNDING’s analysis to see clearly, without needless jargon." typePage="CollectionPage" schema={[
  listeArticles({ url: `${SITE}/en/actualites/`, nom: 'PEAK FUNDING insights & advice', articles: liste.map(a => ({ url: `${SITE}/en/actualites/${a.slug}/`, titre: a.titre })) }),
  filAriane([{ nom: 'Home', url: `${SITE}/en/` }, { nom: 'Insights', url: `${SITE}/en/actualites/` }]),
]}>
  <section class="cadre-page respiration filtres">
    <div class="grid items-end gap-8 border-b filet pb-10 lg:grid-cols-[1.4fr_1fr] lg:gap-20">
      <div><p class="legende">The firm’s view</p><h1 class="grand-titre mt-5 max-w-3xl lg:text-[56px]">Understand credit,<br />before you sign.</h1></div>
      <p class="paragraphe max-w-md text-[18px]">Rates, structures, taxation, banking news: our analysis to see clearly, without needless jargon.</p>
    </div>
    <fieldset class="mt-8 flex flex-wrap gap-2">
      <legend class="sr-only">Filter articles by theme</legend>
      <label class="pastille"><input type="radio" name="theme" value="tout" checked class="sr-only" /><span>All insights <small>{liste.length}</small></span></label>
      {categories.map(c => <label class="pastille"><input type="radio" name="theme" value={cleTheme(c)} class="sr-only" /><span>{libelle(c)}</span></label>)}
    </fieldset>
    <ul class="sommaire-analyses">
      {liste.map((a, index) => <li class="entree-analyse" data-theme={cleTheme(a.categorie)}>
        <a href={`/en/actualites/${a.slug}`} class="group lien-analyse">
          <div class="vignette-analyse">
            <VisuelArticle slug={a.slug} prioritaire={index < 3} carte />
          </div>
          <div class="resume-analyse">
            <p class="legende leading-relaxed">{a.categorie} <span class="teinte-secondaire">· {a.lecture}</span></p>
            <h2 class="titre-entree mt-3 group-hover:underline underline-offset-4">{a.titre}</h2>
            <p class="paragraphe mt-4 text-[15px]">{a.extrait}</p>
            <div class="mt-auto flex items-end justify-between gap-4 pt-7"><p class="text-[12px] leading-relaxed teinte-secondaire"><span class="whitespace-nowrap">{a.auteur}</span><br /><time datetime={a.iso} class="font-mono">{a.date}</time></p><span class="flex h-10 w-10 shrink-0 items-center justify-center border filet text-encre transition-colors group-hover:border-cuivre-profond group-hover:bg-cuivre-profond group-hover:text-white" aria-hidden="true">↗</span></div>
          </div>
        </a>
      </li>)}
    </ul>
  </section>
  <section class="fond-quadrille border-b filet py-14"><div class="cadre-page flex flex-wrap items-center justify-between gap-7"><div><p class="legende">From reading to your project</p><h2 class="titre-rubrique mt-4">And for your financing?</h2></div><a href="/en/peak-exchange/" class="action-pleine">Book PEAK EXCHANGE · €299 incl. VAT ↗</a></div></section>
</Base>

<style>
  .filtres:has(input[value="buy-to-let"]:checked) li:not([data-theme="buy-to-let"]),
  .filtres:has(input[value="primary-residence"]:checked) li:not([data-theme="primary-residence"]),
  .filtres:has(input[value="rates-market"]:checked) li:not([data-theme="rates-market"]),
  .filtres:has(input[value="borrower-insurance"]:checked) li:not([data-theme="borrower-insurance"]) { display: none; }
</style>
