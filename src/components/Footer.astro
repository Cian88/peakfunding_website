---
/* Pied de page sur chaque page : liens légaux, ORIAS/ACPR et mention obligatoire. */
import { langCourante, localiser, t } from '../i18n';
const lang = langCourante(Astro.currentLocale);
const tr = t(lang);
const L = (p: string) => localiser(p, lang);
const colonnes = [
  {
    titre: tr.footer.col_expertises,
    liens: [
      [L('/expertises/estate'), 'PEAK ESTATE'],
      [L('/expertises/pro'), 'PEAK PRO'],
      [L('/expertises/pim'), 'PEAK PIM'],
      [L('/expertises/insure'), 'PEAK INSURE'],
    ],
  },
  {
    titre: tr.footer.col_cabinet,
    liens: [
      [L('/#methode'), tr.footer.methode],
      [L('/#equipe'), tr.footer.equipe],
      [L('/#partenaires'), tr.footer.partenaires],
      [L('/actualites'), tr.footer.actualites],
      [L('/livre/'), lang === 'fr' ? 'Le livre' : 'The book'],
    ],
  },
  {
    titre: tr.footer.col_espaces,
    liens: [
      [L('/espace-client'), tr.footer.client],
      [L('/espace-mandataire'), tr.footer.mandataire],
      [L('/peak-exchange/'), lang === 'fr' ? 'RDV PEAK EXCHANGE' : 'Book PEAK EXCHANGE'],
    ],
  },
  {
    titre: tr.footer.col_reglementaire,
    liens: [
      [L('/mentions-legales'), tr.footer.mentions],
      [L('/politique-de-confidentialite'), tr.footer.confidentialite],
      [L('/cgu'), tr.footer.cgu],
    ],
  },
];
const annee = new Date().getFullYear();
---

<footer class="colophon">
  <div class="frame">
    <a class="footer-mark" href={L('/')}>
      <img src="/img/logo-peak-funding.svg" width="258" height="46" alt="PEAK FUNDING" />
    </a>
    <div class="footer-index">
      {colonnes.map((col) => (
        <div>
          <h2>{col.titre}</h2>
          <ul>
            {col.liens.map(([href, label]) => (
              <li>
                <a {href} data-astro-reload={href === L('/espace-client') || undefined}>
                  {label}
                </a>
              </li>
            ))}
          </ul>
        </div>
      ))}
    </div>
    <div class="footer-legal">
      <p>
        © {annee} · {tr.footer.orias}
      </p>
      <a href={L('/contact/')}>{lang === 'fr' ? 'Contact administratif' : 'Administrative contact'}</a>
    </div>
    <p class="credit-warning">{tr.footer.credit}</p>
  </div>
</footer>
