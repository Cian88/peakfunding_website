---
import {langCourante, localiser} from '../i18n';
import {ebook, ebookPrice} from '../data/ebook';
const lang=langCourante(Astro.currentLocale),en=lang==='en',book=ebook(lang);
---
<section class="clair ebook-teaser" id="livre" aria-labelledby="livre-titre">
 <div class="contenu teaser-grid">
  <a href={localiser('/livre/',lang)} class="teaser-cover" aria-label={book.title}><img src={`/img/ebook/couverture-${lang}.webp`} alt={en ? `Cover of ${book.title}` : `Couverture du livre ${book.title}`} width="756" height="1071" loading="lazy" /></a>
  <div class="teaser-copy"><p class="eyebrow">{en ? 'The practical guide · 2026 edition' : 'Le guide pratique · édition 2026'}</p><h2 id="livre-titre">{book.title}</h2><p class="teaser-subtitle">{book.subtitle}</p><p>{en ? 'Home purchase, rental investment, SCI, holding companies, Lombard loans and buyouts: understand the lender’s perspective before preparing your application.' : 'Résidence principale, investissement locatif, SCI, holding, crédit lombard, LBO : comprenez la lecture d’une banque avant de préparer votre dossier.'}</p><p class="teaser-meta">26 {en ? 'chapters' : 'chapitres'} · {book.pages} pages · PDF</p><div class="teaser-bottom"><strong>{ebookPrice(lang)}</strong><a href={localiser('/livre/',lang)} class="btn-cuivre">{en ? 'Discover the book' : 'Découvrir le livre'} <span aria-hidden="true">↗</span></a></div><small>{en ? 'Available in French and English. Full ebook after purchase; free extract before you decide.' : 'Disponible en français et en anglais. Livre complet après achat ; extrait gratuit pour découvrir le contenu.'}</small></div>
 </div>
</section>
<style>
 .ebook-teaser{background:#e9e5dd;padding:clamp(52px,6vw,88px) 0;color:#0b0d12}.teaser-grid{display:grid;grid-template-columns:.8fr 1.2fr;align-items:center;gap:clamp(32px,7vw,110px)}.teaser-cover{display:block;max-width:290px;justify-self:center}.teaser-cover img{width:100%;height:auto;box-shadow:16px 24px 36px #0b0d1226}.teaser-copy h2{font-size:clamp(30px,3.3vw,46px);line-height:1.12;font-weight:400;letter-spacing:-.04em;margin:24px 0 16px;max-width:590px}.teaser-copy p:not(.eyebrow){font-size:16px;line-height:1.7;color:#555963;max-width:600px}.teaser-copy .teaser-subtitle{font-size:20px!important;color:#0b0d12!important;margin-bottom:20px}.teaser-copy .teaser-meta{font:12px var(--font-mono)!important;margin-top:22px;color:#745239!important}.teaser-bottom{display:flex;gap:30px;align-items:center;margin:28px 0 18px}.teaser-bottom strong{font-size:34px;font-weight:400;letter-spacing:-.04em}.teaser-bottom a{gap:20px;font-size:14px}.teaser-copy small{display:block;font-size:12px;line-height:1.65;max-width:570px;color:#555963}@media(max-width:640px){.teaser-grid{grid-template-columns:1fr;gap:36px}.teaser-cover{max-width:190px}.teaser-copy h2{font-size:34px}.teaser-bottom{gap:18px;flex-wrap:wrap}.teaser-bottom strong{font-size:30px}}
</style>
